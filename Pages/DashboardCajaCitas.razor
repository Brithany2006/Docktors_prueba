@page "/dashboard-caja-citas"
@attribute [Authorize(Roles = "CajaCitas")]
@using LaboratorioFront.Services
@inject DerivacionesService DerivService
@inject IJSRuntime JS

<div class="min-h-screen bg-gray-50 flex flex-col font-sans">
    <header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-turquesa-600 rounded-lg flex items-center justify-center shadow-lg shadow-turquesa-200">
                    <i class="fa-solid fa-calendar-check text-white text-xl"></i>
                </div>
                <h1 class="text-xl font-bold text-gray-800">Visualizacion de Citas</h1>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm font-medium text-gray-600">
                    <i class="fa-regular fa-calendar text-turquesa-500 mr-2"></i> @DateTime.Now.ToString("dd MMMM yyyy")
                </span>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="relative flex-1">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-search text-gray-400"></i>
                    </div>
                    <input type="text" @bind="searchQuery" @onkeyup="BuscarEnter" placeholder="Buscar por paciente, doctor, cedula... (Presiona Enter)" class="block w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 sm:text-sm transition-colors shadow-sm">
                    <div class="absolute inset-y-0 right-0 pr-2 flex items-center">
                        <button @onclick="EjecutarBusqueda" class="p-2 text-turquesa-600 hover:text-turquesa-800 transition-colors bg-turquesa-50 rounded-md">
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
                
            </div>
        </div>

        @if (citasLoading)
        {
            <div class="flex justify-center items-center py-12">
                <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-turquesa-600"></div>
                <span class="ml-4 text-turquesa-600 font-semibold text-lg">Cargando citas...</span>
            </div>
        }
        else if (busquedaRealizada && !citas.Any())
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center text-gray-500">
                <i class="fa-regular fa-calendar-xmark text-5xl mb-4 text-gray-300"></i>
                <p class="text-lg">No se encontraron citas para los criterios de busqueda.</p>
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Fecha / Hora</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Paciente</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Doctor</th>
                                @if (currentSucursal == "Milan")
                                {
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Sucursal</th>
                                }
                                else
                                {
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Consultorio / Sucursal</th>
                                }
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Estado</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var cita in citas)
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-semibold text-gray-900">@cita.FechaHora.ToString("dd/MM/yyyy")</div>
                                        <div class="text-sm text-turquesa-600 font-bold">@cita.FechaHora.ToString("HH:mm")</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-bold text-gray-900">@(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")</div>
                                        <div class="text-xs text-gray-500">C.I: @(cita.Derivacion?.Paciente?.Cedula ?? "N/A")</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-semibold text-gray-800">@(cita.Doctor?.Nombre ?? "N/A")</div>
                                        <div class="text-xs text-gray-500">@(cita.Derivacion?.EspecialidadRequerida ?? cita.Doctor?.Especialidad ?? "N/A")</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (currentSucursal != "Milan")
                                        {
                                            <div class="text-sm font-semibold text-gray-800">@(cita.Doctor?.Consultorio ?? "N/A")</div>
                                        }
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                            @(cita.Doctor?.Sucursal ?? "Centro")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (cita.Estado == "Pendiente")
                                        {
                                            <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-xs font-bold border border-yellow-200">Pendiente</span>
                                        }
                                        else if (cita.Estado == "Atendido")
                                        {
                                            <span class="px-3 py-1 rounded-full bg-green-100 text-green-800 text-xs font-bold border border-green-200">Atendido</span>
                                        }
                                        else
                                        {
                                            <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-xs font-bold border border-gray-200">@cita.Estado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>
</div>

@code {
    private List<LaboratorioFront.Services.DerivacionesService.CitaDerivacionResponse> citas = new();
    private bool citasLoading = false;
    private string searchQuery = string.Empty;
    private bool busquedaRealizada = false;

    private string currentSucursal = "Centro";

    protected override async Task OnInitializedAsync()
    {
        try {
            var token = await JS.InvokeAsync<string>("laboratorio.getToken");
            if (!string.IsNullOrEmpty(token))
            {
                var payload = token.Split('.')[1];
                var jsonBytes = ParseBase64WithoutPadding(payload);
                var keyValuePairs = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                if (keyValuePairs != null && keyValuePairs.TryGetValue("RUC", out var rucObj))
                {
                    string ruc = rucObj.ToString()?.ToLower() ?? "";
                    if (ruc == "milan" || ruc == "adminmilan" || ruc == "cajamilan")
                    {
                        currentSucursal = "Milan";
                    }
                }
            }
        } catch { }
    }

    private byte[] ParseBase64WithoutPadding(string base64)
    {
        switch (base64.Length % 4)
        {
            case 2: base64 += "=="; break;
            case 3: base64 += "="; break;
        }
        return Convert.FromBase64String(base64);
    }

    private async Task BuscarEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EjecutarBusqueda();
        }
    }

    private async Task EjecutarBusqueda()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        
        citasLoading = true;
        busquedaRealizada = true;
        try
        {
            citas = await DerivService.BuscarCitasAsync(searchQuery);
        }
        catch { }
        finally
        {
            citasLoading = false;
        }
    }
}