@page "/login-paciente"
@inject LaboratorioFront.Services.ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="login-page">
    <div class="login-card">
        <h3>Portal de Pacientes</h3>

        <EditForm Model="@model" OnValidSubmit="OnSubmit">
            <div class="form-group">
                <label>Cedula</label>
                <InputText @bind-Value="model.cedula"
                           placeholder="Ingrese su cedula" />
            </div>

            <div class="form-group">
                <label>Contrasena</label>
                <InputText @bind-Value="model.password"
                           type="password"
                           placeholder="Ingrese su contrasena" />
            </div>

            <button type="submit" class="btn-login" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span> Ingresando...</span>
                }
                else
                {
                    <span>Ingresar</span>
                }
            </button>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="error">@error</p>
            }
        </EditForm>
    </div>
</div>

@code {

    private LoginPacienteModel model = new();
    private string? error;
    private bool isSubmitting = false;

    private async Task OnSubmit()
    {
        error = null;
        isSubmitting = true;

        try
        {
            var token = await Api.LoginPacienteAsync(model.cedula, model.password);


            if (string.IsNullOrEmpty(token))
            {
                error = "Cedula o contrasena incorrecta";
                return;
            }

            await JS.InvokeVoidAsync("laboratorio.setToken", token);

            var payload = ParseJwt(token);
            var rol = payload.FirstOrDefault(x =>
                x.Key.Equals("role", StringComparison.OrdinalIgnoreCase))
                .Value?.ToString() ?? "Paciente";

            await JS.InvokeVoidAsync("laboratorio.setRol", rol);

            // 👇 Redirigir a vista exclusiva paciente
            Nav.NavigateTo("/mis-resultados", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = $"Error al iniciar sesion: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Dictionary<string, object> ParseJwt(string token)
    {
        var parts = token.Split('.');
        if (parts.Length != 3) return new();

        var payload = parts[1];
        payload = payload.PadRight(payload.Length +
            (4 - payload.Length % 4) % 4, '=');

        var jsonBytes = Convert.FromBase64String(
            payload.Replace('-', '+').Replace('_', '/'));

        var json = System.Text.Encoding.UTF8.GetString(jsonBytes);

        return System.Text.Json.JsonSerializer
            .Deserialize<Dictionary<string, object>>(json) ?? new();
    }

    private class LoginPacienteModel
    {
        public string cedula { get; set; } = string.Empty;
        public string password { get; set; } = string.Empty;
    }
}

