@page "/pacientes"
@using LaboratorioFront.Services
@using static LaboratorioFront.Services.ApiService

@inject ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="min-h-screen bg-gray-50 p-4 sm:p-6 lg:p-8">
    
    <!-- Pro Dashboard Header -->
    <div class="bg-gradient-to-r from-turquesa-900 to-turquesa-500 rounded-2xl shadow-xl p-6 sm:p-10 mb-8 flex flex-col sm:flex-row justify-between items-center sm:items-start gap-6 text-white relative overflow-hidden">
        
        @if (!string.IsNullOrEmpty(rucEmpresa))
        {
            <img src="@(Api.Http.BaseAddress?.ToString().TrimEnd('/') + "/img_empresas_banner/" + rucEmpresa + ".jpg")" 
                 alt="Banner Empresa" 
                 class="absolute inset-0 w-full h-full object-cover z-0 opacity-80" 
                 onerror="this.style.display='none';" />
            <div class="absolute inset-0 bg-black/40 z-0"></div>
        }
        
        <!-- Decoration element -->
        <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-white opacity-10 blur-3xl z-0 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-64 h-64 rounded-full bg-turquesa-300 opacity-20 blur-3xl z-0 pointer-events-none"></div>
        
        <div class="relative z-10 text-center sm:text-left flex flex-col sm:flex-row items-center gap-6">
            @if (!string.IsNullOrEmpty(rucEmpresa))
            {
                <div class="h-20 w-20 bg-white rounded-full flex-shrink-0 flex items-center justify-center overflow-hidden shadow-lg border-4 border-turquesa-100 relative">
                    <img src="@(Api.Http.BaseAddress?.ToString().TrimEnd('/') + "/img_empresas/" + rucEmpresa + ".png")" 
                         alt="Logo Empresa" class="w-full h-full object-contain p-1" 
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="h-full w-full bg-turquesa-100 items-center justify-center hidden" style="display: none;">
                        <i class="fa-solid fa-user-tie text-3xl text-turquesa-500"></i>
                    </div>
                </div>
            }
            <div>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight flex items-center justify-center sm:justify-start">
                    @nombreEmpresa
                </h2>
                <div class="mt-4 flex flex-wrap gap-4 justify-center sm:justify-start">
                    <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2 font-medium flex items-center">
                        <i class="fa-solid fa-users mr-2"></i> @TotalPacientes Pacientes Evaluados
                    </div>
                </div>
            </div>
        </div>
        
        <div class="relative z-10 w-full sm:w-auto">
            <!-- Global ZIP removed -->
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row gap-4 mb-8">
        <!-- Search Bar -->
        <div class="flex-grow bg-white rounded-xl shadow-md p-2 border border-gray-100 flex items-center focus-within:ring-2 focus-within:ring-turquesa-500 focus-within:border-turquesa-500 transition-shadow">
            <div class="pl-4 pr-2 text-gray-400">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <input placeholder="Buscar por paciente, cedula o cita..."
                   @bind="searchTerm"
                   @bind:event="oninput" 
                   class="w-full py-3 px-2 border-0 focus:ring-0 text-gray-700 outline-none rounded-r-xl" />
        </div>
        
        <!-- Filter Status -->
        <div class="bg-white rounded-xl shadow-md border border-gray-100 flex items-center">
            <div class="pl-4 pr-2 text-gray-400">
                <i class="fa-solid fa-filter"></i>
            </div>
            <select @bind="estadoFiltro" class="py-3 px-4 w-full md:w-auto border-0 focus:ring-0 text-gray-700 outline-none rounded-r-xl appearance-none bg-transparent cursor-pointer">
                <option value="Todos">Todos los pacientes</option>
                <option value="Listos">Pacientes listos</option>
                <option value="Pendientes">Pacientes pendientes</option>
            </select>
        </div>
    </div>

    @if (citas is null && pacientesAntiguos is null)
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white rounded-2xl shadow-sm border border-gray-100">
            <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-turquesa-500"></div>
            <h5 class="mt-6 text-gray-500 font-medium text-lg">Cargando resultados...</h5>
        </div>
    }
    else if ((citasPaginadas == null || !citasPaginadas.Any()) && (pacientesAntiguosFiltrados == null || !pacientesAntiguosFiltrados.Any()))
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white rounded-2xl shadow-sm border border-gray-100">
            <div class="h-24 w-24 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                <i class="fa-solid fa-inbox text-4xl text-gray-400"></i>
            </div>
            <h5 class="text-gray-500 font-medium text-lg text-center px-4">No hay citas medicas o resultados para mostrar.</h5>
        </div>
    }
    else
    {
        <!-- Grid de Cards de Pacientes (Odoo) -->
        @if (citasPaginadas != null && citasPaginadas.Any())
        {
            <h4 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                <i class="fa-solid fa-laptop-medical text-turquesa-500 mr-2"></i> Resultados Recientes
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
                @foreach (var cita in citasPaginadas)
                {
                    <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 transition-all duration-300 transform hover:-translate-y-1 flex flex-col h-full overflow-hidden group">
                        <div class="p-6 flex-grow">
                            <div class="flex justify-between items-start mb-4">
                                <div class="h-12 w-12 rounded-full bg-turquesa-100 flex items-center justify-center text-turquesa-700 font-bold text-xl group-hover:bg-turquesa-500 group-hover:text-white transition-colors">
                                    @(string.IsNullOrWhiteSpace(cita.Paciente) ? "?" : cita.Paciente.Substring(0, 1).ToUpper())
                                </div>
                                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800 border border-gray-200">
                                    <i class="fa-regular fa-calendar-check mr-1"></i> @(cita.FechaAtencion?.ToString("dd/MM/yyyy") ?? "-")
                                </span>
                            </div>
                            
                            <h3 class="text-lg font-bold text-gray-900 mb-1 line-clamp-2 leading-tight">@cita.Paciente</h3>
                            
                            <div class="mt-4 space-y-2 text-sm text-gray-600">
                                <div class="flex items-center">
                                    <i class="fa-solid fa-id-card w-5 text-turquesa-500"></i>
                                    <span>@cita.Cedula</span>
                                </div>
                                <div class="flex items-center">
                                    <i class="fa-solid fa-hashtag w-5 text-turquesa-500"></i>
                                    <span class="truncate">@cita.NumeroCita</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 group-hover:bg-turquesa-50 transition-colors flex flex-col sm:flex-row gap-2">
                            <a class="flex-1 flex justify-center items-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-turquesa-500 hover:bg-turquesa-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-turquesa-500 transition-colors" 
                               href="/paciente-detalle/@cita.Id">
                                Ver Detalles <i class="fa-solid fa-arrow-right ml-2"></i>
                            </a>
                            <a class="flex justify-center items-center py-2.5 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-turquesa-500 transition-colors" 
                               href="@Api.BuildOdooPacienteZipUrl(cita.Cedula)" target="_blank" title="Descargar resultados de este paciente en ZIP">
                                <i class="fa-solid fa-file-zipper text-rojo-500"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Pacientes Antiguos (Historico) -->
        @if (pacientesAntiguosFiltrados != null && pacientesAntiguosFiltrados.Any())
        {
            <div class="mt-12">
                <h4 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                    <i class="fa-solid fa-box-archive text-gray-500 mr-2"></i> Resultados Historicos
                </h4>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Paciente</th>
                                    <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                @foreach (var paciente in pacientesAntiguosFiltrados)
                                {
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <div class="flex-shrink-0 h-10 w-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 font-bold">
                                                    @(string.IsNullOrWhiteSpace(paciente.NombreCompleto) ? "?" : paciente.NombreCompleto.Substring(0, 1).ToUpper())
                                                </div>
                                                <div class="ml-4">
                                                    <div class="text-sm font-bold text-gray-900">@paciente.NombreCompleto</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            <div class="flex items-center justify-end gap-2">
                                                <button @onclick="() => VerPdfAntiguo(paciente.NombreArchivo)" class="inline-flex items-center px-3 py-2 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-turquesa-600 hover:bg-turquesa-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-turquesa-500 transition-colors" title="Ver Laboratorio">
                                                    <i class="fa-solid fa-flask mr-2 text-white"></i> Lab
                                                </button>
                                                <button @onclick="() => AbrirModalLegacy(paciente.NombreCompleto)" class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-turquesa-500 transition-colors" title="Ver Radiografias y Ecografias">
                                                    <i class="fa-solid fa-x-ray mr-2 text-turquesa-600"></i> RX / Eco
                                                </button>
                                                <a class="flex justify-center items-center py-2 px-3 border border-gray-300 rounded-lg shadow-sm text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-turquesa-500 transition-colors" 
                                                   href="@Api.BuildLegacyZipUrl(paciente.NombreCompleto, paciente.NombreArchivo)" target="_blank" title="Descargar todos los resultados en ZIP">
                                                    <i class="fa-solid fa-file-zipper text-rojo-500"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Pagination (Solo aplica para Odoo, podrias unificarlo si quisieras) -->
        @if (TotalPages > 1)
        {
            <div class="flex items-center justify-center mt-8">
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm bg-white" aria-label="Pagination">
                    <button @onclick="() => CambiarPagina(CurrentPage - 1)" disabled="@(CurrentPage == 1)" class="relative inline-flex items-center rounded-l-md px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-50 focus:z-20 disabled:opacity-50 disabled:cursor-not-allowed border border-gray-300">
                        <span class="sr-only">Anterior</span>
                        <i class="fa-solid fa-chevron-left w-5 h-5 flex items-center justify-center"></i>
                    </button>
                    
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        int pageNum = i;
                        if (pageNum == CurrentPage)
                        {
                            <button aria-current="page" class="relative z-10 inline-flex items-center bg-turquesa-500 px-4 py-2 text-sm font-semibold text-white focus:z-20 border border-turquesa-500">
                                @pageNum
                            </button>
                        }
                        else
                        {
                            <button @onclick="() => CambiarPagina(pageNum)" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20">
                                @pageNum
                            </button>
                        }
                    }

                    <button @onclick="() => CambiarPagina(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)" class="relative inline-flex items-center rounded-r-md px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-50 focus:z-20 disabled:opacity-50 disabled:cursor-not-allowed border border-gray-300">
                        <span class="sr-only">Siguiente</span>
                        <i class="fa-solid fa-chevron-right w-5 h-5 flex items-center justify-center"></i>
                    </button>
                </nav>
            </div>
        }
    }

    <!-- Modal for Legacy RX and ECO -->
    @if (mostrarModalLegacy)
    {
        <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
            <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <!-- Background overlay -->
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" @onclick="CerrarModalLegacy"></div>

                <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

                <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full">
                    <div class="bg-gradient-to-r from-turquesa-700 to-turquesa-500 px-6 py-4 flex justify-between items-center">
                        <h3 class="text-xl leading-6 font-bold text-white flex items-center" id="modal-title">
                            <i class="fa-solid fa-folder-open mr-3"></i> Otros Estudios: @pacienteSeleccionado
                        </h3>
                        <button @onclick="CerrarModalLegacy" class="text-white hover:text-gray-200 focus:outline-none">
                            <i class="fa-solid fa-xmark text-2xl"></i>
                        </button>
                    </div>
                    
                    <div class="bg-gray-50 px-6 py-6">
                        @if (isLoadingLegacyDetails)
                        {
                            <div class="flex flex-col items-center justify-center py-10">
                                <div class="animate-spin rounded-full h-12 w-12 border-t-4 border-b-4 border-turquesa-500 mb-4"></div>
                                <p class="text-gray-500">Cargando estudios...</p>
                            </div>
                        }
                        else
                        {
                            bool hasAnyStudy = legacyRxInformes.Any() || legacyRxImagenes.Any() || legacyEcoInformes.Any() || legacyEcoImagenes.Any();
                            
                            if (!hasAnyStudy)
                            {
                                <div class="text-center py-8">
                                    <i class="fa-solid fa-folder-open text-gray-300 text-5xl mb-4"></i>
                                    <p class="text-gray-500 text-lg">No se encontraron Radiografias ni Ecografias para este paciente.</p>
                                </div>
                            }
                            else
                            {
                                <div class="space-y-6">
                                    <!-- RX -->
                                    @if (legacyRxInformes.Any() || legacyRxImagenes.Any())
                                    {
                                        <div>
                                            <h4 class="text-lg font-bold text-gray-800 border-b border-gray-200 pb-2 mb-4 flex items-center">
                                                <i class="fa-solid fa-x-ray text-turquesa-600 mr-2"></i> Radiografias (RX)
                                            </h4>
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                @foreach (var informe in legacyRxInformes)
                                                {
                                                    <a href="@Api.BuildPacienteEstudioFileUrl(informe.Id)" target="_blank" class="flex items-center p-3 bg-white border border-gray-200 rounded-lg hover:shadow-md transition-shadow">
                                                        <div class="flex-shrink-0 h-10 w-10 rounded-full bg-red-100 flex items-center justify-center text-red-500 mr-3">
                                                            <i class="fa-solid fa-file-pdf"></i>
                                                        </div>
                                                        <div class="overflow-hidden">
                                                            <p class="text-sm font-medium text-gray-900 truncate">Informe RX</p>
                                                            <p class="text-xs text-gray-500">@(informe.FechaDocumento?.ToString("dd/MM/yyyy") ?? "-")</p>
                                                        </div>
                                                    </a>
                                                }
                                                @foreach (var img in legacyRxImagenes)
                                                {
                                                    <a href="@Api.BuildPacienteEstudioFileUrl(img.Id)" target="_blank" class="flex items-center p-3 bg-white border border-gray-200 rounded-lg hover:shadow-md transition-shadow">
                                                        <div class="flex-shrink-0 h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-500 mr-3">
                                                            <i class="fa-solid fa-image"></i>
                                                        </div>
                                                        <div class="overflow-hidden">
                                                            <p class="text-sm font-medium text-gray-900 truncate">Imagen RX</p>
                                                            <p class="text-xs text-gray-500">@(img.FechaDocumento?.ToString("dd/MM/yyyy") ?? "-")</p>
                                                        </div>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- ECO -->
                                    @if (legacyEcoInformes.Any() || legacyEcoImagenes.Any())
                                    {
                                        <div>
                                            <h4 class="text-lg font-bold text-gray-800 border-b border-gray-200 pb-2 mb-4 flex items-center">
                                                <i class="fa-solid fa-wave-square text-turquesa-600 mr-2"></i> Ecografias
                                            </h4>
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                @foreach (var informe in legacyEcoInformes)
                                                {
                                                    <a href="@Api.BuildPacienteEstudioFileUrl(informe.Id)" target="_blank" class="flex items-center p-3 bg-white border border-gray-200 rounded-lg hover:shadow-md transition-shadow">
                                                        <div class="flex-shrink-0 h-10 w-10 rounded-full bg-red-100 flex items-center justify-center text-red-500 mr-3">
                                                            <i class="fa-solid fa-file-pdf"></i>
                                                        </div>
                                                        <div class="overflow-hidden">
                                                            <p class="text-sm font-medium text-gray-900 truncate">Informe ECO</p>
                                                            <p class="text-xs text-gray-500">@(informe.FechaDocumento?.ToString("dd/MM/yyyy") ?? "-")</p>
                                                        </div>
                                                    </a>
                                                }
                                                @foreach (var img in legacyEcoImagenes)
                                                {
                                                    <a href="@Api.BuildPacienteEstudioFileUrl(img.Id)" target="_blank" class="flex items-center p-3 bg-white border border-gray-200 rounded-lg hover:shadow-md transition-shadow">
                                                        <div class="flex-shrink-0 h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-500 mr-3">
                                                            <i class="fa-solid fa-image"></i>
                                                        </div>
                                                        <div class="overflow-hidden">
                                                            <p class="text-sm font-medium text-gray-900 truncate">Imagen ECO</p>
                                                            <p class="text-xs text-gray-500">@(img.FechaDocumento?.ToString("dd/MM/yyyy") ?? "-")</p>
                                                        </div>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                    <div class="bg-white px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse border-t border-gray-200">
                        <button type="button" class="w-full inline-flex justify-center rounded-lg border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-turquesa-500 sm:ml-3 sm:w-auto sm:text-sm" @onclick="CerrarModalLegacy">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<OdooCitaDto>? citas;
    private List<PacientePdf>? pacientesAntiguos;
    
    // Legacy Modal variables
    private bool mostrarModalLegacy = false;
    private string pacienteSeleccionado = string.Empty;
    private bool isLoadingLegacyDetails = false;
    private List<PacienteEstudio> legacyRxInformes = new();
    private List<PacienteEstudio> legacyRxImagenes = new();
    private List<PacienteEstudio> legacyEcoInformes = new();
    private List<PacienteEstudio> legacyEcoImagenes = new();
    
    private string nombreEmpresa = "Empresa Cliente";
    
    private string _search = "";
    private string rucEmpresa = string.Empty;

    private string _estadoFiltro = "Todos";
    private string estadoFiltro
    {
        get => _estadoFiltro;
        set
        {
            _estadoFiltro = value;
            CurrentPage = 1;
        }
    }

    private bool EsCitaLista(OdooCitaDto cita)
    {
        if (cita.Examenes == null || !cita.Examenes.Any()) return false;
        // Un examen esta listo si tiene un adjunto (imagen/PDF subido) 
        // O si tiene valores de laboratorio ingresados
        return cita.Examenes.Any(e => e.TieneAdjunto1 || e.TieneAdjunto2 || (e.Valores != null && e.Valores.Any()));
    }

    private string searchTerm
    {
        get => _search;
        set 
        { 
            _search = value; 
            CurrentPage = 1; // reset page on search
        }
    }

    // Pagination
    private int CurrentPage = 1;
    private const int PageSize = 20;

    private List<OdooCitaDto> citasFiltradas => citas is null
        ? new()
        : citas.Where(c => 
            (string.IsNullOrWhiteSpace(_search) || 
            c.Paciente.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            c.Cedula.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            c.NumeroCita.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
            (estadoFiltro == "Todos" || (estadoFiltro == "Listos" && EsCitaLista(c)) || (estadoFiltro == "Pendientes" && !EsCitaLista(c)))
        )
        .OrderBy(c => c.Paciente) // Orden alfabetico por paciente
        .ToList();

    private List<OdooCitaDto> citasPaginadas => citasFiltradas
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private int TotalPages => (int)Math.Ceiling(citasFiltradas.Count / (double)PageSize);
    
    private int TotalPacientes 
    {
        get
        {
            int fromOdoo = citas?.Select(c => c.Cedula).Distinct().Count() ?? 0;
            int fromLegacy = pacientesAntiguos?.Count ?? 0;
            return fromOdoo + fromLegacy;
        }
    }

    private List<PacientePdf> pacientesAntiguosFiltrados => pacientesAntiguos is null
        ? new()
        : pacientesAntiguos.Where(p => 
            string.IsNullOrWhiteSpace(_search) || 
            p.NombreCompleto.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => p.NombreCompleto)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("laboratorio.getToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        ExtraerDatosEmpresa(token);
        Api.SetToken(token);

        // Cargamos ambas fuentes de datos en paralelo
        var taskOdoo = Api.GetMisResultadosExternosAsync();
        var taskLegacy = Api.GetPacientesPorCarpetaAsync();
        
        await Task.WhenAll(taskOdoo, taskLegacy);
        
        citas = taskOdoo.Result;
        pacientesAntiguos = taskLegacy.Result;

        // SI NO ENCONTRÓ EL NOMBRE EN EL TOKEN, CONSULTAMOS LA LISTA DE EMPRESAS DE LA API
        if (nombreEmpresa == "Empresa Cliente" || nombreEmpresa == "Nombre del Paciente / Empresa")
        {
            try
            {
                var listaEmpresas = await Api.GetEmpresasConPacientesAsync();
                var emp = listaEmpresas?.FirstOrDefault(e => e.Ruc != null && e.Ruc.Trim() == rucEmpresa.Trim());
                if (emp != null && !string.IsNullOrEmpty(emp.NombreEmpresa))
                {
                    nombreEmpresa = emp.NombreEmpresa;
                }
            }
            catch { }
        }
    }

        private void ExtraerDatosEmpresa(string token)
    {
        try
        {
            var payload = token.Split('.')[1];
            var payloadStr = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(PadBase64(payload)));
            var payloadJson = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(payloadStr);
            if (payloadJson != null)
            {
                // Intentamos leer el RUC
                var rucClaim = payloadJson.FirstOrDefault(x =>
                    x.Key.Equals("RUC", StringComparison.OrdinalIgnoreCase) ||
                    x.Key.Equals("username", StringComparison.OrdinalIgnoreCase) ||
                    x.Key.Equals("unique_name", StringComparison.OrdinalIgnoreCase)
                ).Value?.ToString();
                
                if (!string.IsNullOrEmpty(rucClaim))
                {
                    rucEmpresa = rucClaim;
                }

                // Buscamos cualquier claim que tenga el Nombre
                var nameClaim = payloadJson.FirstOrDefault(x =>
                    x.Key.Equals("Nombre", StringComparison.OrdinalIgnoreCase) ||
                    x.Key.Equals("RazonSocial", StringComparison.OrdinalIgnoreCase) ||
                    x.Key.Equals("NombreEmpresa", StringComparison.OrdinalIgnoreCase) ||
                    x.Key.Equals("name", StringComparison.OrdinalIgnoreCase) ||
                    x.Key.EndsWith("/name", StringComparison.OrdinalIgnoreCase)
                ).Value?.ToString();
                
                // Si existe el claim del nombre y no es igual al RUC, lo asignamos
                if (!string.IsNullOrEmpty(nameClaim) && nameClaim != rucEmpresa)
                {
                    nombreEmpresa = nameClaim.Replace("_", " ");
                }
            }
        }
        catch { }
    }

    private async Task VerPdfAntiguo(string nombreArchivo)
    {
        var base64 = await Api.GetPdfBase64PorNombreAsync(nombreArchivo);
        if (!string.IsNullOrEmpty(base64))
        {
            // Open PDF in a new tab using data URI
            await JS.InvokeVoidAsync("abrirPdfDesdeBase64", base64, nombreArchivo);
        }
    }

    private async Task AbrirModalLegacy(string nombreCompleto)
    {
        pacienteSeleccionado = nombreCompleto;
        mostrarModalLegacy = true;
        isLoadingLegacyDetails = true;

        var rxInfTask = Api.GetRxInformesPorNombreAsync(nombreCompleto);
        var rxImgTask = Api.GetRxImagenesPorNombreAsync(nombreCompleto);
        var ecoInfTask = Api.GetEcoInformesPorNombreAsync(nombreCompleto);
        var ecoImgTask = Api.GetEcoImagenesPorNombreAsync(nombreCompleto);

        await Task.WhenAll(rxInfTask, rxImgTask, ecoInfTask, ecoImgTask);

        legacyRxInformes = rxInfTask.Result;
        legacyRxImagenes = rxImgTask.Result;
        legacyEcoInformes = ecoInfTask.Result;
        legacyEcoImagenes = ecoImgTask.Result;

        isLoadingLegacyDetails = false;
    }

    private void CerrarModalLegacy()
    {
        mostrarModalLegacy = false;
    }

    private string PadBase64(string base64)
    {
        switch (base64.Length % 4)
        {
            case 2: base64 += "=="; break;
            case 3: base64 += "="; break;
        }
        return base64.Replace('-', '+').Replace('_', '/');
    }

    private void CambiarPagina(int pageNum)
    {
        if (pageNum >= 1 && pageNum <= TotalPages)
        {
            CurrentPage = pageNum;
        }
    }
