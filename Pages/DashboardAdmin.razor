    private List<UsuarioListItem> ObtenerRegistrosPaginados() =>
        ObtenerRegistrosFiltrados().Skip((paginaActual - 1) * TamanoPagina).Take(TamanoPagina).ToList();

    private int TotalFiltrados => ObtenerRegistrosFiltrados().Count;
    private int TotalPaginas => (int)Math.Ceiling((double)TotalFiltrados / TamanoPagina);
    private int RangoInicio => TotalFiltrados == 0 ? 0 : ((paginaActual - 1) * TamanoPagina) + 1;
    private int RangoFin => Math.Min(paginaActual * TamanoPagina, TotalFiltrados);

    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= TotalPaginas) paginaActual = nuevaPagina;
    }

    // Numeros de pagina a mostrar: primera, ultima y 2 a cada lado de la actual; 0 = puntos suspensivos
    private IEnumerable<int> PaginasVisibles()
    {
        int total = TotalPaginas;
        if (total == 0) yield break;
        var paginas = new SortedSet<int> { 1, total };
        for (int i = paginaActual - 2; i <= paginaActual + 2; i++)
            if (i >= 1 && i <= total) paginas.Add(i);
        int previa = 0;
        foreach (var p in paginas)
        {
            if (previa != 0 && p - previa > 1) yield return 0;
            yield return p;
            previa = p;
        }
    }

