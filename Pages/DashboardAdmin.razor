                                                    <button type="button" class="ml-auto flex items-center justify-center w-8 h-8 rounded-full text-gray-400 hover:text-turquesa-600 hover:bg-turquesa-50 transition-colors" @onclick="() => TogglePasswordVisibility(u.Cedula ?? u.IdUsuario.ToString())">
                                                        <i class="fa-solid @(visiblePasswords.Contains(u.Cedula ?? u.IdUsuario.ToString()) ? "fa-eye-slash" : "fa-eye")"></i>
