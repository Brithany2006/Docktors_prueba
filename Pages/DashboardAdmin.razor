        bool perfilDerivaciones(UsuarioListItem u) => u.Rol == "Doctor" || u.Rol == "AdminDerivaciones";
        var consulta = activeTab == AdminTab.Derivaciones ? usuarios.Where(perfilDerivaciones) : usuarios.Where(u => !perfilDerivaciones(u));
        if (!string.IsNullOrWhiteSpace(searchQuery))
