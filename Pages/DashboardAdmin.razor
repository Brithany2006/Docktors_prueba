@page "/dashboard-admin"
@using LaboratorioFront.Services
@using System.Text.Json
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@inject ApiService Api
@inject DerivacionesService DerivService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="min-h-screen bg-gray-50 flex flex-col md:flex-row">
    <!-- Sidebar -->
    <aside class="w-full md:w-64 bg-white shadow-md flex-shrink-0 flex flex-col md:min-h-screen p-4 border-r border-gray-200">
        <div class="mb-8 px-2 flex items-center justify-center md:justify-start gap-3">
            <div class="h-10 w-10 bg-turquesa-500 rounded-lg flex items-center justify-center shadow-md">
                <i class="fa-solid fa-hospital text-white text-xl"></i>
            </div>
            <h2 class="text-xl font-bold text-turquesa-900 hidden md:block">Panel Admin</h2>
        </div>
        
        <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-visible pb-2 md:pb-0">
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.Import ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.Import)">
                 <i class="fa-solid fa-file-excel w-5 text-center @(activeTab == AdminTab.Import ? "text-turquesa-600" : "text-gray-400")"></i> Importar Excel
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.Sync ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.Sync)">
                <i class="fa-solid fa-arrows-rotate w-5 text-center @(activeTab == AdminTab.Sync ? "text-turquesa-600" : "text-gray-400")"></i> Sincronizar PDFs
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.User ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.User)">
                 <i class="fa-solid fa-user-plus w-5 text-center @(activeTab == AdminTab.User ? "text-turquesa-600" : "text-gray-400")"></i> Crear Usuario
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.Usuarios ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.Usuarios)">
                 <i class="fa-solid fa-users w-5 text-center @(activeTab == AdminTab.Usuarios ? "text-turquesa-600" : "text-gray-400")"></i> Usuarios
            </button>
                        <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.Carousel ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.Carousel)">
                 <i class="fa-solid fa-images w-5 text-center @(activeTab == AdminTab.Carousel ? "text-turquesa-600" : "text-gray-400")"></i> Carrusel
            </button>
                        <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.Derivaciones ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.Derivaciones)">
                 <i class="fa-solid fa-stethoscope w-5 text-center @(activeTab == AdminTab.Derivaciones ? "text-turquesa-600" : "text-gray-400")"></i> Derivaciones
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.Citas ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.Citas)">
                 <i class="fa-solid fa-calendar-check w-5 text-center @(activeTab == AdminTab.Citas ? "text-turquesa-600" : "text-gray-400")"></i> Citas Medicas
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.Horarios ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.Horarios)">
                <i class="fa-solid fa-clock w-5 text-center @(activeTab == AdminTab.Horarios ? "text-turquesa-600" : "text-gray-400")"></i> Horarios Medicos
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == AdminTab.CrearDoctor ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="() => SetTab(AdminTab.CrearDoctor)">
                <i class="fa-solid fa-user-doctor w-5 text-center @(activeTab == AdminTab.CrearDoctor ? "text-turquesa-600" : "text-gray-400")"></i> Crear Doctor
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto">
        <h3 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
            <i class="fa-solid fa-gears text-turquesa-500 mr-3"></i> Gestion de Plataforma
        </h3>
        
        @if (loading)
        {
            <div class="flex justify-center items-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-turquesa-500"></div>
            </div>
        }
        else if (!isAdmin)
        {
            <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md">
                <div class="flex">
                    <div class="flex-shrink-0"><i class="fa-solid fa-triangle-exclamation text-red-500"></i></div>
                    <div class="ml-3"><p class="text-sm text-red-700">No tienes permisos para acceder a esta pagina.</p></div>
                </div>
            </div>
        }
        else
        {
            @if (activeTab == AdminTab.Import)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h4 class="text-lg font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-file-import text-turquesa-500 mr-2"></i> Importar pacientes (Excel cuyo nombre es el <b>RUC.xlsx</b>)</h4>

                    <div class="form-row">
                        <InputFile OnChange="OnInputFileChange" accept=".xlsx" />
                        <button class="btn-login" @onclick="ImportarExcel" disabled="@(!hayArchivo)">Importar</button>
                    </div>
                    @if (!string.IsNullOrEmpty(msgImport))
                    {
                        <div class="alert alert-info mt-2">@((MarkupString)msgImport)</div>
                    }
                </div>
            }

            @if (activeTab == AdminTab.Sync)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
                    <h4 class="text-lg font-bold text-gray-800 mb-2 flex items-center"><i class="fa-solid fa-arrows-rotate text-turquesa-500 mr-2"></i> Sincronizar Resultados de Laboratorio</h4>
                    <p class="hint">Deja el campo vacio para sincronizar <i>todas</i> las empresas.</p>

                    <div class="form-row">
                        <input class="input-text" placeholder="(Opcional) RUC especifico" @bind="rucSync" />
                        <button class="btn-primary" @onclick="Sincronizar">Sincronizar LAB</button>
                    </div>
                    @if (!string.IsNullOrEmpty(msgSync))
                    {
                        <div class="alert alert-info mt-2">@((MarkupString)msgSync)</div>
                    }
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
                    <h4 class="text-lg font-bold text-gray-800 mb-2 flex items-center"><i class="fa-solid fa-x-ray text-turquesa-500 mr-2"></i> Sincronizar Resultados de RX</h4>
                    <p class="hint">
                        Usa las carpetas locales configuradas (informes + imagenes RX).
                        Deja el campo vacio para sincronizar todas las empresas.
                    </p>

                    <div class="form-row">
                        <input class="input-text" placeholder="(Opcional) RUC especifico" @bind="rucRxSync" />
                        <button class="btn-primary" @onclick="SincronizarRx">Sincronizar RX</button>
                    </div>
                    @if (!string.IsNullOrEmpty(msgSyncRx))
                    {
                        <div class="alert alert-info mt-2">@((MarkupString)msgSyncRx)</div>
                    }
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
                    <h4 class="text-lg font-bold text-gray-800 mb-2 flex items-center"><i class="fa-solid fa-heart-pulse text-turquesa-500 mr-2"></i> Sincronizar Ecografias</h4>
                    <p class="hint">
                        Usa la carpeta de Ecografias configurada (informes + JPG).
                        Deja el RUC vacio para sincronizar todas las empresas.
                    </p>

                    <div class="form-row">
                        <input class="input-text" placeholder="(Opcional) RUC especifico" @bind="rucEcoSync" />
                        <button class="btn-primary" @onclick="SincronizarEco">Sincronizar ECO</button>
                    </div>
                    @if (!string.IsNullOrEmpty(msgSyncEco))
                    {
                        <div class="alert alert-info mt-2">@((MarkupString)msgSyncEco)</div>
                    }
                </div>
            }

            @if (activeTab == AdminTab.User)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h4 class="text-lg font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-user-plus text-turquesa-500 mr-2"></i> Crear UsuarioEmpresa</h4>

                    <EditForm Model="nuevoUsuario" OnValidSubmit="CrearUsuario" class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                        <div class="col-span-1">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Nombre usuario</label>
                            <InputText class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" @bind-Value="nuevoUsuario.Nombre" />
                        </div>

                        @if (nuevoUsuario.Rol != "UsuarioCaja")
                        {
                            <div class="col-span-1">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Nombre empresa</label>
                                <InputText class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" @bind-Value="nuevoUsuario.NombreEmpresa" />
                            </div>
                        }

                        <div class="col-span-1">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">@(nuevoUsuario.Rol == "UsuarioCaja" ? "Cedula o Usuario" : "RUC empresa")</label>
                            <InputText class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" @bind-Value="nuevoUsuario.RUC" />
                        </div>

                        <div class="col-span-1">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Contrasena</label>
                            <InputText type="password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" @bind-Value="nuevoUsuario.Password" placeholder='@(nuevoUsuario.Rol == "UsuarioEmpresa" ? "Autogenerada (Aleatoria) si se deja en blanco" : "")' />
                        </div>

                        <div class="col-span-1">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Rol</label>
                            <InputSelect class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" @bind-Value="nuevoUsuario.Rol">
                                <option value="UsuarioEmpresa">Usuario empresa</option>
                                <option value="Admin">Administrador</option>
                                <option value="UsuarioCaja">Usuario Caja</option>
                                <option value="CajaCitas">Caja (Solo Citas)</option>
                                <option value="ECOMD">Procedimientos: Ecocardiograma (ECOMD)</option>
                                <option value="AdminDerivaciones">Administrador de Derivaciones (Carla)</option>
                            </InputSelect>
                        </div>

                        <div class="col-span-1 flex items-center mt-6">
                            <label class="flex items-center space-x-3 cursor-pointer">
                                <input type="checkbox" class="w-5 h-5 text-turquesa-600 border-gray-300 rounded focus:ring-turquesa-500" @bind="nuevoUsuario.Activo" />
                                <span class="text-sm font-semibold text-gray-700">Usuario activo</span>
                            </label>
                        </div>

                        @if (nuevoUsuario.Rol != "UsuarioCaja")
                        {
                            <div class="col-span-1 md:col-span-2 mt-4 pt-4 border-t border-gray-100">
                                <h5 class="text-md font-bold text-gray-700 mb-4">Personalizacion de Empresa (Opcional)</h5>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="col-span-1">
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">Logo (.png/.jpg)</label>
                                        <InputFile OnChange="OnLogoChange" accept="image/png, image/jpeg" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-turquesa-50 file:text-turquesa-700 hover:file:bg-turquesa-100" />
                                    </div>
                                    <div class="col-span-1">
                                        <label class="block text-sm font-semibold text-gray-700 mb-2">Banner (.jpg)</label>
                                        <InputFile OnChange="OnBannerChange" accept="image/jpeg" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-turquesa-50 file:text-turquesa-700 hover:file:bg-turquesa-100" />
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(bannerPreview))
                                {
                                    <div class="mt-4 bg-gray-50 p-4 rounded-xl border border-gray-200 col-span-1 md:col-span-2">
                                        <p class="text-sm font-semibold text-gray-700 mb-2">Vista Previa del Banner:</p>
                                        @if (!recorteConfirmado)
                                        {
                                            <div style="max-height: 400px; overflow: hidden;" class="rounded-lg border border-gray-300 mb-3">
                                                <img id="cropper-banner-admin" src="@bannerPreview" class="max-w-full block" />
                                            </div>
                                            <button type="button" class="px-4 py-2 bg-turquesa-600 hover:bg-turquesa-700 text-white font-bold rounded-lg transition-all" @onclick="ConfirmarRecorteBanner">Confirmar</button>
                                        }
                                        else
                                        {
                                            <img src="@bannerFinalBase64" class="w-full object-cover rounded-lg shadow-sm border border-gray-200 mb-3" />
                                            <button type="button" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-bold rounded-lg transition-all" @onclick="VolverARecortarBanner">Cambiar Recorte</button>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="col-span-1 md:col-span-2 flex justify-end mt-4">
                            <button type="submit" class="w-full md:w-auto px-8 py-3 bg-turquesa-600 hover:bg-turquesa-700 text-white font-bold rounded-lg shadow-md transition-all"><i class="fa-solid fa-check mr-2"></i> Crear Usuario</button>
                        </div>
                    </EditForm>
                    @if (!string.IsNullOrEmpty(mensajeUsuario))
                    {
                        <div class="alert alert-info mt-2">@mensajeUsuario</div>
                    }
                </div>
            }

                        @if (activeTab == AdminTab.Derivaciones)
            {
                <div class="">
                    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
                        <h4 class="text-xl font-bold text-gray-800 flex items-center"><i class="fa-solid fa-stethoscope text-turquesa-500 mr-2"></i> Usuarios de Derivaciones</h4>
                        <div class="relative w-full md:w-1/3">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                            <input type="text" placeholder="Buscar por nombre o RUC..." class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" @bind="searchQuery" @bind:event="oninput" />
                        </div>
                    </div>
                    @if (usuariosLoading)
                    {
                        <div class="flex justify-center items-center py-12">
                            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-turquesa-500"></div>
                        </div>
                    }
                    else if (usuarios == null || !usuarios.Where(x => x.Rol == "Doctor" || x.Rol == "AdminDerivaciones").Any())
                    {
                        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 text-center text-gray-500">
                            <i class="fa-solid fa-users-slash text-4xl mb-3 text-gray-300"></i>
                            <p>No hay perfiles de derivaciones (Doctores o Admin) registrados</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                            @foreach (var u in usuarios.Where(x => string.IsNullOrEmpty(searchQuery) || 
                                (x.Nombre != null && x.Nombre.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) || 
                                (x.RUC != null && x.RUC.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
                                .Where(x => x.Rol == "Doctor" || x.Rol == "AdminDerivaciones"))
                            {
                                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow group flex flex-col h-full">
                                    <div class="p-6 flex-grow">
                                        <div class="flex justify-between items-start mb-4">
                                            <div class="flex items-center gap-3">
                                                <div class="h-10 w-10 rounded-full bg-turquesa-50 flex items-center justify-center text-turquesa-600 font-bold text-lg">
                                                    @(u.Nombre?.Substring(0,1).ToUpper() ?? "U")
                                                </div>
                                                <div>
                                                    <h5 class="font-bold text-gray-800 text-lg leading-tight line-clamp-1" title="@u.Nombre">@u.Nombre</h5>
                                                    <span class="inline-block px-2 py-0.5 mt-1 bg-turquesa-50 text-turquesa-700 text-xs font-semibold rounded-md border border-turquesa-100">
                                                        @(u.Rol == "AdminDerivaciones" ? "Administrador de Derivaciones" : "Doctor")
                                                    </span>
                                                </div>
                                            </div>
                                            @if (u.Activo)
                                            {
                                                <span class="h-2.5 w-2.5 rounded-full bg-green-500" title="Activo"></span>
                                            }
                                            else
                                            {
                                                <span class="h-2.5 w-2.5 rounded-full bg-red-500" title="Inactivo"></span>
                                            }
                                        </div>
                                        <div class="space-y-2 text-sm text-gray-600">
                                            <p class="flex items-center"><i class="fa-regular fa-id-card w-5 text-gray-400"></i> <strong class="mr-2">RUC/Cedula:</strong> @u.RUC</p>
                                        </div>
                                    </div>
                                    
                                    <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 group-hover:bg-turquesa-50 transition-colors flex flex-col sm:flex-row gap-2">
                                        <button class="flex-1 flex justify-center items-center py-2 px-3 border border-gray-300 rounded-lg shadow-sm text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-turquesa-500 transition-colors" @onclick="@(() => Nav.NavigateTo($"/usuario-editar/{u.IdUsuario}"))">
                                            <i class="fa-solid fa-pen-to-square mr-2"></i> Editar
                                        </button>
                                        <button class="flex-1 flex justify-center items-center py-2 px-3 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-turquesa-500 hover:bg-turquesa-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-turquesa-500 transition-colors" @onclick="@(() => CopiarAlPortapapeles(u))">
                                            <i class="fa-solid fa-share-nodes mr-2"></i> Compartir
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

                        @if (activeTab == AdminTab.Citas)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
                    <h4 class="text-xl font-bold text-gray-800 mb-6 flex items-center"><i class="fa-solid fa-calendar-check text-turquesa-500 mr-2"></i> Gestion de Citas Medicas</h4>
                    
                    @if (citasLoading)
                    {
                        <div class="flex justify-center items-center py-8">
                            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-turquesa-600"></div>
                            <span class="ml-3 text-turquesa-600 font-semibold">Cargando citas...</span>
                        </div>
                    }
                    else if (todasLasCitas == null || !todasLasCitas.Any())
                    {
                        <div class="text-center py-8 text-gray-500 bg-gray-50 rounded-xl border border-gray-100">
                            <i class="fa-solid fa-calendar-xmark text-4xl mb-3 text-gray-300"></i>
                            <p>No hay citas registradas</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto rounded-xl border border-gray-200">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-gray-50 border-b border-gray-200">
                                    <tr>
                                        <th class="p-4 text-sm font-semibold text-gray-600">Fecha/Hora</th>
                                        <th class="p-4 text-sm font-semibold text-gray-600">Paciente</th>
                                        <th class="p-4 text-sm font-semibold text-gray-600">Doctor</th>
                                        <th class="p-4 text-sm font-semibold text-gray-600">Especialidad</th>
                                        <th class="p-4 text-sm font-semibold text-gray-600">Estado</th>
                                        <th class="p-4 text-sm font-semibold text-gray-600">Tipo</th>
                                        <th class="p-4 text-sm font-semibold text-gray-600 text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var cita in todasLasCitas.OrderByDescending(c => c.FechaHora))
                                    {
                                        <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                            <td class="p-4 text-sm text-gray-800 font-medium whitespace-nowrap">@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="p-4 text-sm text-gray-600">@(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")</td>
                                            <td class="p-4 text-sm text-gray-600 font-semibold">@(cita.Doctor?.Nombre ?? "N/A")</td>
                                            <td class="p-4 text-sm text-gray-500">@(cita.Derivacion?.EspecialidadRequerida ?? cita.Doctor?.Especialidad ?? "N/A")</td>
                                            <td class="p-4">
                                                @if (cita.Estado == "Pendiente")
                                                {
                                                    <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-xs font-bold border border-yellow-200">Pendiente</span>
                                                }
                                                else if (cita.Estado == "Atendido")
                                                {
