    private async Task SubirLogo(string ruc, IBrowserFile file)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(ruc), "ruc");
            var streamContent = new StreamContent(file.OpenReadStream(10 * 1024 * 1024)); // 10MB
            content.Add(streamContent, "logoFile", file.Name);
            await Api.Http.PostAsync("admin/usuarios/logo", content);
        }
        catch { }
    }

    private async Task SubirBanner(string ruc, string base64Data)
    {
        try
        {
            // Convert base64 data URI to byte array
            var base64 = base64Data.Split(',')[1];
            var bytes = Convert.FromBase64String(base64);
            
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(ruc), "ruc");
            var streamContent = new ByteArrayContent(bytes);
            content.Add(streamContent, "bannerFile", "banner.jpg");
            await Api.Http.PostAsync("admin/usuarios/banner", content);
        }
        catch { }
    }

    private async Task VerRx(ApiService.PacienteItem p)
    {
        pacienteSeleccionado = p;
        rxMsg = string.Empty;
        rxLoading = true;
        try
        {
            HttpResponseMessage resInf = await Api.Http.GetAsync($"admin/pacientes/{p.Id}/rx/informes");
            if (resInf.IsSuccessStatusCode)
            {
                rxInformes = JsonSerializer.Deserialize<List<PacienteEstudio>>(await resInf.Content.ReadAsStringAsync(), new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<PacienteEstudio>();
            }
            else
            {
                rxInformes.Clear();
            }
            HttpResponseMessage resImg = await Api.Http.GetAsync($"admin/pacientes/{p.Id}/rx/imagenes");
            if (resImg.IsSuccessStatusCode)
            {
                rxImagenes = JsonSerializer.Deserialize<List<PacienteEstudio>>(await resImg.Content.ReadAsStringAsync(), new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<PacienteEstudio>();
            }
            else
            {
                rxImagenes.Clear();
            }
            if (!rxInformes.Any() && !rxImagenes.Any())
            {
                rxMsg = "Este paciente no tiene RX registrados.";
            }
        }
        catch (Exception ex)
        {
            rxMsg = "Error al cargar RX del paciente: " + ex.Message;
            rxInformes.Clear();
            rxImagenes.Clear();
        }
        finally
        {
            rxLoading = false;
        }
    }

    private async Task CargarUsuariosSiNecesario()
    {
        if (usuariosCargados)
        {
            return;
        }
        usuariosCargados = true;
        usuariosLoading = true;
        usuariosMsg = string.Empty;
        try
        {
            HttpResponseMessage res = await Api.Http.GetAsync("admin/usuarios");
            if (res.IsSuccessStatusCode)
            {
                usuarios = JsonSerializer.Deserialize<List<UsuarioListItem>>(await res.Content.ReadAsStringAsync(), new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<UsuarioListItem>();
                if (!usuarios.Any())
                {
                    usuariosMsg = "No hay usuarios registrados.";
                }
            }
            else
            {
                usuariosMsg = "? " + await res.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            usuariosMsg = "? Error al cargar usuarios: " + ex.Message;
        }
        finally
        {
            usuariosLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        string token = await JS.InvokeAsync<string>("laboratorio.getToken", Array.Empty<object>());
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        Dictionary<string, object> payload = ParseJwt(token);
        string? roleClaim = payload.FirstOrDefault(x => x.Key.Equals("role", StringComparison.OrdinalIgnoreCase)).Value?.ToString();
        isAdmin = roleClaim == "Admin";
        if (!isAdmin)
        {
            Nav.NavigateTo("/", forceLoad: true);
        }
        else
        {
            loading = false;
        }
    }

    private Dictionary<string, object> ParseJwt(string token)
    {
        string[] array = token.Split('.');
        if (array.Length != 3)
        {
            return new Dictionary<string, object>();
        }
        string text = array[1];
        text = text.PadRight(text.Length + (4 - text.Length % 4) % 4, '=');
        byte[] bytes = Convert.FromBase64String(text.Replace('-', '+').Replace('_', '/'));
        string json = Encoding.UTF8.GetString(bytes);
        return JsonSerializer.Deserialize<Dictionary<string, object>>(json) ?? new Dictionary<string, object>();
    }

    private async Task HandleCarouselUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            msgCarousel = "Subiendo imagen...";
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            await Api.UploadCarouselImageAsync(content);
            carouselImages = await Api.GetCarouselImagesAsync();
            msgCarousel = "Imagen subida correctamente.";
        }
        catch (Exception ex)
        {
            msgCarousel = $"Error al subir: {ex.Message}";
        }
    }

    private async Task DeleteCarousel(string filename)
    {
        try
        {
            await Api.DeleteCarouselImageAsync(filename);
            carouselImages = await Api.GetCarouselImagesAsync();
        }
        catch (Exception ex)
        {
            msgCarousel = $"Error al eliminar: {ex.Message}";
        }
    }
