        string url = string.IsNullOrWhiteSpace(rucSync) ? "admin/sincronizar" : ("admin/sincronizar?ruc=" + rucSync);
        HttpResponseMessage res = await Api.Http.PostAsync(url, null);
        string text = (!res.IsSuccessStatusCode) ? ("? " + await res.Content.ReadAsStringAsync()) : (await res.Content.ReadAsStringAsync());
        msgSync = text;
    }

    private async Task SincronizarRx()
    {
        msgSyncRx = "? Sincronizando RX...";
        string url = string.IsNullOrWhiteSpace(rucRxSync) ? "admin/sincronizar-rx" : ("admin/sincronizar-rx?ruc=" + rucRxSync);
        HttpResponseMessage res = await Api.Http.PostAsync(url, null);
        string text = (!res.IsSuccessStatusCode) ? ("? " + await res.Content.ReadAsStringAsync()) : (await res.Content.ReadAsStringAsync());
        msgSyncRx = text;
    }

    private async Task SincronizarEco()
    {
        msgSyncEco = "? Sincronizando ecografias...";
        string url = string.IsNullOrWhiteSpace(rucEcoSync) ? "admin/sincronizar-eco" : ("admin/sincronizar-eco?ruc=" + rucEcoSync);
        HttpResponseMessage res = await Api.Http.PostAsync(url, null);
        string text = (!res.IsSuccessStatusCode) ? ("? " + await res.Content.ReadAsStringAsync()) : (await res.Content.ReadAsStringAsync());
        msgSyncEco = text;
