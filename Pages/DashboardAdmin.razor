            private List<LaboratorioFront.Services.DerivacionesService.CitaDerivacionResponse> todasLasCitas = new();
    private bool citasLoading = false;

        private async Task EliminarCita(int idCita)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "¿Esta seguro que desea eliminar esta cita de derivacion?");
        if (confirm)
        {
            citasLoading = true;
            StateHasChanged();
            bool result = await DerivService.DeleteCitaAsync(idCita);
            if (result)
            {
                todasLasCitas = await DerivService.GetAllCitasAsync();
                await ShowToast("Cita eliminada exitosamente.");
            }
            else
            {
                await ShowToast("Hubo un error al eliminar la cita.");
            }
            citasLoading = false;
            StateHasChanged();
        }
    }
    private async Task SetTab(AdminTab tab)
    {
        activeTab = tab;
        msgImport = string.Empty;
        msgSync = string.Empty;
        msgSyncRx = string.Empty;
        msgSyncEco = string.Empty;
        mensajeUsuario = string.Empty;
        if (tab == AdminTab.Usuarios || tab == AdminTab.Derivaciones)
        {
            _ = CargarUsuariosSiNecesario();
        }
        else if (tab == AdminTab.Citas)
        {
            citasLoading = true;
            StateHasChanged();
            todasLasCitas = await DerivService.GetAllCitasAsync();
            citasLoading = false;
            StateHasChanged();
        }
    }

    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        archivoExcel = e.File;
        hayArchivo = archivoExcel != null;
        msgImport = string.Empty;
    }

    private async Task ImportarExcel()
    {
        msgImport = string.Empty;
        if (archivoExcel == null)
        {
            msgImport = "Seleccione un archivo Excel (el nombre del archivo debe ser el RUC).";
            return;
        }
        using Stream stream = archivoExcel.OpenReadStream(20971520L);
        using var content = new MultipartFormDataContent();
        var streamContent = new StreamContent(stream);
        content.Add(streamContent, "excelFile", archivoExcel.Name);
        HttpResponseMessage res = await Api.Http.PostAsync("admin/pacientes/importar-excel", content);
        string text = (!res.IsSuccessStatusCode) ? ("? " + await res.Content.ReadAsStringAsync()) : (await res.Content.ReadAsStringAsync());
        msgImport = text;
    }

    private async Task CargarEmpresasSiNecesario()
    {
        if (empresas.Any())
        {
            return;
        }
        empresasMsg = "Cargando empresas...";
        try
        {
            empresas = (await Api.GetEmpresasConPacientesAsync()) ?? new List<ApiService.EmpresaPacientesResponse>();
            if (!empresas.Any())
            {
                empresasMsg = "No se encontraron empresas con pacientes.";
                empresaSeleccionada = null;
            }
            else
            {
                empresasMsg = string.Empty;
                empresaSeleccionada = empresas.First();
            }
        }
        catch
        {
            empresasMsg = "? Error al cargar empresas.";
            empresaSeleccionada = null;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SeleccionarEmpresa(ApiService.EmpresaPacientesResponse emp)
    {
        empresaSeleccionada = emp;
        pacienteSeleccionado = null;
        rxInformes.Clear();
        rxImagenes.Clear();
        rxMsg = string.Empty;
    }

    private async Task Sincronizar()
