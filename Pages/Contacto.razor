@page "/Contacto"
@inject IJSRuntime JS
<PageTitle>Contacto | Centro Médico Klinic</PageTitle>

<section class="kl-section" aria-labelledby="kl-con-titulo">
    <h1 id="kl-con-titulo" class="kl-page-title kl-up kl-d1">Comunícate con nosotros</h1>
    <p class="kl-page-lead kl-up kl-d2">Encuentra tu sede más cercana: estamos disponibles para ti en nuestras diferentes instalaciones.</p>
    <h2 class="kl-sr">Nuestras sedes</h2>
    <SedesKlinic Claro="true" ConMapa="true" />

    <div class="mt-10 kl-reveal">
        <h2 class="kl-page-title" style="font-size:1.4rem">Códigos QR</h2>
        <p class="kl-page-lead" style="margin-bottom:1rem">Escanéalos con tu celular para escribirnos por WhatsApp o ubicar la sede.</p>
        <img src="/images/contactos.png" alt="Códigos QR de WhatsApp y ubicación de cada sede de Centro Médico Klinic" class="w-full max-w-4xl rounded-2xl shadow-lg" loading="lazy" />
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("klinic.reveal"); } catch { }
    }
}
