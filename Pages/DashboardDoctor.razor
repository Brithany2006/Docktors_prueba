@page "/dashboard-doctor"
@using LaboratorioFront.Services
@inject DerivacionesService Service
@inject TokenStore Tokens
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Doctor | Centro Médico Klinic</PageTitle>

<div class="admin-layout flex flex-col md:flex-row min-h-screen bg-gray-50 font-sans">
    <aside class="w-full md:w-64 bg-white shadow-md flex-shrink-0 flex flex-col md:min-h-screen p-4 border-r border-gray-200">
        <div class="mb-8 px-2 flex items-center justify-center md:justify-start gap-3">
            <div class="h-10 w-10 bg-turquesa-500 rounded-lg flex items-center justify-center shadow-md">
                <i class="fa-solid fa-user-doctor text-white text-xl"></i>
            </div>
            <h2 class="text-xl font-bold text-turquesa-900 hidden md:block">Panel Doctor</h2>
        </div>
        
        <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-visible pb-2 md:pb-0">
            <button @onclick='() => SetTab("Agenda")' class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == "Agenda" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")">
                 <i class="fa-solid fa-calendar-days w-5 text-center @(activeTab == "Agenda" ? "text-turquesa-600" : "text-gray-400")"></i> Agenda de Derivaciones
            </button>
            <button @onclick='() => SetTab("EnCurso")' class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == "EnCurso" ? "bg-amber-50 text-amber-800 shadow-sm border border-amber-200" : "text-gray-600 hover:bg-gray-100")">
                 <i class="fa-solid fa-hourglass-half w-5 text-center @(activeTab == "EnCurso" ? "text-amber-600" : "text-gray-400")"></i> Pacientes en curso
                 @if (EnCursoVigentes.Count > 0)
                 {
                     <span class="ml-auto px-2 py-0.5 bg-amber-500 text-white rounded-full text-xs font-bold">@EnCursoVigentes.Count</span>
                 }
            </button>
            <button @onclick='() => SetTab("Buscar")' class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(activeTab == "Buscar" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")">
                 <i class="fa-solid fa-magnifying-glass w-5 text-center @(activeTab == "Buscar" ? "text-turquesa-600" : "text-gray-400")"></i> Buscar Paciente
            </button>
            
            <div class="mt-auto hidden md:block pt-4 border-t border-gray-100">
                <button class="w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-red-600 hover:bg-red-50 rounded-xl transition-colors" @onclick="Salir">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i> Salir
                </button>
            </div>
        </div>
    </aside>

    <main class="flex-grow p-4 md:p-8 overflow-y-auto">
        @if (sedes.Count > 1)
        {
            <div class="flex flex-wrap items-center gap-2 mb-4">
                <span class="text-sm font-medium text-gray-600">Sede:</span>
                @foreach (var sede in sedes)
                {
                    <button type="button" @onclick="() => CambiarSede(sede)" class="px-4 py-2 text-sm font-semibold rounded-lg border transition-colors @(sede == sedeActual ? "bg-turquesa-600 text-white border-turquesa-600 shadow-sm" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-100")">Sede @sede</button>
                }
            </div>
        }
        @if(activeTab == "Agenda") {
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <h2 class="text-2xl font-bold text-gray-800">Agenda de Derivaciones</h2>
                <div class="flex items-center gap-3">
                    <label class="text-sm font-medium text-gray-600">Filtrar por fecha:</label>
                    <input type="date" @bind="fechaFiltro" @bind:event="oninput" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-turquesa-500 focus:border-turquesa-500 text-gray-700" />
                    @if(fechaFiltro.HasValue) {
                        <button @onclick="() => fechaFiltro = null" class="text-gray-400 hover:text-red-500 transition-colors" title="Borrar filtro">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                </div>
            </div>
            
            @if (citas == null)
            {
                <div class="flex justify-center items-center py-12 text-turquesa-600">
                    <i class="fa-solid fa-spinner fa-spin text-3xl"></i>
                </div>
            }
            else if (CitasFiltradas.Count == 0)
            {
                <div class="text-center py-12 text-gray-500">
                    <i class="fa-regular fa-calendar-xmark text-4xl mb-3"></i>
                    <p>No tienes citas programadas.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto rounded-xl border border-gray-200">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-gray-50 text-gray-700 border-b border-gray-200">
                            <tr>
                                <th class="px-6 py-4 font-semibold text-sm">Fecha/Hora</th>
                                <th class="px-6 py-4 font-semibold text-sm">Paciente</th>
                                <th class="px-6 py-4 font-semibold text-sm">Motivo</th>
                                <th class="px-6 py-4 font-semibold text-sm">Estado</th>
                                <th class="px-6 py-4 font-semibold text-sm text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var c in CitasFiltradas)
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4 text-sm font-medium text-gray-700">
                                  @c.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                  @if(c.EsTurnoExtra) { <span class="ml-2 px-2 py-0.5 bg-yellow-100 text-yellow-800 rounded-md text-xs font-bold border border-yellow-200">Turno extra</span> }
                              </td>
                                    <td class="px-6 py-4 text-sm text-gray-800 font-medium">@(c.Derivacion?.Paciente?.NombreCompleto)<LaboratorioFront.Pages.Componentes.BadgeTipoPaciente Tipo="@c.Derivacion?.TipoPaciente" Origen="@c.Derivacion?.Origen" />
                                        @if (EsEcoCita(c.Derivacion?.EspecialidadRequerida)) { <br><span class="inline-block mt-1 px-2 py-0.5 bg-purple-100 text-purple-700 rounded-md text-xs font-bold border border-purple-200">Ecocardiograma</span> }
                                        @if (EsActivadoCaja(c.Derivacion?.Observaciones)) { <br><span class="inline-block mt-1 px-2 py-0.5 bg-green-100 text-green-700 rounded-md text-xs font-bold border border-green-200" title="Paciente activado en Caja: ya esta presente, atender ahora">Activado en Caja</span> }</td>
                                    <td class="px-6 py-4 text-sm text-gray-600">@(c.Derivacion?.EspecialidadRequerida)</td>
                                    <td class="px-6 py-4 text-sm">
                                        @if(c.Estado == "Atendido")
                                        {
                                            <span class="px-2 py-1 bg-green-100 text-green-700 rounded-md font-semibold text-xs uppercase">@c.Estado</span>
                                        }
                                        else
                                        {
                                            if (c.Estado == "En curso")
                                            {
                                                <span class="px-2 py-1 bg-amber-100 text-amber-800 rounded-md font-semibold text-xs uppercase" title="El paciente no confirmó por WhatsApp. Si asistió, márcalo como atendido.">Sin confirmar</span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-md font-semibold text-xs uppercase">@c.Estado</span>
                                            }
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                                                                <div class="flex items-center justify-center gap-2">
                                                                                          @if (c.Estado == "Pendiente" || c.Estado == "En curso")
                                              {
                                                  <div class="flex flex-col gap-2 w-full">
                                                      <button class="btn-success flex items-center justify-center gap-2 w-full" @onclick="() => MarcarAtendido(c)">
                                                          <i class="fa-solid fa-check text-lg"></i> Marcar Atendido
                                                      </button>
                                                      <button class="btn-danger flex items-center justify-center gap-2 w-full bg-red-100 text-red-600 hover:text-white" @onclick="() => MarcarNoAsistio(c)">
                                                          <i class="fa-solid fa-user-xmark"></i> No Asistió
                                                      </button>
                                                  </div>
                                              }
                                                                                        @if (c.Estado == "No Asistio" && c.FechaHora.Date >= DateTime.Today.AddDays(-2))
                                            {
                                                <button class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-amber-300 text-amber-700 hover:bg-amber-50 text-xs font-bold rounded-lg transition-colors shadow-sm" title="Si lo marcaste por error o el paciente llegó tarde" @onclick="() => RevertirNoAsistio(c)">
                                                    <i class="fa-solid fa-rotate-left"></i> Revertir No Asistió
                                                </button>
                                            }
                                                                                        @if (!c.EsSubsecuente && !nombreUsuarioActual.ToLower().Contains("ekg") && c.Estado == "Atendido" && !TieneSubsecuenteAgendada(c))
                                            {
                                                <button class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-gray-300 text-gray-700 hover:bg-green-50 hover:text-green-700 hover:border-green-300 text-xs font-bold rounded-lg transition-colors shadow-sm" @onclick="() => AbrirAgendar(c)">
                                                    <i class="fa-solid fa-calendar-plus"></i> Agendar Subsecuente
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
} else if (activeTab == "EnCurso") {
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-1">Pacientes en curso</h2>
    <p class="text-sm text-gray-500 mb-6">Pacientes con cita que no confirmaron por WhatsApp. Si el paciente asistió, márcalo como atendido. Cuando la cita caduca (después de las 10:30 pm de su día) deja de aparecer aquí.</p>

    <div class="relative mb-6">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"><i class="fa-solid fa-search text-gray-400"></i></div>
        <input type="text" @bind="busquedaEnCurso" @bind:event="oninput" placeholder="Buscar por nombre o cédula del paciente..." class="block w-full pl-10 pr-10 py-3 border border-gray-300 rounded-lg bg-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 sm:text-sm shadow-sm" />
        @if (!string.IsNullOrEmpty(busquedaEnCurso))
        {
            <button @onclick='() => busquedaEnCurso = string.Empty' class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-red-500" title="Borrar búsqueda"><i class="fa-solid fa-xmark"></i></button>
        }
    </div>

    @if (citas == null)
    {
        <div class="flex justify-center items-center py-12 text-turquesa-600"><i class="fa-solid fa-spinner fa-spin text-3xl"></i></div>
    }
    else if (EnCursoVigentes.Count == 0)
    {
        <div class="text-center py-12 text-gray-500">
            <i class="fa-regular fa-circle-check text-4xl mb-3"></i>
            <p>No hay pacientes en curso pendientes de marcar.</p>
        </div>
    }
    else if (EnCursoFiltrados.Count == 0)
    {
        <div class="text-center py-12 text-gray-500">
            <i class="fa-solid fa-magnifying-glass text-4xl mb-3"></i>
            <p>Ningún paciente en curso coincide con la búsqueda.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-gray-200">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 text-gray-700 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-4 font-semibold text-sm">Fecha/Hora</th>
                        <th class="px-6 py-4 font-semibold text-sm">Paciente</th>
                        <th class="px-6 py-4 font-semibold text-sm">Motivo</th>
                        <th class="px-6 py-4 font-semibold text-sm text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var c in EnCursoFiltrados)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 text-sm font-medium text-gray-700">
                                @c.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                @if (c.FechaHora.Date == DateTime.Today) { <span class="ml-2 px-2 py-0.5 bg-amber-100 text-amber-800 rounded-md text-xs font-bold">Hoy</span> }
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-800 font-medium">
                                @(c.Derivacion?.Paciente?.NombreCompleto)<LaboratorioFront.Pages.Componentes.BadgeTipoPaciente Tipo="@c.Derivacion?.TipoPaciente" Origen="@c.Derivacion?.Origen" />
                                <br><span class="text-xs text-gray-500">@(c.Derivacion?.Paciente?.Cedula)</span>
                                @if (EsEcoCita(c.Derivacion?.EspecialidadRequerida)) { <br><span class="inline-block mt-1 px-2 py-0.5 bg-purple-100 text-purple-700 rounded-md text-xs font-bold border border-purple-200">Ecocardiograma</span> }
                                        @if (EsActivadoCaja(c.Derivacion?.Observaciones)) { <br><span class="inline-block mt-1 px-2 py-0.5 bg-green-100 text-green-700 rounded-md text-xs font-bold border border-green-200" title="Paciente activado en Caja: ya esta presente, atender ahora">Activado en Caja</span> }
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">@(c.Derivacion?.EspecialidadRequerida)</td>
                            <td class="px-6 py-4 text-center">
                                @if (c.FechaHora.Date == DateTime.Today)
                                {
                                    <div class="flex flex-col gap-2 w-full">
                                        <button class="btn-success flex items-center justify-center gap-2 w-full" @onclick="() => MarcarAtendido(c)">
                                            <i class="fa-solid fa-check text-lg"></i> Asistió (Marcar Atendido)
                                        </button>
                                        <button class="btn-danger flex items-center justify-center gap-2 w-full bg-red-100 text-red-600 hover:text-white" @onclick="() => MarcarNoAsistio(c)">
                                            <i class="fa-solid fa-user-xmark"></i> No Asistió
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-500">Se podrá marcar el día de la cita</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
} else if (activeTab == "Buscar") {
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Buscar Paciente</h2>
        <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"><i class="fa-solid fa-search text-gray-400"></i></div>
            <input type="text" @bind="searchQuery" @onkeyup="BuscarEnter" placeholder="Buscar por paciente, doctor, cédula... (Presiona Enter)" class="block w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 sm:text-sm transition-colors shadow-sm">
            <div class="absolute inset-y-0 right-0 pr-2 flex items-center">
                <button @onclick="EjecutarBusqueda" class="p-2 text-turquesa-600 hover:text-turquesa-800 transition-colors bg-turquesa-50 rounded-md"><i class="fa-solid fa-arrow-right"></i></button>
            </div>
        </div>
    </div>
    
    @if(citasBusquedaLoading) {
        <div class="flex justify-center items-center py-12 text-turquesa-600"><i class="fa-solid fa-spinner fa-spin text-3xl"></i></div>
    } else if(busquedaRealizada && !citasBusqueda.Any()) {
        <div class="text-center py-12 text-gray-500"><i class="fa-regular fa-calendar-xmark text-4xl mb-3"></i><p>No se encontraron citas.</p></div>
    } else if(citasBusqueda.Any()) {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 text-gray-700 border-b border-gray-200">
                    <tr><th class="px-6 py-4 font-semibold text-sm">Fecha/Hora</th><th class="px-6 py-4 font-semibold text-sm">Paciente</th><th class="px-6 py-4 font-semibold text-sm">Especialidad</th><th class="px-6 py-4 font-semibold text-sm">Estado</th></tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach(var c in citasBusqueda) {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 text-sm font-medium text-gray-700">@c.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-6 py-4 text-sm font-medium text-gray-700">@(c.Derivacion?.Paciente?.NombreCompleto ?? "")<LaboratorioFront.Pages.Componentes.BadgeTipoPaciente Tipo="@c.Derivacion?.TipoPaciente" Origen="@c.Derivacion?.Origen" /> <br><span class="text-xs text-gray-500">@(c.Derivacion?.Paciente?.Cedula ?? "")</span>
                                @if (EsEcoCita(c.Derivacion?.EspecialidadRequerida)) { <br><span class="inline-block mt-1 px-2 py-0.5 bg-purple-100 text-purple-700 rounded-md text-xs font-bold border border-purple-200">Ecocardiograma</span> }
                                        @if (EsActivadoCaja(c.Derivacion?.Observaciones)) { <br><span class="inline-block mt-1 px-2 py-0.5 bg-green-100 text-green-700 rounded-md text-xs font-bold border border-green-200" title="Paciente activado en Caja: ya esta presente, atender ahora">Activado en Caja</span> }</td>
                            <td class="px-6 py-4 text-sm font-medium text-gray-700">@(c.Derivacion?.EspecialidadRequerida ?? "")</td>
                            <td class="px-6 py-4 text-sm">
                                @if(c.Estado == "Pendiente") { <span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-xs font-bold">Pendiente</span> }
                                else if(c.Estado == "Atendido") { <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs font-bold">Atendido</span> }
                                else { <span class="bg-gray-100 text-gray-800 px-3 py-1 rounded-full text-xs font-bold">@c.Estado</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
    </main>
</div>


@if (mostrarAgendar)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-4xl overflow-hidden flex flex-col my-auto">
            <div class="p-6 bg-turquesa-50 border-b border-turquesa-100 flex justify-between items-center shrink-0">
                <h3 class="text-xl font-bold text-turquesa-900 m-0"><i class="fa-solid fa-calendar-check mr-2"></i> Agendar Cita Subsecuente</h3>
                <button @onclick="() => mostrarAgendar = false" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-times text-xl"></i></button>
            </div>
            
            <div class="p-6 overflow-y-auto flex flex-col gap-6">
                
                <div class="flex justify-between items-center bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                    <button @onclick="MesAnterior" class="p-2 rounded-lg text-turquesa-600 hover:bg-turquesa-50 font-bold transition-colors"><i class="fa-solid fa-chevron-left mr-2"></i> Anterior</button>
                    <h4 class="text-xl font-bold text-gray-800 m-0 capitalize">@mesActual.ToString("MMMM yyyy")</h4>
                    <button @onclick="MesSiguiente" class="p-2 rounded-lg text-turquesa-600 hover:bg-turquesa-50 font-bold transition-colors">Siguiente <i class="fa-solid fa-chevron-right ml-2"></i></button>
                </div>

                
                <div class="flex items-center justify-center gap-6 text-sm font-medium text-gray-600">
    <div class="flex items-center gap-2"><span class="w-4 h-4 rounded-full" style="background-color: #dcfce7;"></span> Amplia Disponibilidad</div>
    <div class="flex items-center gap-2"><span class="w-4 h-4 rounded-full" style="background-color: #fef08a;"></span> Capacidad Media</div>
    <div class="flex items-center gap-2"><span class="w-4 h-4 rounded-full" style="background-color: #fecaca;"></span> Capacidad Llena</div>
</div>

<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
    <div class="flex flex-wrap gap-3">
        @foreach (var dia in calendario)
        {
            var dt = DateTime.Parse(dia.Fecha);
            var isSelected = diaSeleccionado?.Fecha == dia.Fecha;
            var isToday = dt.Date == DateTime.Today;
            var isPast = dt.Date < DateTime.Today;
            var isValidoParaCita = !isPast;
            var opacity = isPast ? "opacity-50 cursor-not-allowed" : "cursor-pointer hover:shadow-md";
            var ring = isSelected ? "ring-2 ring-turquesa-500 shadow-md" : "border border-gray-200";
            
            <div @onclick="() => isValidoParaCita ? SeleccionarDia(dia) : null" class="w-24 h-24 rounded-lg p-2 relative flex flex-col transition-all @opacity @ring" style="background-color: @(isSelected ? "#e6fffa" : GetColorTailwind(dia.Color));">
                <div class="text-center">
                    <div class="text-xs font-semibold text-gray-500 uppercase">@dt.ToString("ddd", new System.Globalization.CultureInfo("es-ES"))</div>
                    <div class="text-xl font-bold @(isToday ? "text-turquesa-600" : "text-gray-800")">@dt.ToString("dd/MM")</div>
                </div>
                
                @if(dia.TotalSlots > 0 && isValidoParaCita)
                {
                    <div class="mt-auto text-[10px] font-medium text-gray-600 text-center leading-tight bg-white/80 rounded px-1">
                        Disp: @(dia.TotalSlots - dia.Citas < 0 ? $"Lleno (+{dia.Citas - dia.TotalSlots})" : $"{(dia.TotalSlots - dia.Citas)}/{dia.TotalSlots}")
                    </div>
                }
            </div>
        }
        @if(calendario.Count == 0)
        {
            <div class="w-full text-center p-8 text-gray-400 font-medium">No hay dias de atencion disponibles.</div>
        }
    </div>
</div>

@if (diaSeleccionado != null && slotsDisponibles != null)
                {
                    <div class="bg-gray-50 p-5 rounded-xl border border-gray-200">
                        <h4 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2"><i class="fa-regular fa-clock text-turquesa-500"></i> Horarios Disponibles para el @DateTime.Parse(diaSeleccionado.Fecha).ToString("dd/MM/yyyy")</h4>
                        
                        <div class="flex flex-wrap gap-2">
                            @if(slotsDisponibles.Count == 0)
                            {
                                <div class="w-full p-3 bg-red-50 text-red-600 rounded-lg text-sm font-medium border border-red-100 flex items-center gap-2">
                                    <i class="fa-solid fa-circle-exclamation"></i> No hay turnos disponibles para este dia.
                                </div>
                            }
                            @foreach(var slot in slotsDisponibles)
                            {
                                <button @onclick="() => slotSeleccionado = slot" class="px-5 py-2.5 rounded-xl text-sm font-bold transition-all border @(slotSeleccionado == slot ? "bg-turquesa-500 text-white border-turquesa-600 shadow-md transform scale-105" : "bg-white text-gray-700 border-gray-300 hover:border-turquesa-400 hover:bg-turquesa-50 hover:shadow-sm")">
                                    @slot
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            
                        <div class="mt-4 p-4 bg-yellow-50 rounded-lg border border-yellow-200">
                <label class="block text-sm font-bold text-yellow-800 mb-2"><i class="fa-solid fa-clipboard-list mr-1"></i> Requisitos Previos a la Cita (Opcional)</label>
                <p class="text-xs text-yellow-700 mb-2">Escribe los procedimientos que el paciente debe realizarse antes de venir. Separados por comas (ej: EKG, Examen de Sangre).</p>
                <input type="text" @bind="nuevosRequisitos" class="w-full p-2 rounded border border-yellow-300 focus:ring-yellow-500 focus:border-yellow-500 bg-white" placeholder="Ej: EKG, Rayos X Tórax..." />
            </div>
            
            <div class="p-6 bg-gray-50 border-t border-gray-200 flex justify-end gap-3 shrink-0">
                <button @onclick="() => mostrarAgendar = false" class="px-5 py-2.5 rounded-xl font-medium text-gray-600 hover:bg-gray-200 transition-colors">Cancelar</button>
                <button @onclick="ConfirmarSubsecuente" disabled="@(string.IsNullOrEmpty(slotSeleccionado))" class="px-5 py-2.5 rounded-xl font-medium text-white transition-all shadow-md @(!string.IsNullOrEmpty(slotSeleccionado) ? "bg-turquesa-600 hover:bg-turquesa-700" : "bg-gray-400 cursor-not-allowed")">
                    <i class="fa-solid fa-check mr-2"></i> Confirmar Cita
                </button>
            </div>
        </div>
    </div>
}

@code {
    private void SetTab(string tab) { activeTab = tab; }
