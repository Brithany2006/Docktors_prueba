    private async Task BuscarEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await EjecutarBusqueda(); }
    private async Task EjecutarBusqueda() {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        citasBusquedaLoading = true;
        busquedaRealizada = true;
        try { citasBusqueda = await Service.BuscarCitasAsync(searchQuery, sedes.Count > 1 ? sedeActual : null); }
        catch { }
        finally { citasBusquedaLoading = false; }
    }

    private string busquedaEnCurso = string.Empty;

    private static string SinTildes(string? s) =>
        (s ?? string.Empty).ToLowerInvariant().Replace('á', 'a').Replace('é', 'e').Replace('í', 'i').Replace('ó', 'o').Replace('ú', 'u').Replace('ü', 'u').Replace('ñ', 'n');

    private List<DerivacionesService.CitaDerivacionResponse> EnCursoFiltrados
    {
        get
        {
            var q = SinTildes(busquedaEnCurso).Trim();
            if (q.Length == 0) return EnCursoVigentes;
            var terminos = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return EnCursoVigentes.Where(c =>
            {
                var texto = SinTildes(c.Derivacion?.Paciente?.NombreCompleto) + " " + (c.Derivacion?.Paciente?.Cedula ?? string.Empty);
                return terminos.All(texto.Contains);
            }).ToList();
        }
    }

    // "En curso" = el paciente no confirmo por WhatsApp. Misma regla de caducidad que CitasCleanupWorker:
    // pasa a No Asistio al terminar su dia (22:30), asi que desde entonces ya no se muestra.
    private List<DerivacionesService.CitaDerivacionResponse> EnCursoVigentes =>
        citas?.Where(c => c.Estado == "En curso" && c.Activo &&
                          (c.FechaHora.Date > DateTime.Today || (c.FechaHora.Date == DateTime.Today && DateTime.Now.TimeOfDay < new TimeSpan(22, 30, 0))))
              .OrderBy(c => c.FechaHora).ToList() ?? new();

    private DateTime? fechaFiltro = DateTime.Today;
    private List<DerivacionesService.CitaDerivacionResponse> CitasFiltradas =>
        citas?.Where(c => !fechaFiltro.HasValue || c.FechaHora.Date == fechaFiltro.Value.Date).ToList() ?? new();

    private List<DerivacionesService.CitaDerivacionResponse>? citas;
    private int idDoctor = 0;
    private int idUsuario = 0;
    private string nombreUsuarioActual = "";

    private bool mostrarAgendar = false;
    private DateTime mesActual = DateTime.Today;
    private List<DerivacionesService.CapacidadDia> calendario = new();
    
    // Arrays para pintar cajitas vacias del calendario
    private int[] paddingDays = Array.Empty<int>();
    private int[] trailingDays = Array.Empty<int>();
    
    private DerivacionesService.CapacidadDia? diaSeleccionado;
    // Paciente de ecocardiograma (sale de la especialidad de la derivacion, venga del Excel o de un registro manual)
    private static bool EsEcoCita(string? especialidad) => (especialidad ?? "").IndexOf("ECOCARDIO", StringComparison.OrdinalIgnoreCase) >= 0;

    // Paciente que no confirmo por WhatsApp y Caja activo con una cita manual (la derivacion lo trae anotado)
    private static bool EsActivadoCaja(string? observaciones) => (observaciones ?? "").IndexOf("Activado en Caja", StringComparison.OrdinalIgnoreCase) >= 0;

    private List<string>? slotsDisponibles;
    private string? slotSeleccionado;
    private string nuevosRequisitos = "";    private bool requiereEkg = false;
    private int idEkgDoctor = 0;
    private DateTime mesActualEkg = DateTime.Today;
    private System.Collections.Generic.List<DerivacionesService.CapacidadDia> calendarioEkg = new();
    private DerivacionesService.CapacidadDia? diaSeleccionadoEkg;
    private System.Collections.Generic.List<string>? slotsDisponiblesEkg;
    private string? slotSeleccionadoEkg;

    private async Task CargarCalendarioEkg() { if (idEkgDoctor > 0) calendarioEkg = await Service.GetCalendarioDoctorAsync(idEkgDoctor, mesActualEkg.Year, mesActualEkg.Month); }
    private async Task MesAnteriorEkg() { mesActualEkg = mesActualEkg.AddMonths(-1); await CargarCalendarioEkg(); }
    private async Task MesSiguienteEkg() { mesActualEkg = mesActualEkg.AddMonths(1); await CargarCalendarioEkg(); }
    private async Task SeleccionarDiaEkg(DerivacionesService.CapacidadDia dia) { diaSeleccionadoEkg = dia; slotSeleccionadoEkg = null; slotsDisponiblesEkg = await Service.GetAvailableSlotsAsync(idEkgDoctor, DateTime.Parse(dia.Fecha)); }
    private DerivacionesService.CitaDerivacionResponse? citaBase;

    protected override async Task OnInitializedAsync()
    {
        var token = await Tokens.GetAsync();
        if (!string.IsNullOrEmpty(token))
        {
            var payload = token.Split('.')[1];
            switch (payload.Length % 4) { case 2: payload += "=="; break; case 3: payload += "="; break; }
            var bytes = Convert.FromBase64String(payload);
            var payloadJson = System.Text.Json.JsonSerializer.Deserialize<System.Collections.Generic.Dictionary<string, object>>(bytes);
            var idClaim = payloadJson?.FirstOrDefault(x => x.Key == "IdUsuario").Value?.ToString();
            var nameClaim = payloadJson?.FirstOrDefault(x => x.Key == "Nombre").Value?.ToString();
            nombreUsuarioActual = nameClaim ?? "";
            
            if (int.TryParse(idClaim, out idUsuario))
            {
                await CargarCitas();
            }
        }
    }

    // Un usuario con ficha de doctor en dos sedes elige cual ve; con una sola sede no cambia nada
    private List<string> sedes = new();
    private string sedeActual = string.Empty;

    private async Task CargarCitas(string? sede = null)
    {
        var dto = await Service.GetCitasDeDoctorAsync(idUsuario, sede ?? (sedeActual.Length > 0 ? sedeActual : null));
        if (dto != null)
        {
            idDoctor = dto.DoctorId;
            citas = dto.Citas;
            sedes = dto.Sucursales ?? new();
            sedeActual = dto.Sucursal ?? string.Empty;
        }
    }

    private async Task CambiarSede(string sede)
    {
        if (sede == sedeActual) return;
        citas = null;
        citasBusqueda = new();
        busquedaRealizada = false;
        StateHasChanged();
        await CargarCitas(sede);
    }

        private async Task MarcarAtendido(DerivacionesService.CitaDerivacionResponse c)
    {
        string mensajeAtendido = c.Estado == "En curso"
            ? "Este paciente NO confirmó la cita por WhatsApp. ¿Confirmas que asistió y quieres marcarlo como ATENDIDO?"
            : "¿Está seguro que desea marcar esta cita como ATENDIDO?";
        bool confirmed = await JS.InvokeAsync<bool>("confirm", mensajeAtendido);
        if (confirmed)
        {
            var res = await Service.MarcarAtendidoAsync(c.Id);
            if (res)
            {
                c.Estado = "Atendido";
                StateHasChanged();
            }
        }
    }

    private async Task AbrirAgendar(DerivacionesService.CitaDerivacionResponse c)
    {
        citaBase = c;
        mesActual = DateTime.Today;
        await CargarCalendario();
        
        var sugerido = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
        diaSeleccionado = calendario.FirstOrDefault(d => d.Fecha == sugerido);
        if (diaSeleccionado != null) await SeleccionarDia(diaSeleccionado);
        
        mostrarAgendar = true;
    }

    private async Task CargarCalendario()
    {
        calendario = await Service.GetCalendarioDoctorAsync(idDoctor, mesActual.Year, mesActual.Month);
        
        // Calcular celdas vacias al principio y final
        var primerDia = new DateTime(mesActual.Year, mesActual.Month, 1);
        var ultimoDia = primerDia.AddMonths(1).AddDays(-1);
        
        int offsetSemana = (int)primerDia.DayOfWeek;
        if (offsetSemana == 0) offsetSemana = 7; // Domingo
        
        paddingDays = new int[offsetSemana - 1];
        
        int offsetFinal = (int)ultimoDia.DayOfWeek;
        if (offsetFinal == 0) offsetFinal = 7;
        
        trailingDays = new int[7 - offsetFinal];
    }

    private async Task MesAnterior() { mesActual = mesActual.AddMonths(-1); await CargarCalendario(); }
    private async Task MesSiguiente() { if (mesActual < new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(3)) { mesActual = mesActual.AddMonths(1); await CargarCalendario(); } }

    private async Task SeleccionarDia(DerivacionesService.CapacidadDia dia)
    {
        diaSeleccionado = dia;
        slotSeleccionado = null;
        slotsDisponibles = await Service.GetAvailableSlotsAsync(idDoctor, DateTime.Parse(dia.Fecha));
    }

        private bool TieneSubsecuenteAgendada(DerivacionesService.CitaDerivacionResponse citaBase)
    {
        if (citaBase.Derivacion?.Citas != null)
        {
            return citaBase.Derivacion.Citas.Any(c => c != null && c.EsSubsecuente);
        }
        return false;
    }

    private async Task ConfirmarSubsecuente()
    {
        if (citaBase != null && diaSeleccionado != null && slotSeleccionado != null)
        {
            var span = TimeSpan.Parse(slotSeleccionado);
            var dateTime = DateTime.Parse(diaSeleccionado.Fecha).Add(span);
            var conflicto = await Service.VerificarConflictoHorarioAsync(idDoctor, dateTime, null, null, citaBase.Derivacion?.Paciente?.Cedula);
            if (conflicto.HayConflicto)
            {
                bool continuar = await JS.InvokeAsync<bool>("confirm", conflicto.Mensaje);
                if (!continuar) return;
            }
            
                        var nueva = new DerivacionesService.CitaDerivacion
            {
                IdDerivacion = citaBase.IdDerivacion,
                IdDoctor = idDoctor,
                FechaHora = dateTime,
                EsSubsecuente = true,
                Requisitos = new List<DerivacionesService.RequisitoCita>()
            };

            if (!string.IsNullOrWhiteSpace(nuevosRequisitos))
            {
                var reqs = nuevosRequisitos.Split(',', StringSplitOptions.RemoveEmptyEntries);
                foreach(var r in reqs)
                {
                    nueva.Requisitos.Add(new DerivacionesService.RequisitoCita { Descripcion = r.Trim(), Realizado = false });
                }
            }
            
            var result = await Service.AgendarCitaAsync(nueva);
            if (result.Exito)
            {
                mostrarAgendar = false;
                await CargarCitas();
                await JS.InvokeVoidAsync("alert", "Cita agendada correctamente.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", result.Mensaje);
            }
        }
    }

