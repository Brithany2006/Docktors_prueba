@page "/dashboard-admin-centro"
@using LaboratorioFront.Services

@inject DerivacionesService Service
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LaboratorioFront.Services.ApiService Api

@if (sesionOk == true)
{
<div class="flex h-screen bg-gray-50 font-sans">
    <aside class="w-64 bg-white border-r border-gray-100 flex flex-col shadow-sm z-10 hidden md:flex">
        <div class="p-6 border-b border-gray-100">
            <h1 class="text-2xl font-black text-gray-800 tracking-tight">Klinic<span class="text-turquesa-500">.</span></h1>
            <p class="text-xs font-semibold text-gray-400 mt-1 uppercase tracking-wider">Centro de Especialidades</p>
        </div>

        <div class="flex-grow p-4 overflow-y-auto">
    <div class="space-y-1 mb-8">
        <p class="px-4 text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Panel de Control</p>
        <button class="w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all @(activeTab == "metricas" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-50")" @onclick="@(() => SetTab("metricas"))">
            <i class="fa-solid fa-table w-5 text-center @(activeTab == "metricas" ? "text-turquesa-600" : "")"></i> Tabla de Métricas
        </button>
        <button class="w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all @(activeTab == "resumen" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-50")" @onclick="@(() => SetTab("resumen"))">
            <i class="fa-solid fa-chart-pie w-5 text-center @(activeTab == "resumen" ? "text-turquesa-600" : "")"></i> Resumen del Día
        </button>
        
        <button class="w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all @(activeTab == "horarios" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-50")" @onclick="@(() => SetTab("horarios"))">
            <i class="fa-solid fa-clock w-5 text-center @(activeTab == "horarios" ? "text-turquesa-600" : "")"></i> Horarios Doctores
        </button>
        <button class="w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all @(activeTab == "creardoctor" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-50")" @onclick="@(() => SetTab("creardoctor"))">
            <i class="fa-solid fa-user-doctor w-5 text-center @(activeTab == "creardoctor" ? "text-turquesa-600" : "")"></i> Crear Doctor
        </button>
    </div>
</div>

<div class="p-4 border-t border-gray-100">
    <button class="w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-red-600 hover:bg-red-50 rounded-xl transition-colors" @onclick="Salir">
        <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i> Salir
    </button>
</div>
</aside>

<main class="flex-grow p-4 md:p-8 overflow-y-auto">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">Dashboard Administrador</h1>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 @(activeTab == "metricas" || activeTab == "resumen" ? "uppercase" : "")">
            @if (activeTab == "metricas")
            {
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Tabla de Derivaciones</h2>
                <div class="mb-6 flex flex-wrap gap-4 items-end">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Fecha Inicio:</label>
                        <input type="date" @bind="fechaInicio" @bind:after="CargarMetricasRango" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Fecha Fin:</label>
                        <input type="date" @bind="fechaFin" @bind:after="CargarMetricasRango" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" />
                    </div>
                    <button @onclick="ExportarExcelMetricas" disabled="@(exportando || metricas == null)" title="Descarga la tabla del día o del rango seleccionado, con resumen por especialidad, por día y detalle de pacientes" class="ml-auto px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg shadow-sm disabled:opacity-50 transition-colors flex items-center gap-2">
                        @if (exportando) { <i class="fa-solid fa-circle-notch fa-spin"></i> <span>Generando...</span> }
                        else { <i class="fa-solid fa-file-excel"></i> <span>Exportar a Excel</span> }
                    </button>
                </div>

                @if (metricas == null)
                {
                    <div class="flex justify-center p-12">
                        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-turquesa-600"></div>
                    </div>
                }
                else
                {
                    var filasMetricas = FilasMetricas;
                    var totCap = filasMetricas.Sum(d => d.Capacidad);
                    var totAgen = filasMetricas.Sum(d => d.Agendadas);
                    var totAte = filasMetricas.Sum(d => d.Atendidos);
                    var totNoAs = filasMetricas.Sum(d => d.NoAsistio);
                    var totPend = filasMetricas.Sum(d => d.Pendientes);
                    var totNoConf = filasMetricas.Sum(d => d.NoConfirmaron);
                    var totExtra = filasMetricas.Sum(d => d.TurnosExtra);
                    var totLibres = filasMetricas.Sum(d => d.CuposLibres);
                    var totNoAsConf = filasMetricas.Sum(d => d.NoAsistioConfirmadas);
                    double? ocupacionTotal = totCap > 0 ? Math.Round((double)totAgen / totCap * 100, 1) : (double?)null;
                    double? asistenciaTotal = (totAte + totNoAs) > 0 ? Math.Round((double)totAte / (totAte + totNoAs) * 100, 1) : (double?)null;

                    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3 mb-6">
                        <div class="rounded-xl border border-gray-100 bg-gray-50 p-4" title="Turnos disponibles según el horario de los doctores (sin días libres ni feriados)">
                            <p class="text-xs font-bold text-gray-500">Capacidad total</p>
                            <p class="text-2xl font-extrabold text-blue-600">@totCap</p>
                        </div>
                        <div class="rounded-xl border border-gray-100 bg-gray-50 p-4" title="Atendidas + No asistidas + Pendientes">
                            <p class="text-xs font-bold text-gray-500">Agendadas</p>
                            <p class="text-2xl font-extrabold text-turquesa-600">@totAgen</p>
                        </div>
                        <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                            <p class="text-xs font-bold text-gray-500">Atendidas</p>
                            <p class="text-2xl font-extrabold text-green-600">@totAte</p>
                        </div>
                        <div class="rounded-xl border border-gray-100 bg-gray-50 p-4" title="Agendadas / Capacidad total">
                            <p class="text-xs font-bold text-gray-500">% Ocupación</p>
                            <p class="text-2xl font-extrabold text-turquesa-600">@Pct(ocupacionTotal)</p>
                        </div>
                        <div class="rounded-xl border border-gray-100 bg-gray-50 p-4" title="Atendidas / (Atendidas + No asistidas)">
                            <p class="text-xs font-bold text-gray-500">% Asistencia</p>
                            <p class="text-2xl font-extrabold text-green-600">@Pct(asistenciaTotal)</p>
                        </div>
                        <div class="rounded-xl border border-gray-100 bg-gray-50 p-4" title="Capacidad total - Agendadas">
                            <p class="text-xs font-bold text-gray-500">Cupos libres</p>
                            <p class="text-2xl font-extrabold text-amber-600">@totLibres</p>
                        </div>
                    </div>

                    @if (totNoAs > 0)
                    {
                        <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs font-semibold text-amber-800">
                            <i class="fa-solid fa-circle-info mr-1"></i>
                            "No asistidas" incluye las citas que el doctor no marcó como atendidas (a las 19:00 el sistema las marca solo).
                            @if (totNoAsConf > 0)
                            {
                                <span>@totNoAsConf de las @totNoAs son de pacientes que habían confirmado por WhatsApp: pueden haber asistido sin que se registrara.</span>
                            }
                        </div>
                    }

                    <div class="overflow-x-auto rounded-xl border border-gray-200">
                        <table class="w-full text-sm text-left">
                            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-2 py-3">Especialidad</th>
                                    <th class="px-2 py-3">Doctor</th>
                                    <th class="px-2 py-3 text-center" title="Turnos del doctor según su horario en el rango (sin días libres ni feriados)">Capacidad Total</th>
                                    <th class="px-2 py-3 text-center">Citas Asistidas</th>
                                    <th class="px-2 py-3 text-center" title="Incluye citas que el doctor no marcó como atendidas">Citas No Asistidas</th>
                                    <th class="px-2 py-3 text-center" title="Citas confirmadas que aún no se atienden">Pendientes</th>
                                    <th class="px-2 py-3 text-center" title="Turnos asignados por el bot cuyo paciente aún no confirma (En curso)">No Confirmaron</th>
                                    <th class="px-2 py-3 text-center">Turnos Extra</th>
                                    <th class="px-2 py-3 text-center" title="Capacidad total - Agendadas">Cupos Libres</th>
                                    <th class="px-2 py-3 text-center" title="Agendadas / Capacidad total">% Ocupación</th>
                                    <th class="px-2 py-3 text-center" title="Atendidas / (Atendidas + No asistidas)">% Asistencia</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach(var doc in filasMetricas)
                                {
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-2 py-3 text-gray-800">@Etiquetas.Doctor(doc.Especialidad)</td>
                                        <td class="px-2 py-3 font-semibold text-gray-800">@Etiquetas.Doctor(doc.Doctor)</td>
                                        <td class="px-2 py-3 text-center font-bold text-blue-600">@doc.Capacidad</td>
                                        <td class="px-2 py-3 text-center font-bold text-green-600">@doc.Atendidos</td>
                                        <td class="px-2 py-3 text-center font-bold text-red-600">
                                            @doc.NoAsistio
                                            @if (doc.NoAsistioConfirmadas > 0)
                                            {
                                                <span class="block text-xs font-semibold text-amber-600" title="Pacientes que confirmaron por WhatsApp y figuran como no asistidos">@doc.NoAsistioConfirmadas con cita confirmada</span>
                                            }
                                        </td>
                                        <td class="px-2 py-3 text-center font-bold text-sky-600">@doc.Pendientes</td>
                                        <td class="px-2 py-3 text-center font-bold text-amber-600">@doc.NoConfirmaron</td>
                                        <td class="px-2 py-3 text-center font-bold text-yellow-600">@doc.TurnosExtra</td>
                                        <td class="px-2 py-3 text-center font-bold text-gray-700">@doc.CuposLibres</td>
                                        <td class="px-2 py-3 text-center font-bold @(doc.Sobrecupo ? "text-red-600 bg-red-50" : "text-turquesa-600")">
                                            @if (doc.Sobrecupo)
                                            {
                                                <i class="fa-solid fa-triangle-exclamation mr-1" title="Sobrecupo: supera el 100% de la capacidad o hay citas sin capacidad (día libre o feriado)"></i>
                                            }
                                            @(doc.Capacidad > 0 ? Pct(doc.Ocupacion) : (doc.Agendadas > 0 ? "SOBRECUPO" : "-"))
                                            <span class="block text-xs font-semibold">@doc.Agendadas/@doc.Capacidad</span>
                                        </td>
                                        <td class="px-2 py-3 text-center font-bold text-green-600">@Pct(doc.PorcAsistencia)</td>
                                    </tr>
                                }
                            </tbody>
                            @if (filasMetricas.Count > 0)
                            {
                                <tfoot class="bg-gray-100 border-t-2 border-gray-300 font-extrabold text-gray-800">
                                    <tr>
                                        <td class="px-2 py-3" colspan="2">TOTAL</td>
                                        <td class="px-2 py-3 text-center">@totCap</td>
                                        <td class="px-2 py-3 text-center">@totAte</td>
                                        <td class="px-2 py-3 text-center">@totNoAs</td>
                                        <td class="px-2 py-3 text-center">@totPend</td>
                                        <td class="px-2 py-3 text-center">@totNoConf</td>
                                        <td class="px-2 py-3 text-center">@totExtra</td>
                                        <td class="px-2 py-3 text-center">@totLibres</td>
                                        <td class="px-2 py-3 text-center">@Pct(ocupacionTotal)<span class="block text-xs font-semibold">@totAgen/@totCap</span></td>
                                        <td class="px-2 py-3 text-center">@Pct(asistenciaTotal)</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                    @if (filasMetricas.Count == 0)
                    {
                        <p class="mt-4 text-center text-gray-500 italic">Ningún doctor tiene horario laborable en la fecha seleccionada.</p>
                    }
                }
            }
            else if (activeTab == "resumen")
            {
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Resumen de Ocupación por Doctor</h2>
                <div class="mb-6 flex gap-4 items-end">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Fecha Inicio:</label>
                        <input type="date" @bind="fechaInicioResumen" @bind:after="CargarMetricasDia" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Fecha Fin:</label>
                        <input type="date" @bind="fechaFinResumen" @bind:after="CargarMetricasDia" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" />
                    </div>
                    <button class="px-6 py-2 bg-green-600 text-white font-bold rounded-lg shadow hover:bg-green-700 flex items-center gap-2" @onclick="ExportarExcel">
                        <i class="fa-solid fa-file-excel"></i> Exportar a Excel
                    </button>
                </div>

                @if (metricas == null)
                {
                    <div class="flex justify-center p-12">
                        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-turquesa-600"></div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-blue-50 border border-blue-100 p-6 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-file-medical text-blue-500 text-3xl mb-2"></i>
                            <h3 class="text-lg font-bold text-gray-700">Derivaciones Creadas</h3>
                            <p class="text-4xl font-black text-blue-600">@metricas.DerivacionesCreadas</p>
                        </div>
                        <div class="bg-green-50 border border-green-100 p-6 rounded-2xl shadow-sm text-center">
                            <i class="fa-regular fa-calendar-check text-green-500 text-3xl mb-2"></i>
                            <h3 class="text-lg font-bold text-gray-700">Citas Agendadas</h3>
                            <p class="text-4xl font-black text-green-600">@metricas.CitasAgendadas</p>
                            <p class="text-xs font-semibold text-gray-500 mt-1">Confirmadas · Creadas: @metricas.CitasCreadas</p>
                        </div>
                    </div>

                    <h3 class="text-xl font-bold text-gray-800 mb-4">Porcentaje de Ocupación por Doctor</h3>
                    <div class="flex flex-wrap gap-6 mb-8">
                        @foreach (var doc in metricas.ActividadDoctores.Where(d => d.Ocupacion > 0 || d.Sobrecupo).OrderByDescending(d => d.Sobrecupo).ThenByDescending(d => d.Ocupacion))
                        {
                            <div class="bg-white border @(doc.Sobrecupo ? "border-red-300" : "border-gray-200") p-4 rounded-xl shadow-sm flex items-center gap-4 w-64">
                                <div class="relative w-16 h-16">
                                    <svg viewBox="0 0 36 36" class="w-16 h-16">
                                        <path class="text-gray-200" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3"/>
                                        <path class="@(doc.Sobrecupo ? "text-red-500" : "text-turquesa-500")" stroke-dasharray="@((doc.Sobrecupo ? 100 : doc.Ocupacion).ToString(System.Globalization.CultureInfo.InvariantCulture)), 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3"/>
                                    </svg>
                                    <div class="absolute inset-0 flex items-center justify-center text-xs font-bold @(doc.Sobrecupo ? "text-red-600" : "")">@Math.Round(doc.Ocupacion, 1)%</div>
                                </div>
                                <div>
                                    <p class="font-bold text-sm text-gray-800">@Etiquetas.Doctor(doc.Doctor)</p>
                                    <p class="text-xs text-gray-500">@Etiquetas.Doctor(doc.Especialidad)</p>
                                    <p class="text-xs font-semibold @(doc.Sobrecupo ? "text-red-600" : "text-gray-600")">
                                        @if (doc.Sobrecupo)
                                        {
                                            <i class="fa-solid fa-triangle-exclamation mr-1" title="Sobrecupo: supera el 100% de la capacidad"></i>
                                        }
                                        @doc.Agendadas/@doc.Capacidad
                                    </p>
                                </div>
                            </div>
                        }
                        @if (!metricas.ActividadDoctores.Any(d => d.Ocupacion > 0 || d.Sobrecupo))
                        {
                            <p class="text-gray-500 italic">No hay doctores con citas en este rango de fechas.</p>
                        }
                    </div>
                }
            }
            else if (activeTab == "papelera")
            {
                <h2 class="text-2xl font-bold text-gray-800 mb-6"><i class="fa-solid fa-trash text-red-500 mr-2"></i> Papelera de Reciclaje</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-red-50 p-6 rounded-xl border border-red-100">
                        <h4 class="text-lg font-bold text-red-800 mb-4">Derivaciones Borradas</h4>
                        @if (derivacionesBorradas == null)
                        {
                            <p class="text-gray-500">Cargando...</p>
                        }
                        else if (!derivacionesBorradas.Any())
                        {
                            <p class="text-gray-500">No hay derivaciones borradas.</p>
                        }
                        else
                        {
                            <ul class="space-y-2">
                            @foreach (var d in derivacionesBorradas)
                            {
                                <li class="bg-white p-3 rounded shadow-sm text-sm">
                                    <strong>Paciente:</strong> @(d.Paciente?.NombreCompleto)<br/>
                                    <strong>Especialidad:</strong> @d.EspecialidadRequerida<br/>
                                    <strong>Fecha:</strong> @d.FechaEmision.ToShortDateString()
                                </li>
                            }
                            </ul>
                        }
                    </div>

                    <div class="bg-red-50 p-6 rounded-xl border border-red-100">
                        <h4 class="text-lg font-bold text-red-800 mb-4">Citas Borradas</h4>
                        @if (citasBorradas == null)
                        {
                            <p class="text-gray-500">Cargando...</p>
                        }
                        else if (!citasBorradas.Any())
                        {
                            <p class="text-gray-500">No hay citas borradas.</p>
                        }
                        else
                        {
                            <ul class="space-y-2">
                            @foreach (var c in citasBorradas)
                            {
                                <li class="bg-white p-3 rounded shadow-sm text-sm">
                                    <strong>Paciente:</strong> @(c.Derivacion?.Paciente?.NombreCompleto)<br/>
                                    <strong>Doctor:</strong> @(c.Doctor?.Nombre)<br/>
                                    <strong>Fecha:</strong> @c.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                </li>
                            }
                            </ul>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "horarios")
            {
                <LaboratorioFront.Shared.HorarioDoctoresTab currentSucursal="@currentSucursal" />
            }
            else if (activeTab == "creardoctor")
            {
                <LaboratorioFront.Shared.CrearDoctorTab currentSucursal="@currentSucursal" sucursalFija="true" />
            }

        </div>
    </main>
</div>
}

@code {
    private string currentSucursal = "Centro";
    private async Task CambiarSucursal(string suc) { currentSucursal = suc; if (activeTab == "metricas") await CargarMetricasRango(); else if (activeTab == "resumen") await CargarMetricasDia(); else if (activeTab == "papelera") await CargarPapelera(); }
    private string activeTab = "metricas";
    private DateTime fechaInicio = DateTime.Today;
    private DateTime fechaFin = DateTime.Today;
    private DateTime fechaInicioResumen = DateTime.Today;
    private DateTime fechaFinResumen = DateTime.Today;
    private DerivacionesService.MetricasResponse? metricas;
    private bool exportando = false;

    // Filas de la tabla de metricas: doctores con turnos o citas en el rango, ordenados por especialidad y doctor
    private List<DerivacionesService.ActividadDoctor> FilasMetricas =>
        metricas?.ActividadDoctores.Where(d => d.TrabajaEnRango).OrderBy(d => d.Especialidad).ThenBy(d => d.Doctor).ToList() ?? new();

    private static string Pct(double? valor) => valor.HasValue ? valor.Value.ToString("0.#") + " %" : "-";

    private List<LaboratorioFront.Services.Derivacion>? derivacionesBorradas;
    private List<LaboratorioFront.Services.DerivacionesService.CitaDerivacionResponse>? citasBorradas;

    private void SetTab(string tab)
    {
        activeTab = tab;
        if (tab == "metricas") _ = CargarMetricasRango();
        else if (tab == "resumen") _ = CargarMetricasDia();
        else if (tab == "papelera") _ = CargarPapelera();
        else if (tab == "horarios") StateHasChanged();
    }

    // null = verificando; true = sesion valida de administrador; false = redirigido al login
    private bool? sesionOk;

    protected override async Task OnInitializedAsync()
    {
        string? token = null;
        try { token = await JS.InvokeAsync<string>("laboratorio.getToken"); } catch { }

        var sesion = SesionJwt.Leer(token);
        if (!sesion.Valida || (sesion.Rol != "Admin" && sesion.Rol != "AdminCentro"))
        {
            sesionOk = false;
            if (!sesion.Valida && !string.IsNullOrEmpty(token))
            {
                try { await JS.InvokeVoidAsync("laboratorio.setToken", (string?)null); } catch { }
                Api.SetToken(null);
            }
            Nav.NavigateTo("/login", true);
            return;
        }

        sesionOk = true;
        currentSucursal = (sesion.Ruc == "milan" || sesion.Ruc == "adminmilan") ? "Milan" : "Centro";
        await CargarMetricasRango();
    }

    // La API es la que decide; si responde 401/403 la sesion ya no sirve y se vuelve al login.
    private async Task<DerivacionesService.MetricasResponse?> PedirMetricas(DateTime desde, DateTime hasta)
    {
        try
        {
            return await Service.GetMetricasRangoAsync(desde, hasta, currentSucursal);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized || ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            Nav.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando metricas: " + ex.Message);
        }
        return new DerivacionesService.MetricasResponse();
    }

    private async Task CargarMetricasRango()
    {
        metricas = null;
        StateHasChanged();
        metricas = await PedirMetricas(fechaInicio, fechaFin);
        StateHasChanged();
    }

    private async Task CargarMetricasDia()
    {
        metricas = null;
        StateHasChanged();
        metricas = await PedirMetricas(fechaInicioResumen, fechaFinResumen);
        StateHasChanged();
    }

    private async Task ExportarExcel() => await DescargarExcel(fechaInicioResumen, fechaFinResumen, "Resumen");

    private async Task ExportarExcelMetricas()
    {
        exportando = true;
        StateHasChanged();
        try { await DescargarExcel(fechaInicio, fechaFin, $"Metricas_{currentSucursal}"); }
        finally { exportando = false; StateHasChanged(); }
    }

    // Descarga el Excel de metricas del rango; el servidor usa el mismo calculo que la tabla de la pantalla
    private async Task DescargarExcel(DateTime desde, DateTime hasta, string prefijo)
    {
        var url = $"api/derivaciones/metricas/excel?fechaInicio={desde:yyyy-MM-dd}&fechaFin={hasta:yyyy-MM-dd}&sucursal={currentSucursal}";
        try
        {
            var response = await Api.Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var contentBytes = await response.Content.ReadAsByteArrayAsync();
                var b64 = Convert.ToBase64String(contentBytes);
                var fileName = $"{prefijo}_{desde:yyyyMMdd}_{hasta:yyyyMMdd}.xlsx";
                await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Error al generar el Excel.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
    }

    private async Task CargarPapelera()
    {
        derivacionesBorradas = await Service.GetDerivacionesBorradasAsync(currentSucursal);
        citasBorradas = await Service.GetCitasBorradasAsync(currentSucursal);
        StateHasChanged();
    }

    private async Task Salir()
    {
        await JS.InvokeVoidAsync("laboratorio.setToken", (string?)null);
        Api.SetToken(null);
        Nav.NavigateTo("/login");
    }
}




