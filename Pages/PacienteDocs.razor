@page "/paciente/{NombrePaciente}"
@using LaboratorioFront.Services
@using static LaboratorioFront.Services.ApiService
@inject ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>Documentos del paciente | Centro Médico Klinic</PageTitle>

<div class="paciente-detalle">
    <div class="page-title">
        <h3>Resultados de @NombrePaciente</h3>
        <span class="badge">@docs.Count</span>
    </div>

    <div class="toolbar">
        <button class="btn-volver" @onclick="Volver">← Volver</button>
    </div>

    @if (loading)
    {
        <p>Cargando...</p>
    }
    else
    {
        @* ==== TABS ==== *@
        <div class="paciente-tabs">
            <button type="button"
                    class="paciente-tab-btn @(tabActual == TabActual.Lab ? "active" : "")"
                    @onclick="() => CambiarTab(TabActual.Lab)">
                Laboratorio
            </button>

            <button type="button"
                    class="paciente-tab-btn @(tabActual == TabActual.Rx ? "active" : "")"
                    @onclick="() => CambiarTab(TabActual.Rx)">
                RX
            </button>

            <button type="button"
                    class="paciente-tab-btn @(tabActual == TabActual.Eco ? "active" : "")"
                    @onclick="() => CambiarTab(TabActual.Eco)">
                Ecografias
            </button>
        </div>

        @* ================= LABORATORIO ================= *@
        @if (tabActual == TabActual.Lab)
        {
            @if (!docs.Any())
            {
                <p>No hay resultados de laboratorio para este paciente.</p>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Archivo</th>
                                <th class="col-acciones">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (doc, idx) in docs.Select((d, i) => (d, i + 1)))
                            {
                                <tr>
                                    <td>@idx</td>
                                    <td>@doc.NombreArchivo</td>
                                    <td class="col-acciones">
                                        <button class="btn btn-primary" @onclick="() => Abrir(doc.NombreArchivo)">
                                            Ver PDF
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        @* ================= RX (UNA SOLA PESTANA) ================= *@
        @if (tabActual == TabActual.Rx)
        {
            <h5>Resultados RX</h5>

            @if (rxLoading && !rxInformesCargados && !rxImagenesCargados)
            {
                <p>Cargando RX...</p>
            }
            else if (!rxInformes.Any() && !rxImagenes.Any())
            {
                <p>No hay estudios RX para este paciente.</p>
            }
            else
            {
                <div class="mb-3">
                    <h6>Informes</h6>
                    @if (!rxInformes.Any())
                    {
                        <p class="text-muted">No hay informes RX para este paciente.</p>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Archivo</th>
                                        <th>Fuente</th>
                                        <th class="col-acciones">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (inf, idx) in rxInformes.Select((d, i) => (d, i + 1)))
                                    {
                                        <tr>
                                            <td>@idx</td>
                                            <td>@inf.NombreArchivo</td>
                                            <td>@inf.Fuente</td>
                                            <td class="col-acciones">
                                                <a class="btn btn-primary"
                                                   href="@GetRxFileUrl(inf)"
                                                   target="_blank"
                                                   rel="noopener noreferrer">
                                                    Ver PDF
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div>
                    <h6>Imagenes</h6>
                    @if (!rxImagenes.Any())
                    {
                        <p class="text-muted">No hay imagenes RX para este paciente.</p>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var img in rxImagenes)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="card">
                                        <a href="@GetRxFileUrl(img)" target="_blank" rel="noopener noreferrer">
                                            <img class="card-img-top"
                                                 src="@GetRxFileUrl(img)"
                                                 alt="@img.NombreArchivo" />
                                        </a>
                                        <div class="card-body p-1">
                                            <small class="text-truncate d-block" title="@img.NombreArchivo">
                                            
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

        @* ================= ECOGRAFIAS ================= *@
        @if (tabActual == TabActual.Eco)
        {
            <h5>Ecografias</h5>

            @if (ecoLoading && !ecoInformesCargados && !ecoImagenesCargados)
            {
                <p>Cargando ecografias...</p>
            }
            else
            {
                <div class="mb-3">
                    <h6>Informes</h6>
                    @if (!ecoInformes.Any())
                    {
                        <p class="text-muted">No hay informes de ecografia para este paciente.</p>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Archivo</th>
                                        <th class="col-acciones">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (inf, idx) in ecoInformes.Select((d, i) => (d, i + 1)))
                                    {
                                        <tr>
                                            <td>@idx</td>
                                            <td>@inf.NombreArchivo</td>
                                            <td class="col-acciones">
                                                <a class="btn btn-primary"
                                                   href="@GetRxFileUrl(inf)"
                                                   target="_blank"
                                                   rel="noopener noreferrer">
                                                    Ver PDF
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div>
                    <h6>Imagenes</h6>
                    @if (!ecoImagenes.Any())
                    {
                        <p class="text-muted">No hay imagenes de ecografia para este paciente.</p>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var img in ecoImagenes)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="card">
                                        <a href="@GetRxFileUrl(img)" target="_blank" rel="noopener noreferrer">
                                            <img class="card-img-top"
                                                 src="@GetRxFileUrl(img)"
                                                 alt="@img.NombreArchivo" />
                                        </a>
                                        <div class="card-body p-1">
                                            <small class="text-truncate d-block" title="@img.NombreArchivo">
                                                
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public string NombrePaciente { get; set; } = string.Empty;

    private bool loading = true;

    // LAB
    private List<PacientePdf> todos = new();
    private List<PacientePdf> docs = new();

    // RX
    private List<PacienteEstudio> rxInformes = new();
    private List<PacienteEstudio> rxImagenes = new();
    private bool rxLoading = false;
    private bool rxInformesCargados = false;
    private bool rxImagenesCargados = false;

    // ECO
    private List<PacienteEstudio> ecoInformes = new();
    private List<PacienteEstudio> ecoImagenes = new();
    private bool ecoLoading = false;
    private bool ecoInformesCargados = false;
    private bool ecoImagenesCargados = false;

    private enum TabActual
    {
        Lab,
        Rx,
        Eco
    }

    private TabActual tabActual = TabActual.Lab;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("laboratorio.getToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        Api.SetToken(token);

        // LAB
        todos = await Api.GetPacientesPorCarpetaAsync();
        docs = todos
            .Where(p => string.Equals(p.NombreCompleto?.Trim(),
                                      NombrePaciente?.Trim(),
                                      StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.NombreArchivo)
            .ToList();

        // RX
        rxLoading = true;
        try
        {
            rxInformes = await Api.GetRxInformesPorNombreAsync(NombrePaciente);
            rxImagenes = await Api.GetRxImagenesPorNombreAsync(NombrePaciente);

            rxInformesCargados = true;
            rxImagenesCargados = true;
        }
        catch
        {
            rxInformes = new();
            rxImagenes = new();
        }
        finally
        {
            rxLoading = false;
        }

        // ECO
        ecoLoading = true;
        try
        {
            ecoInformes = await Api.GetEcoInformesPorNombreAsync(NombrePaciente);
            ecoImagenes = await Api.GetEcoImagenesPorNombreAsync(NombrePaciente);

            ecoInformesCargados = true;
            ecoImagenesCargados = true;
        }
        catch
        {
            ecoInformes = new();
            ecoImagenes = new();
        }
        finally
        {
            ecoLoading = false;
        }

        loading = false;
    }

    private async Task Abrir(string nombreArchivo)
    {
        var base64 = await Api.GetPdfBase64PorNombreAsync(nombreArchivo);
        if (!string.IsNullOrEmpty(base64))
            await JS.InvokeVoidAsync("abrirPdfDesdeBase64", base64, nombreArchivo);
        else
            await JS.InvokeVoidAsync("alert", "❌ No se pudo abrir el PDF.");
    }

    private void Volver() => Nav.NavigateTo("/pacientes");

    private void CambiarTab(TabActual tab) => tabActual = tab;

    private string GetRxFileUrl(PacienteEstudio est)
        => Api.BuildPacienteEstudioFileUrl(est.Id);
}
