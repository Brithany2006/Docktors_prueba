@using LaboratorioFront.Services
@using LaboratorioFront.Services
@inject DerivacionesService Service
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 max-w-3xl mx-auto">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-4">Registrar Nueva Derivacin (Caja)</h2>
    
    <div class="mb-4 flex items-center gap-2 bg-blue-50 p-3 rounded-lg border border-blue-100">
        <input type="checkbox" id="esParticular" @bind="esParticular" class="w-5 h-5 text-turquesa-600 rounded border-gray-300 focus:ring-turquesa-500" />
        <label for="esParticular" class="text-sm font-bold text-blue-900 cursor-pointer">Es paciente particular?</label>
        <span class="text-xs text-blue-700 ml-2">(Si est marcado, no se requiere cdigo de validacin)</span>
    </div>

    <h4 class="font-bold text-turquesa-700 mb-4 flex items-center gap-2"><i class="fa-solid fa-user"></i> Datos del Paciente</h4>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">CEDULA/RUC:</label>
            <input type="text" @bind="nuevoPaciente.Cedula" @bind:event="oninput" maxlength="13" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" />
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre Completo:</label>
            <input type="text" @bind="nuevoPaciente.NombreCompleto" maxlength="60" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" />
        </div>
        <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Telfono:</label>
            <input type="text" @bind="nuevoPaciente.Telefono" maxlength="10" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" />
        </div>
    </div>

    <h4 class="font-bold text-turquesa-700 mb-4 flex items-center gap-2 mt-6 border-t pt-6"><i class="fa-solid fa-file-medical"></i> Datos de la Derivacin</h4>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Especialidad Requerida:</label>
            <select @bind="nuevaDerivacion.EspecialidadRequerida" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all">
                <option value="">-- Seleccione Especialidad --</option>
                @if (especialidades != null)
                {
                    @foreach(var esp in especialidades)
                    {
                        <option value="@esp">@esp</option>
                    }
                }
            </select>
        </div>
        

        
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Cdigo de Validacin:</label>
            <input type="text" @bind="nuevaDerivacion.CodigoValidacion" disabled="@esParticular" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all @(esParticular ? "bg-gray-100" : "")" />
        </div>
        
        <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Archivo PDF (Opcional):</label>
            <input type="file" accept="application/pdf" class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm" />
        </div>
    </div>

    <button @onclick="GuardarDerivacion" class="w-full flex items-center justify-center gap-2 bg-turquesa-500 hover:bg-turquesa-600 text-white font-bold py-3 px-4 rounded-xl shadow-md transition-all mt-4">
        <i class="fa-solid fa-save"></i> Guardar Derivacin
    </button>
</div>

@code {
    private PacienteDerivacion nuevoPaciente = new PacienteDerivacion();
    private Derivacion nuevaDerivacion = new Derivacion { FechaEmision = DateTime.Today };
    private bool esParticular = true;
    private List<string> especialidades = new();

    protected override async Task OnInitializedAsync()
    {
        especialidades = await Service.GetEspecialidadesAsync();
    }

    private async Task GuardarDerivacion()
    {
        if (string.IsNullOrWhiteSpace(nuevoPaciente.Cedula) || nuevoPaciente.Cedula.Length > 13)
        {
            await JS.InvokeVoidAsync("alert", "La cdula debe ser vlida y tener mximo 13 dgitos.");
            return;
        }
        if (string.IsNullOrWhiteSpace(nuevoPaciente.NombreCompleto))
        {
            await JS.InvokeVoidAsync("alert", "El nombre es obligatorio.");
            return;
        }
        if (string.IsNullOrWhiteSpace(nuevaDerivacion.EspecialidadRequerida))
        {
            await JS.InvokeVoidAsync("alert", "Debe seleccionar una especialidad.");
            return;
        }

        if (esParticular)
        {
            nuevaDerivacion.CodigoValidacion = "PARTICULAR";
        }
        else if (string.IsNullOrWhiteSpace(nuevaDerivacion.CodigoValidacion))
        {
            await JS.InvokeVoidAsync("alert", "El Cdigo de Validacin es obligatorio para pacientes no particulares.");
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Est seguro que desea guardar la derivacin para {nuevoPaciente.NombreCompleto}?");
        if (!confirmed) return;

        // Crear o buscar paciente
        try 
        {
            var p = await Service.CreatePacienteAsync(nuevoPaciente);
            if (p != null) nuevoPaciente = p;

            nuevaDerivacion.IdPaciente = nuevoPaciente.Id;
            var result = await Service.CreateDerivacionAsync(nuevaDerivacion);
            
            if (result != null)
            {
                await JS.InvokeVoidAsync("alert", "Derivacin guardada con xito.");
                // Reset form
                nuevoPaciente = new PacienteDerivacion();
                nuevaDerivacion = new Derivacion { FechaEmision = DateTime.Today };
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Error al guardar la derivacin.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Ocurri un error: " + ex.Message);
        }
    }
}


