@implements IDisposable
@using LaboratorioFront.Services
@inject DerivacionesService Service
@inject Microsoft.JSInterop.IJSRuntime JS

@* Citas generadas: las mismas que ve Derivaciones (Karla / Diviana). La API entrega solo las de la sede del usuario;
   aqui se buscan, se filtran, se editan, se borran y se comparten por WhatsApp. *@
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-1">Citas generadas</h2>
        <p class="text-sm text-gray-500 mb-4">Todas las citas de la sede @(Sucursal == "Milan" ? "Milán" : "Centro").</p>

        <div class="mb-4 bg-gray-50 p-3 rounded-lg border border-gray-200">
            <div class="flex items-center gap-2">
                <div class="flex-1 flex items-center bg-white p-2 rounded-lg border border-gray-200">
                    <i class="fa-solid fa-search text-gray-400 mx-3" aria-hidden="true"></i>
                    <input type="text" aria-label="Buscar por nombre, apellido o cédula" value="@busqueda" @oninput="AlEscribir" placeholder="Buscar por nombres, apellidos o cédula..." class="w-full bg-transparent outline-none text-gray-700" />
                </div>
                <button type="button" @onclick="() => mostrarFiltros = !mostrarFiltros" aria-expanded="@(mostrarFiltros ? "true" : "false")" class="px-4 py-2 bg-white border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-filter" aria-hidden="true"></i> Filtros
                </button>
            </div>
            @if (mostrarFiltros)
            {
                <div class="mt-4 pt-4 border-t border-gray-200 flex flex-col md:flex-row gap-4 items-center">
                    <div class="flex items-center gap-2">
                        <label for="cg-fecha" class="text-sm font-semibold text-gray-700">Fecha:</label>
                        <input id="cg-fecha" type="date" value="@(fecha?.ToString("yyyy-MM-dd"))" @onchange="AlCambiarFecha" class="px-3 py-2 border border-gray-300 rounded-lg outline-none" />
                    </div>
                    <div class="flex items-center gap-2">
                        <label for="cg-doctor" class="text-sm font-semibold text-gray-700">Doctor:</label>
                        <select id="cg-doctor" value="@idDoctor" @onchange="AlCambiarDoctor" class="px-3 py-2 border border-gray-300 rounded-lg outline-none max-w-xs">
                            <option value="0">Todos los doctores</option>
                            @foreach (var doc in doctoresSede)
                            {
                                <option value="@doc.Id">@doc.Nombre (@doc.Especialidad)</option>
                            }
                        </select>
                    </div>
                    <div class="flex items-center gap-2">
                        <label for="cg-tipo" class="text-sm font-semibold text-gray-700">Tipo:</label>
                        <select id="cg-tipo" value="@tipo" @onchange="AlCambiarTipo" class="px-3 py-2 border border-gray-300 rounded-lg outline-none">
                            <option value="">Todos</option>
                            <option value="iess">IESS</option>
                            <option value="particular">Particular</option>
                            <option value="antiguo">Antiguo (sin código)</option>
                            <option value="sinclasificar">Sin clasificar</option>
                        </select>
                    </div>
                    <button type="button" @onclick="Limpiar" class="px-3 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-medium transition-colors">Limpiar</button>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="mb-3 text-sm font-semibold text-red-600" role="alert">@error</p>
        }

        @if (cargando)
        {
            <div class="flex justify-center items-center py-12 text-turquesa-600" role="status" aria-label="Cargando"><i class="fa-solid fa-spinner fa-spin text-3xl" aria-hidden="true"></i></div>
        }
        else if (citas.Count == 0)
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fa-regular fa-calendar-xmark text-4xl mb-3" aria-hidden="true"></i>
                <p>No hay citas generadas.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-xl border border-gray-200">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-50 text-gray-700 border-b border-gray-200">
                        <tr>
                            <th class="px-3 py-3 font-semibold text-sm">Fecha/Hora</th>
                            <th class="px-3 py-3 font-semibold text-sm">Paciente</th>
                            <th class="px-3 py-3 font-semibold text-sm">Doctor</th>
                            <th class="px-3 py-3 font-semibold text-sm">Estado</th>
                            <th class="px-3 py-3 font-semibold text-sm text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cita in citas)
                        {
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                <td class="px-3 py-3 text-sm font-medium text-gray-800">@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-3 py-3 text-sm text-gray-600">
                                    @(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")<LaboratorioFront.Pages.Componentes.BadgeTipoPaciente Tipo="@cita.Derivacion?.TipoPaciente" Origen="@cita.Derivacion?.Origen" />
                                    @if (cita.EsSubsecuente)
                                    {
                                        <br /><span class="px-2 py-0.5 mt-1 inline-block rounded text-[10px] font-bold bg-blue-100 text-blue-800 border border-blue-200">Subsecuente</span>
                                    }
                                </td>
                                <td class="px-3 py-3 text-sm text-gray-600">@(cita.Doctor?.Nombre ?? "N/A")</td>
                                <td class="px-3 py-3">
                                    @if (cita.Estado == "Pendiente")
                                    {
                                        <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-xs font-bold border border-yellow-200">Pendiente</span>
                                    }
                                    else if (cita.Estado == "Atendido")
                                    {
                                        <span class="px-3 py-1 rounded-full bg-green-100 text-green-800 text-xs font-bold border border-green-200">Atendido</span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-xs font-bold border border-gray-200">@cita.Estado</span>
                                    }
                                </td>
                                <td class="px-3 py-3 text-center whitespace-nowrap">
                                    <div class="flex items-center justify-center gap-2">
                                        @if (cita.Derivacion != null)
                                        {
                                            <button type="button" class="bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-lg transition-colors shadow-sm" @onclick="() => citaEditar = cita" title="Editar cita" aria-label="Editar cita de @(cita.Derivacion.Paciente?.NombreCompleto)">
                                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                            </button>
                                        }
                                        <button type="button" class="bg-red-600 hover:bg-red-700 text-white p-2 rounded-lg transition-colors shadow-sm" @onclick="() => Borrar(cita.Id)" title="Borrar cita" aria-label="Borrar cita de @(cita.Derivacion?.Paciente?.NombreCompleto)">
                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="bg-green-700 hover:bg-green-800 text-white p-2 rounded-lg transition-colors shadow-sm" @onclick="() => CompartirWhatsApp(cita)" title="Compartir por WhatsApp" aria-label="Compartir por WhatsApp la cita de @(cita.Derivacion?.Paciente?.NombreCompleto)">
                                            <i class="fa-brands fa-whatsapp text-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPaginas > 1)
            {
                <div class="flex items-center justify-between mt-4 text-sm text-gray-600">
                    <span>Página @pagina de @totalPaginas (@total registros)</span>
                    <div class="flex gap-2">
                        <button type="button" disabled="@(pagina <= 1)" @onclick="Anterior" class="px-3 py-2 border border-gray-300 rounded-lg disabled:opacity-40">Anterior</button>
                        <button type="button" disabled="@(pagina >= totalPaginas)" @onclick="Siguiente" class="px-3 py-2 border border-gray-300 rounded-lg disabled:opacity-40">Siguiente</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (citaEditar?.Derivacion != null)
{
    <LaboratorioFront.Pages.Componentes.AgendarCitaModal Derivacion="citaEditar.Derivacion" CitaEditar="citaEditar" SucursalInicial="@Sucursal" OnCerrar="CerrarEdicion" OnAgendada="AlGuardar" />
}

@code {
    /// <summary>Sede del usuario de Caja ("Centro" o "Milan"). La API ya limita las citas a esa sede; aqui solo se usa para el filtro de doctores y el texto.</summary>
    [Parameter] public string Sucursal { get; set; } = "Centro";

    private const int PorPagina = 15;
    private List<DerivacionesService.CitaDerivacionResponse> citas = new();
    private List<Doctor> doctoresSede = new();
    private string busqueda = "";
    private DateTime? fecha;
    private int idDoctor;
    private string tipo = "";
    private bool mostrarFiltros;
    private string error = "";
    private bool cargando = true;
    private int pagina = 1;
    private int total;
    private int totalPaginas => total == 0 ? 1 : (int)Math.Ceiling((double)total / PorPagina);
    private DerivacionesService.CitaDerivacionResponse? citaEditar;
    private CancellationTokenSource? espera;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var todos = await Service.GetDoctoresAsync("");
            doctoresSede = todos.Where(d => string.Equals(d.Sucursal, Sucursal, StringComparison.OrdinalIgnoreCase)).OrderBy(d => d.Nombre).ToList();
        }
        catch { doctoresSede = new(); }
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        error = "";
        try
        {
            var r = await Service.GetCitasPaginadasAsync(pagina, PorPagina, busqueda, "", fecha, idDoctor > 0 ? idDoctor : (int?)null, false, null, null, null, tipo);
            citas = r?.Data ?? new();
            total = r?.TotalRegistros ?? 0;
        }
        catch (Exception ex)
        {
            error = "No se pudo cargar la lista: " + ex.Message;
            citas = new();
            total = 0;
        }
        finally
        {
            cargando = false;
        }
    }

    // Busca 400 ms despues de dejar de escribir
    private async Task AlEscribir(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        busqueda = e.Value?.ToString() ?? "";
        espera?.Cancel();
        espera = new CancellationTokenSource();
        var token = espera.Token;
        try { await Task.Delay(400, token); }
        catch (TaskCanceledException) { return; }
        pagina = 1;
        await Cargar();
    }

    private async Task AlCambiarFecha(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        fecha = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;
        pagina = 1;
        await Cargar();
    }

    private async Task AlCambiarDoctor(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out idDoctor);
        pagina = 1;
        await Cargar();
    }

    private async Task AlCambiarTipo(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        tipo = e.Value?.ToString() ?? "";
        pagina = 1;
        await Cargar();
    }

    private async Task Limpiar()
    {
        busqueda = ""; fecha = null; idDoctor = 0; tipo = ""; pagina = 1;
        await Cargar();
    }

    private async Task Anterior() { if (pagina > 1) { pagina--; await Cargar(); } }
    private async Task Siguiente() { if (pagina < totalPaginas) { pagina++; await Cargar(); } }

    private void CerrarEdicion() => citaEditar = null;

    private async Task AlGuardar()
    {
        citaEditar = null;
        await Cargar();
    }

    private async Task Borrar(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "¿Seguro que desea borrar esta cita?");
        if (!confirmar) return;
        if (await Service.BorrarCitaAsync(id))
        {
            await Cargar();
            await JS.InvokeVoidAsync("alert", "Cita borrada.");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Error al borrar.");
        }
    }

    // Mismo mensaje que usa Derivaciones
    private async Task CompartirWhatsApp(DerivacionesService.CitaDerivacionResponse cita)
    {
        string sucursal = cita.Doctor?.Sucursal ?? "Centro";
        string centroMedico = sucursal == "Milan" ? "Centro de especialidades y laboratorio Doktors - Klinic Milan" : "Centro de Diagnostico y laboratorio Doktors - Klinic";
        string direccion = sucursal == "Milan" ? "Ver ubicacion: https://maps.app.goo.gl/9fTMqgw74q5MKZde8" : "Direccion: \nAv. 9 de Octubre 1318, entre Av. Quito y Av. Machala.\nVer ubicacion: https://maps.app.goo.gl/wT3ccKPqnE5CUjbU9";

        var msg = $@"Hola, {cita.Derivacion?.Paciente?.NombreCompleto ?? ""} (C.I. {cita.Derivacion?.Paciente?.Cedula ?? ""}):

Te recordamos que tu cita medica por derivacion del IESS ha sido aprobada.

Lugar: {centroMedico}
especialidad: {cita.Derivacion?.EspecialidadRequerida ?? ""}
Fecha: {cita.FechaHora:dd/MM/yyyy}
Hora: {cita.FechaHora:HH:mm}

{direccion}

Indicaciones importantes:
Presentarse 20 minutos antes con su cedula de identidad original.

Por favor, responde a este mensaje con un CONFIRMAR para asegurar tu turno.

Tu salud es nuestra prioridad.";

        var tel = cita.Derivacion?.Paciente?.Telefono;
        string url;
        if (!string.IsNullOrWhiteSpace(tel))
        {
            if (!tel.StartsWith("593")) { tel = "593" + tel.TrimStart('0'); }
            url = $"https://api.whatsapp.com/send?phone={tel}&text={Uri.EscapeDataString(msg)}";
        }
        else
        {
            url = $"https://api.whatsapp.com/send?text={Uri.EscapeDataString(msg)}";
        }
        await JS.InvokeVoidAsync("window.open", url, "_blank");
    }

    public void Dispose()
    {
        espera?.Cancel();
        espera?.Dispose();
    }
}
