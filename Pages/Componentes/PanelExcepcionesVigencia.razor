@using LaboratorioFront.Services
@inject DerivacionesService Service

@* Excepciones de vigencia del codigo de validacion (mismo panel que el de Derivaciones): autorizan a una cedula a agendar aunque su CVA haya vencido. *@
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-2xl font-bold text-gray-800"><i class="fa-solid fa-user-shield text-amber-500 mr-2" aria-hidden="true"></i> Excepciones de vigencia</h2>
        <p class="text-sm text-gray-500 mt-1 mb-5">Autoriza a un paciente concreto a agendar aunque su código de validación (CVA) ya haya vencido. Tú eliges cuántos días dura (por defecto @DiasPorDefecto, máximo 30), se puede revocar antes y queda registrada con tu nombre y el motivo. Solo vale para esa cédula: la regla de los 90 días sigue igual para todos los demás.</p>

        <div class="grid md:grid-cols-5 gap-3 items-end p-4 rounded-xl bg-amber-50 border border-amber-100">
            <div>
                <label for="exc-cedula" class="block text-xs font-bold text-gray-600 mb-1">Cédula del paciente</label>
                <input id="exc-cedula" type="text" maxlength="20" inputmode="numeric" @bind="cedula" @bind:event="oninput" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="0912345678" />
            </div>
            <div class="md:col-span-2">
                <label for="exc-motivo" class="block text-xs font-bold text-gray-600 mb-1">Motivo (obligatorio)</label>
                <input id="exc-motivo" type="text" maxlength="300" @bind="motivo" @bind:event="oninput" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="Ej: derivación entregada tarde por el hospital, autorizado por jefatura" />
            </div>
            <div>
                <label for="exc-dias" class="block text-xs font-bold text-gray-600 mb-1">Días</label>
                <input id="exc-dias" type="number" min="1" max="30" @bind="dias" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
            </div>
            <button type="button" disabled="@guardando" @onclick="Conceder" class="px-4 py-2 bg-amber-700 hover:bg-amber-800 disabled:opacity-50 text-white text-sm font-bold rounded-lg shadow-sm">
                <i class="fa-solid fa-check mr-1" aria-hidden="true"></i> Autorizar
            </button>
        </div>
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="mt-3 text-sm font-semibold @(mensajeOk ? "text-green-700" : "text-red-600")" role="alert">@mensaje</p>
        }

        <div class="mt-6 overflow-x-auto">
            @if (cargando)
            {
                <p class="text-sm text-gray-500" role="status"><i class="fa-solid fa-spinner fa-spin mr-1" aria-hidden="true"></i> Cargando...</p>
            }
            else if (!excepciones.Any())
            {
                <p class="text-sm text-gray-500">Todavía no se ha autorizado ninguna excepción.</p>
            }
            else
            {
                <table class="w-full text-sm text-left">
                    <thead class="text-xs uppercase text-gray-500 border-b border-gray-200">
                        <tr>
                            <th class="py-2 pr-3">Cédula</th><th class="py-2 pr-3">Paciente</th><th class="py-2 pr-3">Motivo</th>
                            <th class="py-2 pr-3">Autorizada por</th><th class="py-2 pr-3">Vence</th><th class="py-2 pr-3">Estado</th><th class="py-2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in excepciones)
                        {
                            <tr class="border-b border-gray-100">
                                <td class="py-2 pr-3 font-mono">@e.Cedula</td>
                                <td class="py-2 pr-3">@(string.IsNullOrEmpty(e.Paciente) ? "(aún no registrado)" : e.Paciente)</td>
                                <td class="py-2 pr-3 text-gray-600">@e.Motivo</td>
                                <td class="py-2 pr-3">@(e.CreadoPorNombre ?? e.CreadoPor)<br /><span class="text-xs text-gray-500">@e.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></td>
                                <td class="py-2 pr-3">@e.Vence.ToString("dd/MM/yyyy")</td>
                                <td class="py-2 pr-3">
                                    @if (e.Vigente) { <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-800 text-xs font-bold">Vigente</span> }
                                    else if (!string.IsNullOrEmpty(e.RevocadaPor)) { <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-700 text-xs font-bold">Revocada por @e.RevocadaPor</span> }
                                    else { <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-xs font-bold">Vencida</span> }
                                </td>
                                <td class="py-2 text-right">
                                    @if (e.Vigente)
                                    {
                                        <button type="button" @onclick="() => Revocar(e.Id)" class="px-3 py-1 text-xs font-bold text-red-700 border border-red-300 hover:bg-red-50 rounded-lg">Revocar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private const int DiasPorDefecto = 7;
    private List<DerivacionesService.ExcepcionVigenciaDto> excepciones = new();
    private string cedula = "";
    private int dias = DiasPorDefecto;
    private string motivo = "";
    private string mensaje = "";
    private bool mensajeOk;
    private bool guardando;
    private bool cargando = true;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        try { excepciones = await Service.GetExcepcionesVigenciaAsync(); }
        catch (Exception ex) { mensaje = "No se pudo cargar: " + ex.Message; mensajeOk = false; }
        finally { cargando = false; }
    }

    private async Task Conceder()
    {
        mensaje = "";
        guardando = true;
        try
        {
            var error = await Service.CrearExcepcionVigenciaAsync(cedula.Trim(), motivo.Trim(), dias);
            if (error == null)
            {
                mensaje = $"Excepción autorizada para la cédula {cedula.Trim()} por {dias} días.";
                mensajeOk = true;
                cedula = ""; motivo = "";
                await Cargar();
            }
            else { mensaje = error; mensajeOk = false; }
        }
        catch (Exception ex) { mensaje = "No se pudo guardar: " + ex.Message; mensajeOk = false; }
        finally { guardando = false; }
    }

    private async Task Revocar(int id)
    {
        mensaje = "";
        if (await Service.RevocarExcepcionVigenciaAsync(id)) { mensaje = "Excepción revocada."; mensajeOk = true; }
        else { mensaje = "No se pudo revocar."; mensajeOk = false; }
        await Cargar();
    }
}
