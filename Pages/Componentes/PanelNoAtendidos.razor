@using LaboratorioFront.Services
@inject DerivacionesService Service

@* Pacientes cuya cita quedo como "No asistio": Caja los busca y les da una cita nueva con el mismo modal que usa "No confirmaron". *@
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-1">No atendidos</h2>
        <p class="text-sm text-gray-500 mb-4">Pacientes cuya cita quedó como "no asistió". Búscalos y dales una cita nueva. Si ya tienen una cita pendiente aparecen como reagendados.</p>

        <div class="flex flex-col md:flex-row gap-3 mb-4">
            <div class="relative flex-1">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"><i class="fa-solid fa-search text-gray-400" aria-hidden="true"></i></div>
                <input type="text" aria-label="Buscar por nombre o cédula" @bind="busqueda" @bind:event="oninput" @onkeyup="BuscarConEnter" placeholder="Buscar por nombre o cédula... (Enter)" class="block w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg bg-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-turquesa-500 sm:text-sm shadow-sm" />
            </div>
            <button type="button" @onclick="Buscar" class="px-5 py-3 bg-turquesa-600 hover:bg-turquesa-700 text-white font-semibold rounded-lg shadow-sm flex items-center justify-center gap-2">
                <i class="fa-solid fa-search" aria-hidden="true"></i> Buscar
            </button>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="mb-3 text-sm font-semibold text-red-600" role="alert">@error</p>
        }

        @if (cargando)
        {
            <div class="flex justify-center items-center py-12 text-turquesa-600" role="status" aria-label="Cargando"><i class="fa-solid fa-spinner fa-spin text-3xl" aria-hidden="true"></i></div>
        }
        else if (citas.Count == 0)
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fa-regular fa-calendar-check text-4xl mb-3 text-green-500" aria-hidden="true"></i>
                <p>No hay pacientes marcados como no asistió.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-xl border border-gray-200">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-50 text-gray-700 border-b border-gray-200">
                        <tr>
                            <th class="px-3 py-3 font-semibold text-sm">Fecha/Hora original</th>
                            <th class="px-3 py-3 font-semibold text-sm">Paciente</th>
                            <th class="px-3 py-3 font-semibold text-sm">Doctor</th>
                            <th class="px-3 py-3 font-semibold text-sm text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cita in citas)
                        {
                            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                <td class="px-3 py-3 text-sm font-medium text-gray-800">@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-3 py-3 text-sm text-gray-600">@(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")<LaboratorioFront.Pages.Componentes.BadgeTipoPaciente Tipo="@cita.Derivacion?.TipoPaciente" Origen="@cita.Derivacion?.Origen" /><br /><span class="text-xs text-gray-500">@(cita.Derivacion?.Paciente?.Telefono ?? "")</span></td>
                                <td class="px-3 py-3 text-sm text-gray-600">@(cita.Doctor?.Nombre ?? "N/A")</td>
                                <td class="px-3 py-3 text-center whitespace-nowrap">
                                    @if (cita.Derivacion != null)
                                    {
                                        if (cita.Derivacion.Citas != null && cita.Derivacion.Citas.Any(c => c != null && c.Estado == "Pendiente" && c.Activo))
                                        {
                                            <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-100 text-green-800 text-sm font-medium rounded-lg border border-green-200">
                                                <i class="fa-solid fa-check-circle" aria-hidden="true"></i> Reagendado
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="inline-flex items-center gap-2 px-3 py-1.5 bg-turquesa-600 hover:bg-turquesa-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm" @onclick="() => Reagendar(cita.Derivacion)">
                                                <i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> Re-agendar
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPaginas > 1)
            {
                <div class="flex items-center justify-between mt-4 text-sm text-gray-600">
                    <span>Página @pagina de @totalPaginas (@total registros)</span>
                    <div class="flex gap-2">
                        <button type="button" disabled="@(pagina <= 1)" @onclick="Anterior" class="px-3 py-2 border border-gray-300 rounded-lg disabled:opacity-40">Anterior</button>
                        <button type="button" disabled="@(pagina >= totalPaginas)" @onclick="Siguiente" class="px-3 py-2 border border-gray-300 rounded-lg disabled:opacity-40">Siguiente</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (derivacionReagendar != null)
{
    <LaboratorioFront.Pages.Componentes.AgendarCitaModal Derivacion="derivacionReagendar" SucursalInicial="@Sucursal" OnCerrar="CerrarModal" OnAgendada="AlAgendar" />
}

@code {
    /// <summary>Sede del usuario de Caja ("Centro" o "Milan"): la sede con la que se abre el modal de la cita.</summary>
    [Parameter] public string Sucursal { get; set; } = "Centro";

    private const int PorPagina = 15;
    private List<DerivacionesService.CitaDerivacionResponse> citas = new();
    private string busqueda = "";
    private string error = "";
    private bool cargando = true;
    private int pagina = 1;
    private int total;
    private int totalPaginas => total == 0 ? 1 : (int)Math.Ceiling((double)total / PorPagina);
    private Derivacion? derivacionReagendar;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        error = "";
        try
        {
            var r = await Service.GetCitasPaginadasAsync(pagina, PorPagina, busqueda ?? "", "No Asistio");
            citas = r?.Data ?? new();
            total = r?.TotalRegistros ?? 0;
        }
        catch (Exception ex)
        {
            error = "No se pudo cargar la lista: " + ex.Message;
            citas = new();
            total = 0;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Buscar() { pagina = 1; await Cargar(); }
    private async Task BuscarConEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (e.Key == "Enter") await Buscar(); }
    private async Task Anterior() { if (pagina > 1) { pagina--; await Cargar(); } }
    private async Task Siguiente() { if (pagina < totalPaginas) { pagina++; await Cargar(); } }

    private void Reagendar(Derivacion d) => derivacionReagendar = d;
    private void CerrarModal() => derivacionReagendar = null;

    private async Task AlAgendar()
    {
        derivacionReagendar = null;
        await Cargar();
    }
}
