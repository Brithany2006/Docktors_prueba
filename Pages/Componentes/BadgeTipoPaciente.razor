@* Distintivo IESS / Particular / Antiguo / Sin clasificar segun el codigo de validacion de la derivacion, y de donde vino (Bot o Caja). Lo calcula la API. *@
@if (!string.IsNullOrWhiteSpace(Tipo))
{
    <span class="px-2 py-0.5 ml-1 inline-block align-middle rounded text-[10px] font-bold border @Clases" title="@Titulo">@Texto@if (!string.IsNullOrWhiteSpace(Origen)) { <span class="font-semibold opacity-80"> &middot; @Origen</span> }</span>
}

@code {
    [Parameter] public string? Tipo { get; set; }
    [Parameter] public string? Origen { get; set; }

    private string Texto => Tipo switch { "IESS" => "IESS", "Particular" => "Particular", "Antiguo" => "Antiguo", _ => "Sin clasificar" };

    private string Clases => Tipo switch
    {
        "IESS" => "bg-blue-100 text-blue-700 border-blue-200",
        "Particular" => "bg-purple-100 text-purple-700 border-purple-200",
        "Antiguo" => "bg-amber-100 text-amber-700 border-amber-200",
        _ => "bg-gray-100 text-gray-500 border-gray-200"
    };

    private string Titulo => (Tipo switch
    {
        "IESS" => "Paciente IESS (codigo CVA)",
        "Particular" => "Paciente particular",
        "Antiguo" => "Registro antiguo, sin codigo de validacion",
        _ => "Codigo no reconocido: no se puede saber si es IESS o particular"
    }) + (Origen == "Bot" ? ". Llego por el Excel del bot" : Origen == "Caja" ? ". Lo registro Caja a mano" : "");
}
