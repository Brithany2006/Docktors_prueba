                                }
                                else
                                {
                                    <p class="text-gray-500 text-sm italic text-center py-4">No hay resultados de imágenes.</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<OdooCitaDto> citas = new();
    
    private PacientePdf? pacienteAntiguo;

    private string miRuc = "";
    private string miCedula = "";
    private string miNombreCompleto = "";

    // Para el modal Odoo
    private bool mostrarModalOdoo = false;
    private OdooCitaDto? citaSeleccionada;

    // Para el modal Legacy
    private bool mostrarModalLegacy = false;
    private PacientePdf? pacienteLegacySeleccionado;
    private bool isLoadingLegacyDetails = false;
    private List<string> legacyPdfs = new();
    
    private List<PacienteEstudio> legacyRxInformes = new();
    private List<PacienteEstudio> legacyRxImagenes = new();
    private List<PacienteEstudio> legacyEcoInformes = new();
    private List<PacienteEstudio> legacyEcoImagenes = new();

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("laboratorio.getToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        Api.SetToken(token);

        try
        {
            var payload = token.Split('.')[1];
            var payloadStr = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(PadBase64(payload)));
            var payloadJson = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(payloadStr);
            
            if (payloadJson != null)
            {
                if (payloadJson.TryGetValue("Cedula", out var cVal)) miCedula = cVal?.ToString() ?? "";
                if (payloadJson.TryGetValue("RUC", out var rVal)) miRuc = rVal?.ToString() ?? "";
                if (payloadJson.TryGetValue("Nombre", out var nVal)) miNombreCompleto = nVal?.ToString() ?? "";
            }

            if (miRuc == "PARTICULAR") miRuc = "9999999999";
        }
        catch { }

        await CargarDatos();
    }

    private string PadBase64(string base64)
    {
        base64 = base64.Replace('-', '+').Replace('_', '/');
        switch (base64.Length % 4)
        {
            case 2: base64 += "=="; break;
            case 3: base64 += "="; break;
        }
        return base64;
    }

    private async Task CargarDatos()
    {
        isLoading = true;
        citas.Clear();
        pacienteAntiguo = null;

        var taskOdoo = Api.GetMisResultadosExternosPacienteAsync(miRuc, miCedula);
        
        // El legacy carga todas las carpetas del RUC actual y nosotros lo filtramos.
        // O si ya est configurado, slo busca en su nombre
        var taskLegacy = Api.GetPacientesPorCarpetaAsync();

        await Task.WhenAll(taskOdoo, taskLegacy);

        citas = taskOdoo.Result ?? new();

        var legacyAll = taskLegacy.Result ?? new();
        // Filtrar slo al que coincida con mi nombre
        pacienteAntiguo = legacyAll.FirstOrDefault(x => x.NombreCompleto != null && miNombreCompleto != null && x.NombreCompleto.Contains(miNombreCompleto, StringComparison.OrdinalIgnoreCase));

        isLoading = false;
    }

    private void AbrirDetalleOdoo(OdooCitaDto cita)
    {
        citaSeleccionada = cita;
        mostrarModalOdoo = true;
    }

    private void CerrarModalOdoo()
    {
        mostrarModalOdoo = false;
        citaSeleccionada = null;
    }

    private async Task AbrirModalLegacy(PacientePdf paciente)
    {
        pacienteLegacySeleccionado = paciente;
        mostrarModalLegacy = true;
        isLoadingLegacyDetails = true;

        
        
        var rxInfTask = Api.GetRxInformesPorNombreAsync(paciente.NombreCompleto);
        var rxImgTask = Api.GetRxImagenesPorNombreAsync(paciente.NombreCompleto);
        var ecoInfTask = Api.GetEcoInformesPorNombreAsync(paciente.NombreCompleto);
        var ecoImgTask = Api.GetEcoImagenesPorNombreAsync(paciente.NombreCompleto);

        await Task.WhenAll(rxInfTask, rxImgTask, ecoInfTask, ecoImgTask);

        legacyRxInformes = rxInfTask.Result ?? new();
        legacyRxImagenes = rxImgTask.Result ?? new();
        legacyEcoInformes = ecoInfTask.Result ?? new();
        legacyEcoImagenes = ecoImgTask.Result ?? new();

        isLoadingLegacyDetails = false;
    }

    private void CerrarModalLegacy()
    {
        mostrarModalLegacy = false;
        pacienteLegacySeleccionado = null;
        legacyPdfs.Clear();
        legacyRxInformes.Clear();
        legacyRxImagenes.Clear();
        legacyEcoInformes.Clear();
        legacyEcoImagenes.Clear();
    }

    private async Task VerPdfAntiguo(string nombreArchivo)
    {
        var base64 = await Api.GetPdfBase64PorNombreAsync(nombreArchivo);
        if (!string.IsNullOrEmpty(base64))
        {
            await JS.InvokeVoidAsync("openBase64Pdf", base64, nombreArchivo);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "No se pudo cargar el documento.");
        }
    }
}






