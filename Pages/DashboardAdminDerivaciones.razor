    private string filtroSinSubsecuente = "";
    private System.Timers.Timer debounceTimerSinSubsecuente;
    private bool esSubsecuenteAgendar = false;
    
    private void OnSearchSinSubsecuenteInput(ChangeEventArgs e)
    {
        filtroSinSubsecuente = e.Value?.ToString() ?? "";
        if (debounceTimerSinSubsecuente != null) { debounceTimerSinSubsecuente.Stop(); debounceTimerSinSubsecuente.Dispose(); }
        debounceTimerSinSubsecuente = new System.Timers.Timer(400); debounceTimerSinSubsecuente.AutoReset = false;
        debounceTimerSinSubsecuente.Elapsed += (s, args) => FiltrarSinSubsecuente(null);
        debounceTimerSinSubsecuente.Start();
    }
    
    private void FiltrarSinSubsecuente(object state)
    {
        InvokeAsync(() => {
            if (string.IsNullOrWhiteSpace(filtroSinSubsecuente))
            {
                citasSinSubsecuenteFiltradas = citasSinSubsecuente?.ToList();
            }
            else
            {
                var q = filtroSinSubsecuente.ToLower();
                citasSinSubsecuenteFiltradas = citasSinSubsecuente?.Where(c => 
                    (c.Derivacion?.Paciente?.NombreCompleto?.ToLower()?.Contains(q) == true) ||
                    (c.Derivacion?.Paciente?.Cedula?.Contains(q) == true)
                ).ToList();
            }
            StateHasChanged();
        });
    }
    
        private async Task CargarSinSubsecuente()
    {
        try {
            citasSinSubsecuente = await Service.GetCitasSinSubsecuenteAsync();
            citasSinSubsecuenteFiltradas = citasSinSubsecuente?.ToList();
        } catch (Exception ex) {
