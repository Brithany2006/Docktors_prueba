    private bool CoincideEspecialidad(string? espDoctor, string? espDerivacion)
    {
        if (string.IsNullOrEmpty(espDoctor) || string.IsNullOrEmpty(espDerivacion)) return false;
        
        var doc = NormalizarTexto(espDoctor);
        var req = NormalizarTexto(espDerivacion);
        
        if (doc == req) return true;

        // El ecocardiograma es un procedimiento aparte: no se mezcla con cardiologia ni con EKG
        if (doc.Contains("ECOCARDIO") || req.Contains("ECOCARDIO")) return false;
        
        // Reglas especificas
        if (doc.Contains("CARDIO") && req.Contains("CARDIO") && !req.Contains("ELECTRO") && !doc.Contains("ELECTRO")) return true;
        if (doc.Contains("MED") && doc.Contains("INTERN") && req.Contains("MED") && req.Contains("INTERN")) return true;
        if (doc.Contains("OTORRINO") && req.Contains("OTORRINO")) return true;
        if (doc.Contains("GASTRO") && req.Contains("GASTRO")) return true;
        if (doc.Contains("TRAUMA") && req.Contains("TRAUMA")) return true;
        if (doc.Contains("GINECO") && req.Contains("GINECO")) return true;
        if (doc.Contains("PEDIATR") && req.Contains("PEDIATR")) return true;
        if (doc.Contains("OFTALMO") && req.Contains("OFTALMO")) return true;
        if (doc.Contains("UROLOG") && req.Contains("UROLOG")) return true;
        if (doc.Contains("REUMATO") && req.Contains("REUMATO")) return true;
        if (doc.Contains("NEUMOLOG") && req.Contains("NEUMOLOG")) return true;
        if (doc.Contains("NUTRICION") && req.Contains("NUTRICION")) return true;
        if (doc.Contains("ELECTROCARDIOGRAMA") && req.Contains("ELECTROCARDIOGRAMA")) return true;
        
        return doc.Contains(req) || req.Contains(doc);
    }
    
    private string NormalizarTexto(string texto)
    {
        if (string.IsNullOrEmpty(texto)) return "";
        var temp = texto.ToUpperInvariant()
            .Replace("A", "A")
            .Replace("E", "E")
            .Replace("I", "I")
            .Replace("O", "O")
            .Replace("U", "U")
            .Replace("?", "I"); // Por si acaso hay 'CARDIOLOG?A'
        return temp.Trim();
    }


