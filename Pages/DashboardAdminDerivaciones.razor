    private async Task CargarProcedimiento(string tipo)
    {
        bool eco = tipo == "eco";
        var result = await Service.GetDerivacionesPaginadasAsync(eco ? paginaActualEco : paginaActualEkg, itemsPorPagina, eco ? filtroEco : filtroEkg, eco ? "eco" : "ekg");
        var data = result.Data ?? new();
        int total = (int)result.TotalRegistros;
        int paginas = total == 0 ? 1 : (int)Math.Ceiling((double)total / itemsPorPagina);
        if (eco) { ecoServer = data; totalEco = total; totalPaginasEcoServer = paginas; }
        else { ekgServer = data; totalEkg = total; totalPaginasEkgServer = paginas; }
        StateHasChanged();
    }

    private async Task CargarProcedimientosServer()
    {
        await CargarProcedimiento("ekg");
        await CargarProcedimiento("eco");
    }

    private void SetProcTab(string tipo) { procTab = tipo; }

    private void OnSearchProcInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        string tipo = procTab;
        string valor = e.Value?.ToString() ?? "";
        if (tipo == "eco") { filtroEco = valor; } else { filtroEkg = valor; }
        if (debounceTimerProc != null) { debounceTimerProc.Stop(); debounceTimerProc.Dispose(); }
        debounceTimerProc = new System.Timers.Timer(400); debounceTimerProc.AutoReset = false;
        debounceTimerProc.Elapsed += async (s, args) =>
        {
            if (tipo == "eco") { paginaActualEco = 1; } else { paginaActualEkg = 1; }
            await InvokeAsync(() => CargarProcedimiento(tipo));
        };
        debounceTimerProc.Start();
    }

    private async Task SiguientePaginaProc()
    {
        if (procTab == "eco") { if (paginaActualEco < totalPaginasEcoServer) { paginaActualEco++; await CargarProcedimiento("eco"); } }
        else { if (paginaActualEkg < totalPaginasEkgServer) { paginaActualEkg++; await CargarProcedimiento("ekg"); } }
    }

    private async Task AnteriorPaginaProc()
    {
        if (procTab == "eco") { if (paginaActualEco > 1) { paginaActualEco--; await CargarProcedimiento("eco"); } }
        else { if (paginaActualEkg > 1) { paginaActualEkg--; await CargarProcedimiento("ekg"); } }
    }


