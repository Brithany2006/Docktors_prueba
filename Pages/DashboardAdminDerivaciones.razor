@inject HttpClient Http
@page "/dashboard-derivaciones"
@using LaboratorioFront.Services
@inject DerivacionesService Service
@inject NavigationManager Nav

<div class="admin-layout flex flex-col md:flex-row min-h-screen bg-gray-50 font-sans">
    <aside class="w-full md:w-64 bg-white shadow-md flex-shrink-0 flex flex-col md:min-h-screen p-4 border-r border-gray-200">
        <div class="mb-8 px-2 flex items-center justify-center md:justify-start gap-3">
            <div class="h-10 w-10 bg-turquesa-500 rounded-lg flex items-center justify-center shadow-md">
                <i class="fa-solid fa-hospital-user text-white text-xl"></i>
            </div>
            <h2 class="text-xl font-bold text-turquesa-900 hidden md:block">Derivaciones</h2>
        </div>
        
        <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-visible pb-2 md:pb-0">
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(currentTab == "lista" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="@(() => SetTab("lista"))">
                 <i class="fa-solid fa-list w-5 text-center @(currentTab == "lista" ? "text-turquesa-600" : "text-gray-400")"></i> Lista Derivaciones
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(currentTab == "nueva" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="@(() => SetTab("nueva"))">
                <i class="fa-solid fa-notes-medical w-5 text-center @(currentTab == "nueva" ? "text-turquesa-600" : "text-gray-400")"></i> Nueva Derivacion
            </button>
            
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(currentTab == "bot" ? "bg-green-50 text-green-700 shadow-sm border border-green-100" : "text-gray-600 hover:bg-gray-100")" @onclick="@(() => SetTab("bot"))">
                <i class="fa-brands fa-whatsapp w-5 text-center @(currentTab == "bot" ? "text-green-600" : "text-gray-400")"></i> Carga Bot WhatsApp
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(currentTab == "agenda" ? "bg-purple-50 text-purple-700 shadow-sm border border-purple-100" : "text-gray-600 hover:bg-gray-100")" @onclick="@(() => SetTab("agenda"))">
                <i class="fa-solid fa-calendar-days w-5 text-center @(currentTab == "agenda" ? "text-purple-600" : "text-gray-400")"></i> Agenda Diaria
            </button>
<button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(currentTab == "citas" ? "bg-turquesa-50 text-turquesa-700 shadow-sm border border-turquesa-100" : "text-gray-600 hover:bg-gray-100")" @onclick="@(() => SetTab("citas"))">
                <i class="fa-solid fa-calendar-check w-5 text-center @(currentTab == "citas" ? "text-turquesa-600" : "text-gray-400")"></i> Citas Generadas
            </button>
            
            
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(currentTab == "no-atendidos" ? "bg-red-50 text-red-700 shadow-sm border border-red-100" : "text-gray-600 hover:bg-gray-100")" @onclick="@(() => SetTab("no-atendidos"))">
                <i class="fa-solid fa-calendar-xmark w-5 text-center @(currentTab == "no-atendidos" ? "text-red-600" : "text-gray-400")"></i> No Atendidos
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(currentTab == "procedimientos" ? "bg-blue-50 text-blue-700 shadow-sm border border-blue-100" : "text-gray-600 hover:bg-gray-100")" @onclick="@(() => SetTab("procedimientos"))">
                <i class="fa-solid fa-heart-pulse w-5 text-center @(currentTab == "procedimientos" ? "text-blue-600" : "text-gray-400")"></i> Procedimientos
            </button>
            <button class="flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-xl transition-all whitespace-nowrap @(currentTab == "subsecuentes" ? "bg-orange-50 text-orange-700 shadow-sm border border-orange-100" : "text-gray-600 hover:bg-gray-100")" @onclick="@(() => SetTab("subsecuentes"))">
                <i class="fa-solid fa-clock-rotate-left w-5 text-center @(currentTab == "subsecuentes" ? "text-orange-600" : "text-gray-400")"></i> Subsecuentes
            </button>
            <div class="mt-auto hidden md:block pt-4 border-t border-gray-100">

                <button class="w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold text-red-600 hover:bg-red-50 rounded-xl transition-colors" @onclick="Salir">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i> Salir
                </button>
            </div>
        </div>
    </aside>

            @if (currentTab == "agenda")
        {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Agenda Diaria de Doctores</h2>
                <div class="mb-6 bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col md:flex-row gap-4 items-end">
                    <div class="flex-1">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Fecha:</label>
                        <input type="date" @bind="agendaFecha" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none" />
                    </div>
                    <div class="flex-1">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Doctor:</label>
                        <select @bind="agendaDoctorId" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none">
                            <option value="0">-- Seleccionar Doctor --</option>
                            @if (doctores != null)
                            {
                                @foreach (var doc in doctores)
                                {
                                    <option value="@doc.Id">@doc.Nombre (@doc.Especialidad)</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <button @onclick="CargarAgenda" class="px-6 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-bold transition-colors shadow-sm flex items-center gap-2">
                            <i class="fa-solid fa-search"></i> Ver Agenda
                        </button>
                    </div>
                </div>

                @if (isLoadingAgenda)
                {
                    <div class="flex justify-center items-center py-12 text-purple-600">
                        <i class="fa-solid fa-spinner fa-spin text-3xl"></i>
                    </div>
                }
                else if (agendaCitas != null)
                {
                    @if (agendaCitas.Count == 0)
                    {
                        <div class="text-center py-12 text-gray-500">
                            <i class="fa-regular fa-calendar-xmark text-4xl mb-3"></i>
                            <p>El doctor no tiene citas agendadas para esta fecha.</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto rounded-xl border border-gray-200">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-purple-50 text-purple-900 border-b border-purple-200">
                                    <tr>
                                        <th class="px-3 py-3 font-bold text-sm">Hora</th>
                                        <th class="px-3 py-3 font-bold text-sm">Paciente</th>
                                        <th class="px-3 py-3 font-bold text-sm">Cedula</th>
                                        <th class="px-3 py-3 font-bold text-sm">Especialidad</th>
                                        <th class="px-3 py-3 font-bold text-sm">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in agendaCitas)
                                    {
                                        <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                            <td class="px-3 py-3 text-sm font-bold text-gray-800">@cita.FechaHora.ToString("HH:mm")</td>
                                            <td class="px-3 py-3 text-sm text-gray-600">@(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")</td>
                                            <td class="px-3 py-3 text-sm text-gray-600">@(cita.Derivacion?.Paciente?.Cedula ?? "N/A")</td>
                                            <td class="px-3 py-3 text-sm text-gray-600">@(cita.Derivacion?.EspecialidadRequerida ?? "N/A")</td>
                                            <td class="px-3 py-3">
                                                @if (cita.Estado == "Pendiente")
                                                {
                                                    <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-xs font-bold">Pendiente</span>
                                                }
                                                else
                                                {
                                                    <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-xs font-bold">@cita.Estado</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }
        <main class="flex-grow p-3 md:p-4 overflow-y-auto min-w-0">
        @if (currentTab == "citas")
        {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Todas las Citas</h2>
                
<div class="mb-4 bg-gray-50 p-3 rounded-lg border border-gray-200">
    <div class="flex items-center gap-2">
        <div class="flex-1 flex items-center bg-white p-2 rounded-lg border border-gray-200">
            <i class="fa-solid fa-search text-gray-400 mx-3"></i>
            <input type="text" value="@filtroCitas" @oninput="OnSearchCitasInput" placeholder="Buscar por nombres, apellidos o cedula..." class="w-full bg-transparent outline-none text-gray-700" />
        </div>
        <button @onclick="() => mostrarFiltrosCitas = !mostrarFiltrosCitas" class="px-4 py-2 bg-white border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors flex items-center gap-2">
            <i class="fa-solid fa-filter"></i> Filtros
        </button>
    </div>
    @if (mostrarFiltrosCitas)
    {
        <div class="mt-4 pt-4 border-t border-gray-200 flex flex-col md:flex-row gap-4 items-center">
            <div class="flex items-center gap-2">
                <label class="text-sm font-semibold text-gray-700">Fecha:</label>
                <input type="date" value="@(filtroCitaFecha?.ToString("yyyy-MM-dd"))" @onchange="OnFiltroFechaChanged" class="px-3 py-2 border border-gray-300 rounded-lg outline-none" />
            </div>
            <div class="flex items-center gap-2">
                <label class="text-sm font-semibold text-gray-700">Doctor:</label>
                <select value="@filtroCitaDoctorId" @onchange="OnFiltroDoctorChanged" class="px-3 py-2 border border-gray-300 rounded-lg outline-none max-w-xs">
                    <option value="">Todos los doctores</option>
                    @if (doctores != null)
                    {
                        @foreach (var doc in doctores)
                        {
                            <option value="@doc.Id">@doc.Nombre (@doc.Especialidad)</option>
                        }
                    }
                </select>
            </div>
            <button @onclick="LimpiarFiltrosCitas" class="px-3 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-medium transition-colors">
                Limpiar
            </button>
        </div>
    }
</div>
                @if (citasServer == null)
                {
                    <div class="flex justify-center items-center py-12 text-turquesa-600">
                        <i class="fa-solid fa-spinner fa-spin text-3xl"></i>
                    </div>
                }
                else if (citasServer.Count == 0)
                {
                    <div class="text-center py-12 text-gray-500">
                        <i class="fa-regular fa-calendar-xmark text-4xl mb-3"></i>
                        <p>No hay citas generadas.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-xl border border-gray-200">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-gray-50 text-gray-700 border-b border-gray-200">
                                <tr>
                                    <th class="px-3 py-3 font-semibold text-sm">Fecha/Hora</th>
                                    <th class="px-3 py-3 font-semibold text-sm">Paciente</th>
                                    <th class="px-3 py-3 font-semibold text-sm">Doctor</th>
                                    <th class="px-3 py-3 font-semibold text-sm">Estado</th>
                                    <th class="px-3 py-3 font-semibold text-sm text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cita in citasServer)
                                {
                                    <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                        <td class="px-3 py-3 text-sm font-medium text-gray-800">@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                                                                <td class="px-3 py-3 text-sm text-gray-600">
                                            @(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")
                                            @if (cita.EsSubsecuente)
                                            {
                                                <br/><span class="px-2 py-0.5 mt-1 inline-block rounded text-[10px] font-bold bg-blue-100 text-blue-700 border border-blue-200">Subsecuente</span>
                                            }
                                        </td>
                                        <td class="px-3 py-3 text-sm text-gray-600">@(cita.Doctor?.Nombre ?? "N/A")</td>
                                        <td class="px-3 py-3">
                                            @if (cita.Estado == "Pendiente")
                                            {
                                                <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-xs font-bold border border-yellow-200">Pendiente</span>
                                            }
                                            else if (cita.Estado == "Atendido")
                                            {
                                                <span class="px-3 py-1 rounded-full bg-green-100 text-green-800 text-xs font-bold border border-green-200">Atendido</span>
                                            }
                                            else
                                            {
                                                <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-xs font-bold border border-gray-200">@cita.Estado</span>
                                            
<div class="flex flex-row justify-center gap-2 mt-2">
                                                    <button class="inline-flex items-center gap-2 px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white text-sm font-medium rounded-lg transition-colors shadow-sm" @onclick="() => AbrirEditarCita(cita)" title="Editar Cita">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>
                                                    <button class="inline-flex items-center gap-2 px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-sm font-medium rounded-lg transition-colors shadow-sm" @onclick="() => BorrarCita(cita.Id)" title="Borrar Cita">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </div>
                                            }

                                        </td>
                                        <td class="px-3 py-3 text-center whitespace-nowrap">
                                            <div class="flex items-center justify-center gap-2">
                                                <button class="bg-blue-500 hover:bg-blue-600 text-white p-2 rounded-lg transition-colors shadow-sm" @onclick="() => AbrirEditarCita(cita)" title="Editar Cita">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button class="bg-red-500 hover:bg-red-600 text-white p-2 rounded-lg transition-colors shadow-sm" @onclick="() => BorrarCita(cita.Id)" title="Borrar Cita">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                                <button class="bg-green-500 hover:bg-green-600 text-white p-2 rounded-lg transition-colors shadow-sm" @onclick="() => CompartirWhatsApp(cita)" title="Compartir por WhatsApp">
                                                    <i class="fa-brands fa-whatsapp text-lg"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (currentTab == "bot")
        {
            <div class="space-y-6">
                <!-- Selector de sub-pestañas -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-3 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-2">
                        <button class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold transition-all @(subTabBot == "carga" ? "bg-green-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")" @onclick="@(() => CambiarSubTabBot("carga"))">
                            <i class="fa-brands fa-whatsapp"></i> Carga Bot WhatsApp
                        </button>
                        <button class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold transition-all @(subTabBot == "estadobot" ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")" @onclick="@(() => CambiarSubTabBot("estadobot"))">
                            <i class="fa-solid fa-robot"></i> Estado Bot WhatsApp
                            @if (botDerivaciones != null && botDerivaciones.Count > 0)
                            {
                                <span class="ml-1 px-2 py-0.5 rounded-full text-xs font-bold @(subTabBot == "estadobot" ? "bg-indigo-700 text-white" : "bg-gray-200 text-gray-700")">@botDerivaciones.Count</span>
                            }
                        </button>
                        <button class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold transition-all @(subTabBot == "panelbot" ? "bg-teal-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")" @onclick="@(() => CambiarSubTabBot("panelbot"))">
                            <i class="fa-solid fa-chart-pie"></i> Panel del Bot
                        </button>
                    </div>
                </div>

                @if (subTabBot == "estadobot")
                {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 md:p-6 flex-1 min-w-0 w-full m-0 overflow-hidden flex flex-col">
                <h2 class="text-2xl font-bold text-gray-800 mb-6"><i class="fa-solid fa-robot text-indigo-500 mr-2"></i> Estado del Bot (WhatsApp)</h2>
                
                <div class="mb-6 bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col md:flex-row gap-4 items-end flex-wrap">
                    <div class="flex-[2] min-w-[14rem]">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Buscar paciente:</label>
                        <div class="flex items-center bg-white rounded-lg border border-gray-300 px-3">
                            <i class="fa-solid fa-search text-gray-400 mr-2"></i>
                            <input type="text" value="@filtroBotBuscar" @oninput="OnBotBuscarInput" @onkeydown="OnBotBuscarKey" placeholder="Nombre, cédula o teléfono..." class="w-full py-2 bg-transparent outline-none text-gray-700" />
                            @if (!string.IsNullOrEmpty(filtroBotBuscar))
                            {
                                <button type="button" class="text-gray-400 hover:text-gray-600 ml-2" title="Limpiar búsqueda" @onclick="LimpiarBotBuscar"><i class="fa-solid fa-xmark"></i></button>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(filtroBotBuscar))
                        {
                            <p class="text-xs text-indigo-600 mt-1">Buscando en todas las fechas.</p>
                        }
                    </div>
                    <div class="flex-1 min-w-[12rem]">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Tanda (Fecha Subida Excel):</label>
                        <div class="flex items-center gap-2"><input type="date" @bind="filtroBotFecha" class="min-w-0 flex-1 px-3 py-2 border border-gray-300 rounded-lg outline-none" /><button class="px-3 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg text-sm font-semibold text-gray-700 transition-colors" @onclick="() => filtroBotFecha = null" title="Ver Todas las Fechas">Todas</button></div>
                    </div>
                    <div class="flex-1 min-w-[12rem]">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Doctor:</label>
                        <select @bind="filtroBotDoctorId" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none bg-white">
                            <option value="0">-- Todos los doctores --</option>
                            @if (doctores != null)
                            {
                                @foreach (var doc in doctores)
                                {
                                    <option value="@doc.Id">@doc.Nombre (@doc.Especialidad)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="flex-1 min-w-[12rem]">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Estado:</label>
                        <select @bind="filtroBotEstado" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none bg-white">
                            <option value="">-- Todos --</option>
                            <option value="1_NUEVO">1_NUEVO</option>
                            <option value="2_ESPERANDO_DOCTOR">2_ESPERANDO_DOCTOR</option>
                            <option value="3_PROPUESTA_ENVIADA">3_PROPUESTA_ENVIADA</option>
                            <option value="4_CONFIRMADO">4_CONFIRMADO</option>
                            <option value="5_RECHAZADO">5_RECHAZADO</option>
                            <option value="6_IGNORADO_DUPLICADO">6_IGNORADO_DUPLICADO</option>
                            <option value="7_NO_CONFIRMADO">7_NO_CONFIRMADO (No respondieron/Expirados)</option>
                            <option value="7_REAGENDAR">7_REAGENDAR</option>
                            <option value="8_DESCARTADO">8_DESCARTADO</option>
                            <option value="8_ASISTE_SIN_CONFIRMAR">8_ASISTE_SIN_CONFIRMAR (Asistió sin confirmar)</option>
                        </select>
                    </div>
                    <div>
                        <button @onclick="CargarEstadoBot" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-bold transition-colors shadow-sm flex items-center gap-2">
                            <i class="fa-solid fa-search"></i> Buscar
                        </button>
                    </div>
                </div>

                @if (isLoadingBotState)
                {
                    <div class="flex justify-center items-center py-12 text-indigo-600">
                        <i class="fa-solid fa-spinner fa-spin text-3xl"></i>
                    </div>
                }
                else if (botDerivaciones != null)
                {
                    @if (botDerivaciones.Count == 0)
                    {
                        <div class="text-center py-12 text-gray-500">
                            <i class="fa-solid fa-robot text-4xl mb-3 text-gray-300"></i>
                            <p>No se encontraron registros del bot con esos filtros.</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto rounded-xl border border-gray-200">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-indigo-50 text-indigo-900 border-b border-indigo-200">
                                    <tr>
                                        <th class="px-3 py-3 font-bold text-sm">Fecha Subida</th>
                                        <th class="px-3 py-3 font-bold text-sm">Paciente</th>
                                        <th class="px-3 py-3 font-bold text-sm">Cedula</th>
                                        <th class="px-3 py-3 font-bold text-sm">Telefono</th>
                                        <th class="px-3 py-3 font-bold text-sm">Especialidad</th>
                                        <th class="px-3 py-3 font-bold text-sm">Estado Bot</th><th class="px-3 py-3 font-bold text-sm">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    @foreach (var bd in botDerivaciones)
                                    {
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-3 py-3 text-sm text-gray-600">@bd.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")</td>
