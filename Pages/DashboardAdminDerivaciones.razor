    private bool isUploading = false;
    private string uploadMessage = "";
    private bool uploadSuccess = false;

    private void HandlePdfSelected(InputFileChangeEventArgs e) {
        pdfDerivaciones = e.File;
    }
    private void HandleZipSelected(InputFileChangeEventArgs e) {
        zipTelefonos = e.File;
    }
    
    private async Task ProcesarArchivosBot()
    {
        if (pdfDerivaciones == null || zipTelefonos == null) return;
        
        isUploading = true;
        uploadMessage = "";
        StateHasChanged();
        
        try
        {
            var content = new MultipartFormDataContent();
            
            // max file size 50MB
            long maxFileSize = 1024 * 1024 * 50; 
            
            var pdfContent = new StreamContent(pdfDerivaciones.OpenReadStream(maxFileSize));
            pdfContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(pdfDerivaciones.ContentType);
            content.Add(pdfContent, "pdfFile", pdfDerivaciones.Name);
            
            var zipContent = new StreamContent(zipTelefonos.OpenReadStream(maxFileSize));
            zipContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(zipTelefonos.ContentType);
            content.Add(zipContent, "zipFile", zipTelefonos.Name);

            var response = await Http.PostAsync("api/BotDerivaciones/upload", content);
            var resultStr = await response.Content.ReadAsStringAsync();
            
            if (response.IsSuccessStatusCode)
            {
                uploadSuccess = true;
                uploadMessage = "¡Archivos procesados correctamente! ";
                pdfDerivaciones = null;
                zipTelefonos = null;
            }
            else
            {
                uploadSuccess = false;
                uploadMessage = "Error al procesar: " + resultStr;
            }
        }
        catch (Exception ex)
        {
            uploadSuccess = false;
            uploadMessage = "Ocurrio un error inesperado: " + ex.Message;
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private IBrowserFile excelBot;
    private List<string> pacientesSinTelefono = new List<string>();

    private void HandleExcelSelected(InputFileChangeEventArgs e)
    {
        excelBot = e.File;
    }

    private async Task ProcesarExcelBot()
    {
        if (excelBot == null) return;
        
        isUploading = true;
        uploadMessage = "";
        pacientesSinTelefono.Clear();
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            var excelStream = excelBot.OpenReadStream(maxAllowedSize: 104857600); 
            var excelContent = new StreamContent(excelStream);
            excelContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(excelBot.ContentType);
            content.Add(excelContent, "excelFile", excelBot.Name);

            var response = await Http.PostAsync("api/BotDerivaciones/upload-excel", content);
            var responseString = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                uploadSuccess = true;
                
                try {
                    var jsonResponse = System.Text.Json.JsonDocument.Parse(responseString);
                    uploadMessage = jsonResponse.RootElement.GetProperty("message").GetString();
                    
                    if (jsonResponse.RootElement.TryGetProperty("sinTelefono", out var stElement))
                    {
                        foreach(var item in stElement.EnumerateArray()) {
                            pacientesSinTelefono.Add(item.GetString());
                        }
                    }
                } catch {
                    uploadMessage = responseString;
                }
                
                excelBot = null;
            }
            else
            {
                uploadSuccess = false;
                uploadMessage = "Error: " + responseString;
            }
        }
        catch (Exception ex)
        {
            uploadSuccess = false;
            uploadMessage = "Error en la subida: " + ex.Message;
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private bool isBotRunning = false;
    private string botMessage = "";

        public class BotConfigDto {
        public int DiasAnticipacion { get; set; } = 7;
        public int DiasMaximos { get; set; } = 14;
        public string EspecialidadesStandby { get; set; } = "";
    }
    
    private int diasAnticipacion = 7;
    private int diasMaximos = 14;
    private string configMessage = "";

    private BotConfigDto botConfig = new();
    private List<string> todasEspecialidadesBot = new();
    private bool cargandoEspecialidadesBot = false;
    private bool showConfigSaved = false;
    private string configBotError = "";
    private bool configLeida = false;

    private async Task CargarConfigBot()
    {
        cargandoEspecialidadesBot = true;
        configBotError = "";
        try
        {
            var conf = await Http.GetFromJsonAsync<BotConfigDto>("api/BotDerivaciones/config");
            if (conf != null)
            {
                botConfig = conf;
                diasAnticipacion = conf.DiasAnticipacion;
                diasMaximos = conf.DiasMaximos;
                configLeida = true;
            }
        }
        catch (Exception ex)
        {
            configLeida = false;
            configBotError = "No se pudo leer la configuración del bot: " + ex.Message;
        }

        try
        {
            var stats = await Http.GetFromJsonAsync<List<LaboratorioFront.Shared.BotDashboardTab.BotStat>>("api/BotDashboard/stats") ?? new();
            var desdeStats = stats.Select(s => s.Especialidad).Where(e => !string.IsNullOrEmpty(e)).Distinct().ToList();

            var listaFinal = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var esp in desdeStats) listaFinal.Add(esp);
            if (especialidades != null)
            {
                foreach (var esp in especialidades) listaFinal.Add(esp);
            }
            todasEspecialidadesBot = listaFinal.OrderBy(e => e).ToList();
        }
        catch
        {
            if (especialidades != null && especialidades.Any())
            {
                todasEspecialidadesBot = especialidades.OrderBy(e => e).ToList();
            }
        }
        finally
        {
            cargandoEspecialidadesBot = false;
            StateHasChanged();
        }
    }

    private bool EstaPausada(string especialidad)
    {
        return (botConfig.EspecialidadesStandby ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(s => s.Trim().Equals(especialidad.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnStandbyChanged(string especialidad, object? isCheckedObj)
    {
        if (!configLeida)
        {
            configBotError = "La configuración no está cargada; recarga la página antes de cambiarla.";
            return;
        }

        bool isEnabled = (bool)(isCheckedObj ?? false);
        var standbyList = (botConfig.EspecialidadesStandby ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();

        if (isEnabled) {
            standbyList.RemoveAll(s => s.Equals(especialidad.Trim(), StringComparison.OrdinalIgnoreCase));
        } else {
            if (!standbyList.Any(s => s.Equals(especialidad.Trim(), StringComparison.OrdinalIgnoreCase))) {
                standbyList.Add(especialidad.Trim());
            }
        }

        configBotError = "";
        try
        {
            var response = await Http.PostAsJsonAsync("api/BotDerivaciones/config", new { EspecialidadesStandby = string.Join(",", standbyList) });
            if (!response.IsSuccessStatusCode)
            {
                configBotError = "No se pudo guardar: " + await response.Content.ReadAsStringAsync();
                return;
            }
            botConfig = await response.Content.ReadFromJsonAsync<BotConfigDto>() ?? botConfig;
        }
        catch (Exception ex)
        {
            configBotError = "No se pudo guardar: " + ex.Message;
            return;
        }

        showConfigSaved = true;
        StateHasChanged();
        await Task.Delay(2000);
        showConfigSaved = false;
        StateHasChanged();
    }

    private async Task HabilitarTodasEspecialidades()
    {
        configBotError = "";
        try
        {
            var response = await Http.PostAsJsonAsync("api/BotDerivaciones/config", new { EspecialidadesStandby = "" });
            if (!response.IsSuccessStatusCode)
            {
                configBotError = "No se pudo habilitar todas: " + await response.Content.ReadAsStringAsync();
                return;
            }
            botConfig.EspecialidadesStandby = "";
            showConfigSaved = true;
            StateHasChanged();
            await Task.Delay(2000);
            showConfigSaved = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            configBotError = "Error al habilitar todas: " + ex.Message;
        }
    }

    private async Task DeshabilitarTodasEspecialidades()
    {
        configBotError = "";
        try
        {
            var todas = string.Join(",", todasEspecialidadesBot ?? new List<string>());
            var response = await Http.PostAsJsonAsync("api/BotDerivaciones/config", new { EspecialidadesStandby = todas });
            if (!response.IsSuccessStatusCode)
            {
                configBotError = "No se pudo deshabilitar todas: " + await response.Content.ReadAsStringAsync();
                return;
            }
            botConfig.EspecialidadesStandby = todas;
            showConfigSaved = true;
            StateHasChanged();
            await Task.Delay(2000);
            showConfigSaved = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            configBotError = "Error al deshabilitar todas: " + ex.Message;
        }
    }

