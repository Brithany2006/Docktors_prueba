            private async Task AbrirModalAgendar(Derivacion d, bool esSubsecuente = false, int preselectDoctorId = 0)
    {
        esEdicion = false;
        esSubsecuenteAgendar = esSubsecuente;
        derivacionseleccionada = d;
        doctoresAMostrar = doctores ?? new();
        
        var docMatching = doctoresAMostrar.FirstOrDefault(doc => CoincideEspecialidad(doc.Especialidad, d.EspecialidadRequerida));
        if (docMatching != null) {
            sucursalseleccionada = docMatching.Sucursal;
        } else if (doctoresAMostrar.Count > 0) { 
            sucursalseleccionada = doctoresAMostrar.First().Sucursal; 
        }

        idDoctorSeleccionado = 0;
        slotsDisponibles = null;
        slotSeleccionado = null;
        diaSeleccionado = null;
        mostrarModal = true;
        
        if (preselectDoctorId > 0 && doctoresAMostrar.Any(doc => doc.Id == preselectDoctorId)) {
            var elDoc = doctoresAMostrar.First(doc => doc.Id == preselectDoctorId);
            sucursalseleccionada = elDoc.Sucursal;
            idDoctorSeleccionado = elDoc.Id;
            await AlCambiarDoctor();
        } else {
            var docsValidos = doctoresAMostrar.Where(doc => CoincideEspecialidad(doc.Especialidad, d.EspecialidadRequerida) && doc.Sucursal == sucursalseleccionada).ToList();
            if (docsValidos.Count == 1) {
                idDoctorSeleccionado = docsValidos.First().Id;
                await AlCambiarDoctor();
            }
        }
        StateHasChanged();
    }

