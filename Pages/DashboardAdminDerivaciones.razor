    private async Task ConfirmarCita()
    {
        if(derivacionseleccionada != null && !string.IsNullOrEmpty(slotSeleccionado) && diaSeleccionado != null)
        {
            var span = TimeSpan.Parse(slotSeleccionado);
            var dtTime = DateTime.Parse(diaSeleccionado.Fecha).Add(span);
            
            var payload = new DerivacionesService.CitaDerivacion {
                IdDoctor = idDoctorSeleccionado,
                IdDerivacion = derivacionseleccionada.Id,
                FechaHora = dtTime,
                EsSubsecuente = esSubsecuenteAgendar,
                EsTurnoExtra = esTurnoExtra,
                Estado = "Pendiente"
            };
            
            if (esEdicion)
            {
                var result = await Service.EditarCitaAsync(citaEditandoId, payload);
                if (result.Exito)
                {
                    mostrarModal = false;
                    await Cargardatos();
                    await JS.InvokeVoidAsync("alert", "Cita actualizada correctamente.");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Error: " + result.Mensaje);
                }
            }
            else
            {
                var result = await Service.AgendarCitaAsync(payload);
                if (result.Exito)
                {
                    mostrarModal = false;
                    await Cargardatos();
                    if (currentTab == "subsecuentes")
                    {
                        await CargarSinSubsecuente();
                        if (subAgendadosServer != null)
                        {
                            await CargarSubAgendados();
                        }
                    }
                    await JS.InvokeVoidAsync("alert", "Cita agendada correctamente.");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", result.Mensaje);
                }
            }
        }
    }
