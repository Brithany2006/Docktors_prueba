      private async Task CargarEstadoBot()
    {
        isLoadingBotState = true;
        StateHasChanged();
        
        try
        {
            string url = "api/BotDerivaciones/pendientes?";
            // Al buscar un paciente se ignora la fecha de la tanda: se busca en toda la tabla
            if (filtroBotFecha.HasValue && string.IsNullOrWhiteSpace(filtroBotBuscar)) url += "fecha=" + filtroBotFecha.Value.ToString("yyyy-MM-dd") + "&";
            if (!string.IsNullOrWhiteSpace(filtroBotBuscar)) url += "buscar=" + Uri.EscapeDataString(filtroBotBuscar.Trim()) + "&";
            if (!string.IsNullOrEmpty(filtroBotEstado)) url += "estado=" + filtroBotEstado + "&";
            if (filtroBotDoctorId > 0) url += "idDoctor=" + filtroBotDoctorId + "&";

            botDerivaciones = await Http.GetFromJsonAsync<List<BotDerivacionDTO>>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando estado bot: " + ex.Message);
        }
        finally
        {
            isLoadingBotState = false;
            StateHasChanged();
        }
