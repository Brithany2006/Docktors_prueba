    protected override async Task OnInitializedAsync()
    {
        try {
            var token = await JS.InvokeAsync<string>("laboratorio.getToken");
            if (!string.IsNullOrEmpty(token)) {
                var partes = token.Split('.');
                if (partes.Length > 1) {
                    var base64 = partes[1];
                    switch (base64.Length % 4) { case 2: base64 += "=="; break; case 3: base64 += "="; break; }
                    var bytes = Convert.FromBase64String(base64);
                    var payloadJson = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(bytes);
                    currentRole = payloadJson?.FirstOrDefault(x => x.Key.Equals("role", StringComparison.OrdinalIgnoreCase)).Value?.ToString() ?? "";
                    if (currentRole.ToLower() == "ekgmed" || currentRole == "EKGMD") {
                        nuevaDerivacion.EspecialidadRequerida = "ELECTROCARDIOGRAMA";
                    }
                }
            }
        } catch {}
        await Cargardatos();
    }

