        }
        if (string.IsNullOrWhiteSpace(nuevaDerivacion.CodigoValidacion))
        {
            await JS.InvokeVoidAsync("alert", "El Codigo de Validacion es obligatorio.");
            return;
        }
        
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Esta seguro que desea guardar la Derivacion para el paciente {nuevoPaciente.NombreCompleto}?");
        if (!confirmed) return;

        if (nuevoPaciente.Id == 0)
        {
            var p = await Service.CreatePacienteAsync(nuevoPaciente);
            if (p != null) nuevoPaciente = p;
        }

        nuevaDerivacion.IdPaciente = nuevoPaciente.Id;
        var result = await Service.CreateDerivacionAsync(nuevaDerivacion);
        if (result != null)
        {
            nuevoPaciente = new();
