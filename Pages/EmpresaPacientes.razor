@page "/empresa-pacientes/{Ruc}"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LaboratorioFront.Services.ApiService Api
<PageTitle>Pacientes de la empresa | Centro Médico Klinic</PageTitle>

<div class="admin-content">
    <button class="btn-secondary mb-3" @onclick="@(() => Nav.NavigateTo("/dashboard-admin"))">← Volver a Usuarios</button>

    @if (loading)
    {
        <p>Cargando...</p>
    }
    else if (!isAdmin)
    {
        <p>No tienes permisos para acceder a esta pagina.</p>
    }
    else
    {
        <div class="admin-card">
            <h4>👥 Pacientes de la empresa (RUC: @Ruc)</h4>

            @if (pacientesLoading)
            {
                <p>Cargando pacientes...</p>
            }
            else if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-info mt-2">@mensaje</div>
            }

            @if (!pacientesLoading && respuesta is not null)
            {
                @if (!respuesta.Pacientes.Any())
                {
                    <p>Esta empresa no tiene pacientes registrados.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th style="width:1%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in respuesta.Pacientes)
                            {
                                <tr>
                                    <td>@p.Id</td>
                                    <td>
                                        @if (editandoId == p.Id)
                                        {
                                            <input class="input-text" @bind="nombreEdicion" />
                                        }
                                        else
                                        {
                                            @p.NombreCompleto
                                        }
                                    </td>
                                    <td>
                                        @if (editandoId == p.Id)
                                        {
                                            <button class="btn-primary" @onclick="@(() => GuardarNombre(p.Id))">💾</button>
                                            <button class="btn-secondary" @onclick="CancelarEdicion">✖</button>
                                        }
                                        else
                                        {
                                            <button class="btn-secondary" @onclick="@(() => IniciarEdicion(p))">✏ Editar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="form-row mt-3" style="align-items:center; gap:.75rem;">
                        <button class="btn-secondary" disabled="@(paginaActual <= 1)" @onclick="@(() => IrAPagina(paginaActual - 1))">← Anterior</button>
                        <span>Pagina @respuesta.Pagina de @respuesta.TotalPaginas (@respuesta.TotalRegistros pacientes)</span>
                        <button class="btn-secondary" disabled="@(paginaActual >= respuesta.TotalPaginas)" @onclick="@(() => IrAPagina(paginaActual + 1))">Siguiente →</button>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Ruc { get; set; } = string.Empty;

    private bool loading = true;
    private bool isAdmin = false;
    private bool pacientesLoading = false;
    private string mensaje = string.Empty;

    private int paginaActual = 1;
    private const int TamanoPagina = 20;

    private PacientesEmpresaResponse? respuesta;

    private int? editandoId = null;
    private string nombreEdicion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("laboratorio.getToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        var payload = ParseJwt(token);
        var roleClaim = payload.FirstOrDefault(x => x.Key.Equals("role",
            StringComparison.OrdinalIgnoreCase)).Value?.ToString();

        isAdmin = roleClaim == "Admin";
        if (!isAdmin)
        {
            Nav.NavigateTo("/", true);
            return;
        }

        loading = false;
        await CargarPagina(1);
    }

    private async Task CargarPagina(int pagina)
    {
        pacientesLoading = true;
        mensaje = string.Empty;
        StateHasChanged();

        try
        {
            var res = await Api.Http.GetAsync($"admin/empresas/{Ruc}/pacientes?pagina={pagina}&tamanoPagina={TamanoPagina}");
            if (res.IsSuccessStatusCode)
            {
                var json = await res.Content.ReadAsStringAsync();
                respuesta = System.Text.Json.JsonSerializer.Deserialize<PacientesEmpresaResponse>(
                    json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                paginaActual = pagina;
            }
            else
            {
                mensaje = $"❌ {await res.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"❌ Error al cargar pacientes: {ex.Message}";
        }
        finally
        {
            pacientesLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task IrAPagina(int pagina)
    {
        editandoId = null;
        await CargarPagina(pagina);
    }

    private void IniciarEdicion(PacientePaginadoItem p)
    {
        editandoId = p.Id;
        nombreEdicion = p.NombreCompleto;
        mensaje = string.Empty;
    }

    private void CancelarEdicion()
    {
        editandoId = null;
        nombreEdicion = string.Empty;
    }

    private async Task GuardarNombre(int id)
    {
        if (string.IsNullOrWhiteSpace(nombreEdicion))
        {
            mensaje = "⚠ El nombre no puede estar vacio.";
            return;
        }

        var res = await Api.Http.PostAsJsonAsync($"admin/pacientes/{id}/editar", new { NombreCompleto = nombreEdicion });
        if (res.IsSuccessStatusCode)
        {
            var paciente = respuesta?.Pacientes.FirstOrDefault(x => x.Id == id);
            if (paciente is not null)
                paciente.NombreCompleto = nombreEdicion.Trim();

            editandoId = null;
            mensaje = "✅ Nombre actualizado correctamente.";
        }
        else
        {
            mensaje = $"❌ {await res.Content.ReadAsStringAsync()}";
        }
    }

    private Dictionary<string, object> ParseJwt(string token)
    {
        var parts = token.Split('.');
        if (parts.Length != 3) return new();

        var payload = parts[1];
        payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
        var jsonBytes = Convert.FromBase64String(payload.Replace('-', '+').Replace('_', '/'));
        var json = System.Text.Encoding.UTF8.GetString(jsonBytes);
        return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json) ?? new();
    }

    public class PacientePaginadoItem
    {
        public int Id { get; set; }
        public string NombreCompleto { get; set; } = string.Empty;
        public string Normalizado { get; set; } = string.Empty;
    }

    public class PacientesEmpresaResponse
    {
        public string Ruc { get; set; } = string.Empty;
        public int Pagina { get; set; }
        public int TamanoPagina { get; set; }
        public int TotalRegistros { get; set; }
        public int TotalPaginas { get; set; }
        public List<PacientePaginadoItem> Pacientes { get; set; } = new();
    }
}
