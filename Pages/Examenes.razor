@page "/pacientes/pdf/{NombreCompleto}"
@inject LaboratorioFront.Services.ApiService Api
@inject NavigationManager Nav

<h3>PDF del paciente</h3>

@if (loading)
{
    <p>Cargando PDF...</p>
}
else if (string.IsNullOrEmpty(base64Pdf))
{
    <p>No se encontro el PDF</p>
}
else
{
    <iframe src="data:application/pdf;base64,@base64Pdf" width="100%" height="600px"></iframe>
}

<button class="btn btn-secondary mt-3" @onclick="Volver">Volver</button>

@code {
    [Parameter] public string NombreCompleto { get; set; } = string.Empty;

    private string base64Pdf = string.Empty;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(NombreCompleto))
        {
            try
            {
                base64Pdf = await Api.GetPdfBase64PorApellidosAsync(NombreCompleto);
            }
            catch
            {
                base64Pdf = string.Empty;
            }
        }
        loading = false;
    }

    private void Volver()
    {
        Nav.NavigateTo("/pacientes");
    }
}
