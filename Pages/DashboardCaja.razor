    private string currentSucursal = "Centro";

    private DateTime agendaFecha = DateTime.Today;
    private int agendaDoctorId = 0;
    private bool isLoadingAgenda = false;
    private List<LaboratorioFront.Services.DerivacionesService.CitaDerivacionResponse> agendaCitas = null;
    private List<LaboratorioFront.Services.DerivacionesService.SlotAgenda> agendaSlots = new();
    private List<LaboratorioFront.Services.Doctor> doctores = new();

    private record FilaAgenda(string Hora, LaboratorioFront.Services.DerivacionesService.CitaDerivacionResponse? Cita, string Tipo);

    // Citas del dia mezcladas con los turnos libres del horario del doctor: "libre" si aun se puede dar, "sinturno" si la hora ya paso
    private List<FilaAgenda> FilasAgenda()
    {
        var filas = new List<FilaAgenda>();
        foreach (var c in agendaCitas ?? new()) filas.Add(new FilaAgenda(c.FechaHora.ToString("HH:mm"), c, "cita"));
        foreach (var s in agendaSlots.Where(s => s.Libre)) filas.Add(new FilaAgenda(s.Hora, null, s.Pasado ? "sinturno" : "libre"));
        return filas.OrderBy(f => f.Hora, StringComparer.Ordinal).ThenBy(f => f.Cita == null ? 1 : 0).ToList();
    }

    // Medicos de turno: tienen horario laborable en la fecha elegida y no tienen un dia libre registrado
    private IEnumerable<LaboratorioFront.Services.Doctor> DoctoresDeTurno => doctores.Where(d => d.EstaDeTurno(agendaFecha));

    private void OnAgendaFechaCambiada()
    {
        if (agendaDoctorId > 0 && !DoctoresDeTurno.Any(d => d.Id == agendaDoctorId))
        {
            agendaDoctorId = 0;
            agendaCitas = null;
        }
    }

    private async Task CargarAgenda()
    {
        if (agendaDoctorId <= 0) return;
        isLoadingAgenda = true;
        StateHasChanged();
        
        try
        {
            var result = await DerivService.GetCitasPaginadasAsync(1, 500, "", "", agendaFecha, agendaDoctorId);
            if (result != null && result.Data != null)
            {
                agendaCitas = result.Data.OrderBy(c => c.FechaHora).ToList();
            }
            // Si falla, la agenda sigue mostrando solo las citas
            try { agendaSlots = await DerivService.GetAgendaSlotsAsync(agendaDoctorId, agendaFecha); }
            catch (Exception ex) { agendaSlots = new(); Console.WriteLine("Error cargando turnos libres: " + ex.Message); }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando agenda: " + ex.Message);
        }
        finally
        {
            isLoadingAgenda = false;
            StateHasChanged();
        }
    }


    protected override async Task OnInitializedAsync()
    {
        try {
            var token = await JSRuntime.InvokeAsync<string>("laboratorio.getToken");
            if (!string.IsNullOrEmpty(token))
            {
                var payload = token.Split('.')[1];
                var jsonBytes = ParseBase64WithoutPadding(payload);
                var keyValuePairs = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                if (keyValuePairs != null && keyValuePairs.TryGetValue("RUC", out var rucObj))
                {
                    string ruc = rucObj.ToString()?.ToLower() ?? "";
                    if (ruc == "milan" || ruc == "adminmilan" || ruc == "cajamilan" || (keyValuePairs.TryGetValue("Sucursal", out var sucObj) && string.Equals(sucObj?.ToString(), "Milan", StringComparison.OrdinalIgnoreCase)))
                    {
                        currentSucursal = "Milan";
                    }
                }
            }
        } catch { }

        await CargarPacientes();
        try { doctores = await DerivService.GetDoctoresAsync(); } catch { }
    }

    private byte[] ParseBase64WithoutPadding(string base64)
    {
        switch (base64.Length % 4)
        {
            case 2: base64 += "=="; break;
            case 3: base64 += "="; break;
        }
        return Convert.FromBase64String(base64);
    }

