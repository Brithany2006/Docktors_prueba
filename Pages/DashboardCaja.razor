    private async Task Activar(DerivacionesService.NoConfirmoItem item)
    {
        activandoId = item.IdBot;
        try
        {
            var (derivacion, mensaje) = await DerivService.PrepararNoConfirmoAsync(item.IdBot);
            if (derivacion == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error: " + mensaje);
                return;
            }
            sucursalActivar = item.Sede != null && item.Sede.IndexOf("MILAN", StringComparison.OrdinalIgnoreCase) >= 0 ? "Milan" : "Centro";
            idBotActivar = item.IdBot;
            derivacionActivar = derivacion;
        }
        finally
        {
            activandoId = null;
        }
    }

