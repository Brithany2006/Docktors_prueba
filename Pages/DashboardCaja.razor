                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto rounded-xl border border-gray-200">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-purple-50 text-purple-900 border-b border-purple-200">
                                    <tr>
                                        <th class="px-6 py-4 font-bold text-sm">Hora</th>
                                        <th class="px-6 py-4 font-bold text-sm">Paciente</th>
                                        <th class="px-6 py-4 font-bold text-sm">Cédula</th>
                                        <th class="px-6 py-4 font-bold text-sm">Especialidad</th>
                                        <th class="px-6 py-4 font-bold text-sm">Fecha del código</th>
                                        <th class="px-6 py-4 font-bold text-sm">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fila in filas)
                                    {
                                        @if (fila.Cita == null)
                                        {
                                            bool libre = fila.Tipo == "libre";
                                            <tr class="border-b border-gray-100 @(libre ? "bg-emerald-50" : "")">
                                                <td class="px-6 py-3 text-sm font-bold @(libre ? "text-gray-800" : "text-gray-500")">@fila.Hora</td>
                                                <td class="px-6 py-3 text-sm" colspan="5">
                                                    @if (libre)
                                                    {
                                                        <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">Disponible</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-gray-500">Sin turno</span>
                                                    }
                                                </td>
                                            </tr>
                                            continue;
                                        }
                                        var cita = fila.Cita;
                                        <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                            <td class="px-6 py-4 text-sm font-bold text-gray-800">@cita.FechaHora.ToString("HH:mm")</td>
                                            <td class="px-6 py-4 text-sm text-gray-600">@(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")<LaboratorioFront.Pages.Componentes.BadgeTipoPaciente Tipo="@cita.Derivacion?.TipoPaciente" Origen="@cita.Derivacion?.Origen" /></td>
                                            <td class="px-6 py-4 text-sm text-gray-600">@(cita.Derivacion?.Paciente?.Cedula ?? "N/A")</td>
                                            <td class="px-6 py-4 text-sm text-gray-600">@(cita.Derivacion?.EspecialidadRequerida ?? "N/A")</td>
                                            <td class="px-6 py-4 text-sm text-gray-600">@(cita.Derivacion != null ? cita.Derivacion.FechaEmision.ToString("dd/MM/yyyy") : "N/A")</td>
                                            <td class="px-6 py-4">
                                                @if (cita.Estado == "Pendiente")
                                                {
                                                    <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-xs font-bold">Pendiente</span>
                                                }
                                                else
                                                {
                                                    <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-xs font-bold">@cita.Estado</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        
        </div>
