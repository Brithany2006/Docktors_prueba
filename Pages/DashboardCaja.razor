    private void AbrirModalCrear()
    {
        editando = false;
        idEditando = 0;
        fechaNacimiento = null;
        
        model = new CrearPacienteParticularDto
        {
            Password = ""
        };
        mensajeModal = "";
        mostrarModal = true;
    }

    private void AbrirModalEditar(PacienteParticularListItem p)
    {
        editando = true;
        idEditando = p.IdUsuarioPaciente;
        model = new CrearPacienteParticularDto
        {
            NombreCompleto = p.NombreCompleto,
            Cedula = p.Cedula,
            Telefono = p.Telefono,
            Password = "" // blank to not change
        };
        mensajeModal = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarPaciente()
    {
        mensajeModal = "";
        if (string.IsNullOrWhiteSpace(model.NombreCompleto) || string.IsNullOrWhiteSpace(model.Cedula))
        {
            mensajeModal = "Nombre y cédula son requeridos.";
            esErrorModal = true;
            return;
        }

        HttpResponseMessage response;
        if (editando)
        {
            response = await Api.Http.PostAsJsonAsync($"caja/editar-paciente-particular/{idEditando}", model);
        }
        else
        {
            if (fechaNacimiento == null)
            {
                mensajeModal = "La fecha de nacimiento es requerida.";
                esErrorModal = true;
                return;
            }
            
            model.Password = fechaNacimiento.Value.ToString("ddMMyyyy");
            response = await Api.Http.PostAsJsonAsync("caja/crear-paciente-particular", model);
        }

        if (response.IsSuccessStatusCode)
        {
            await CargarPacientes();
            CerrarModal();
            await MostrarToast(editando ? "Paciente actualizado" : "Paciente creado", true);
        }
        else
        {
            esErrorModal = true;
            var error = await response.Content.ReadAsStringAsync();
            mensajeModal = error;
        }
    }

    private async Task EliminarPaciente(int id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { "¿Estás seguro de eliminar este paciente?" });
        if (!confirm) return;

        var response = await Api.Http.PostAsync($"caja/eliminar-paciente-particular/{id}", null);
        if (response.IsSuccessStatusCode)
        {
            await CargarPacientes();
            await MostrarToast("Paciente eliminado", true);
        }
        else
        {
            await MostrarToast("Error al eliminar", false);
        }
    }

