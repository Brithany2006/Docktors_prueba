@page "/dashboard-caja"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Caja,UsuarioCaja,CajaCitas")]
@using LaboratorioFront.Services
@using LaboratorioFront.Services.Models
@using System.Text.Json
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject LaboratorioFront.Services.ApiService Api
@inject DerivacionesService DerivService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<div class="min-h-screen bg-gray-50 flex flex-col font-sans">
    <div class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex space-x-8">
                <button @onclick="() => SetTab(1)" class="@((activeTab == 1) ? "border-turquesa-500 text-turquesa-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-calendar-check"></i> Citas de Derivaciones
                </button>
                <button @onclick="() => SetTab(2)" class="@((activeTab == 2) ? "border-turquesa-500 text-turquesa-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-calendar-days"></i> Agenda de Doctores
                </button>
                <button @onclick="() => SetTab(3)" class="@((activeTab == 3) ? "border-turquesa-500 text-turquesa-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-person-walking-arrow-right"></i> Registro de pacientes
                </button>
            </div>
        </div>
    </div>
@if (activeTab == 1)
    {
        <div class="w-full animate-fade-in">

<div class="min-h-screen bg-gray-50 flex flex-col font-sans">
    <header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-turquesa-600 rounded-lg flex items-center justify-center shadow-lg shadow-turquesa-200">
                    <i class="fa-solid fa-calendar-check text-white text-xl"></i>
                </div>
                <h1 class="text-xl font-bold text-gray-800">Visualización de Citas</h1>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm font-medium text-gray-600">
                    <i class="fa-regular fa-calendar text-turquesa-500 mr-2"></i> @DateTime.Now.ToString("dd MMMM yyyy")
                </span>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="relative flex-1">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-search text-gray-400"></i>
                    </div>
                    <input type="text" @bind="searchQueryCitas" @onkeyup="BuscarEnter" placeholder="Buscar por paciente, doctor, cédula... (Presiona Enter)" class="block w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 sm:text-sm transition-colors shadow-sm">
                    <div class="absolute inset-y-0 right-0 pr-2 flex items-center">
                        <button @onclick="EjecutarBusqueda" class="p-2 text-turquesa-600 hover:text-turquesa-800 transition-colors bg-turquesa-50 rounded-md">
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
                
            </div>
        </div>

        @if (citasLoading)
        {
            <div class="flex justify-center items-center py-12">
                <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-turquesa-600"></div>
                <span class="ml-4 text-turquesa-600 font-semibold text-lg">Cargando citas...</span>
            </div>
        }
        else if (busquedaRealizadaCitas && !citasDeriv.Any())
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center text-gray-500">
                <i class="fa-regular fa-calendar-xmark text-5xl mb-4 text-gray-300"></i>
                <p class="text-lg">No se encontraron citas para los criterios de búsqueda.</p>
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Fecha / Hora</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Paciente</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Doctor</th>
                                @if (currentSucursal == "Milan")
                                {
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Sucursal</th>
                                }
                                else
                                {
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Consultorio / Sucursal</th>
                                }
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Estado</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var cita in citasDeriv)
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-semibold text-gray-900">@cita.FechaHora.ToString("dd/MM/yyyy")</div>
                                        <div class="text-sm text-turquesa-600 font-bold">@cita.FechaHora.ToString("HH:mm")</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-bold text-gray-900">@(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")</div>
                                        <div class="text-xs text-gray-500">C.I: @(cita.Derivacion?.Paciente?.Cedula ?? "N/A")</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-semibold text-gray-800">@Etiquetas.Doctor(cita.Doctor?.Nombre ?? "N/A")</div>
                                        <div class="text-xs text-gray-500">@Etiquetas.Doctor(cita.Derivacion?.EspecialidadRequerida ?? cita.Doctor?.Especialidad ?? "N/A")</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (currentSucursal != "Milan")
                                        {
                                            <div class="text-sm font-semibold text-gray-800">@(cita.Doctor?.Consultorio ?? "N/A")</div>
                                        }
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                            @(cita.Doctor?.Sucursal ?? "Centro")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (cita.Estado == "Pendiente")
                                        {
                                            <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-xs font-bold border border-yellow-200">Pendiente</span>
                                        }
                                        else if (cita.Estado == "Atendido")
                                        {
                                            <span class="px-3 py-1 rounded-full bg-green-100 text-green-800 text-xs font-bold border border-green-200">Atendido</span>
                                        }
                                        else
                                        {
                                            <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-xs font-bold border border-gray-200">@cita.Estado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>
</div>


        </div>
    }@if (activeTab == 2)
    {
        <div class="w-full animate-fade-in px-4 sm:px-6 lg:px-8 py-8">
            
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Agenda Diaria de Doctores</h2>
                <div class="mb-6 bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col md:flex-row gap-4 items-end">
                    <div class="flex-1">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Fecha:</label>
                        <input type="date" @bind="agendaFecha" @bind:after="OnAgendaFechaCambiada" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none" />
                    </div>
                    <div class="flex-1">
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Doctor:</label>
                        <select @bind="agendaDoctorId" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none">
                            <option value="0">-- Seleccionar Doctor de turno --</option>
                            @foreach (var doc in DoctoresDeTurno)
                            {
                                <option value="@doc.Id">@Etiquetas.Doctor(doc.Nombre) (@Etiquetas.Doctor(doc.Especialidad))</option>
                            }
                        </select>
                    </div>
                    <div>
                        <button @onclick="CargarAgenda" class="px-6 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-bold transition-colors shadow-sm flex items-center gap-2">
                            <i class="fa-solid fa-search"></i> Ver Agenda
                        </button>
                    </div>
                </div>

                @if (isLoadingAgenda)
                {
                    <div class="flex justify-center items-center py-12 text-purple-600">
                        <i class="fa-solid fa-spinner fa-spin text-3xl"></i>
                    </div>
                }
                else if (agendaCitas != null)
                {
                    @if (agendaCitas.Count == 0)
                    {
                        <div class="text-center py-12 text-gray-500">
                            <i class="fa-regular fa-calendar-xmark text-4xl mb-3"></i>
                            <p>El doctor no tiene citas agendadas para esta fecha.</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto rounded-xl border border-gray-200">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-purple-50 text-purple-900 border-b border-purple-200">
                                    <tr>
                                        <th class="px-6 py-4 font-bold text-sm">Hora</th>
                                        <th class="px-6 py-4 font-bold text-sm">Paciente</th>
                                        <th class="px-6 py-4 font-bold text-sm">Cédula</th>
                                        <th class="px-6 py-4 font-bold text-sm">Especialidad</th>
                                        <th class="px-6 py-4 font-bold text-sm">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in agendaCitas)
                                    {
                                        <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                                            <td class="px-6 py-4 text-sm font-bold text-gray-800">@cita.FechaHora.ToString("HH:mm")</td>
                                            <td class="px-6 py-4 text-sm text-gray-600">@(cita.Derivacion?.Paciente?.NombreCompleto ?? "N/A")</td>
                                            <td class="px-6 py-4 text-sm text-gray-600">@(cita.Derivacion?.Paciente?.Cedula ?? "N/A")</td>
                                            <td class="px-6 py-4 text-sm text-gray-600">@(cita.Derivacion?.EspecialidadRequerida ?? "N/A")</td>
                                            <td class="px-6 py-4">
                                                @if (cita.Estado == "Pendiente")
                                                {
                                                    <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-800 text-xs font-bold">Pendiente</span>
                                                }
                                                else
                                                {
                                                    <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-xs font-bold">@cita.Estado</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        
        </div>
    }
    @if (activeTab == 3)
    {
        <div class="w-full animate-fade-in pb-12">
            <LaboratorioFront.Pages.Componentes.RegistroWalkinCaja />
        </div>
    }
</div>

@code {

    private List<PacienteParticularListItem> pacientes = new();
    private string filtroPacientes = "";
    private bool cargando = true;
    private Dictionary<int, bool> mostrarPasswords = new();
    private bool sincronizando = false;

    private async Task SincronizarOdoo()
    {
        sincronizando = true;
        StateHasChanged();
        try
        {
            var response = await Api.Http.PostAsync("caja/sync-odoo-particulares", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                var msg = result.GetProperty("message").GetString();
                await JSRuntime.InvokeVoidAsync("alert", msg);
                await CargarPacientes();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al sincronizar con Odoo.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            sincronizando = false;
            StateHasChanged();
        }
    }

    private bool mostrarModal = false;
    private bool editando = false;
    private int idEditando = 0;
    private CrearPacienteParticularDto model = new();
    private DateTime? fechaNacimiento = null;
    private string mensajeModal = "";
    private bool esErrorModal = false;

    private IEnumerable<PacienteParticularListItem> PacientesFiltrados => string.IsNullOrWhiteSpace(filtroPacientes)
        ? pacientes
        : pacientes.Where(p => 
            (p.NombreCompleto?.Contains(filtroPacientes, StringComparison.OrdinalIgnoreCase) ?? false) || 
            (p.Cedula?.Contains(filtroPacientes, StringComparison.OrdinalIgnoreCase) ?? false));
    private string currentSucursal = "Centro";

    private DateTime agendaFecha = DateTime.Today;
    private int agendaDoctorId = 0;
    private bool isLoadingAgenda = false;
    private List<LaboratorioFront.Services.DerivacionesService.CitaDerivacionResponse> agendaCitas = null;
    private List<LaboratorioFront.Services.Doctor> doctores = new();

    // Medicos de turno: tienen horario laborable en la fecha elegida y no tienen un dia libre registrado
    private IEnumerable<LaboratorioFront.Services.Doctor> DoctoresDeTurno => doctores.Where(d => d.EstaDeTurno(agendaFecha));

    private void OnAgendaFechaCambiada()
    {
        if (agendaDoctorId > 0 && !DoctoresDeTurno.Any(d => d.Id == agendaDoctorId))
        {
            agendaDoctorId = 0;
            agendaCitas = null;
        }
    }

    private async Task CargarAgenda()
    {
        if (agendaDoctorId <= 0) return;
        isLoadingAgenda = true;
        StateHasChanged();
        
        try
        {
            var result = await DerivService.GetCitasPaginadasAsync(1, 500, "", "", agendaFecha, agendaDoctorId);
            if (result != null && result.Data != null)
            {
                agendaCitas = result.Data.OrderBy(c => c.FechaHora).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando agenda: " + ex.Message);
        }
        finally
        {
            isLoadingAgenda = false;
            StateHasChanged();
        }
    }


    protected override async Task OnInitializedAsync()
    {
        try {
            var token = await JSRuntime.InvokeAsync<string>("laboratorio.getToken");
            if (!string.IsNullOrEmpty(token))
            {
                var payload = token.Split('.')[1];
                var jsonBytes = ParseBase64WithoutPadding(payload);
                var keyValuePairs = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                if (keyValuePairs != null && keyValuePairs.TryGetValue("RUC", out var rucObj))
                {
                    string ruc = rucObj.ToString()?.ToLower() ?? "";
                    if (ruc == "milan" || ruc == "adminmilan" || ruc == "cajamilan")
                    {
                        currentSucursal = "Milan";
                    }
                }
            }
        } catch { }

        await CargarPacientes();
        try { doctores = await DerivService.GetDoctoresAsync(); } catch { }
    }

    private byte[] ParseBase64WithoutPadding(string base64)
    {
        switch (base64.Length % 4)
        {
            case 2: base64 += "=="; break;
            case 3: base64 += "="; break;
        }
        return Convert.FromBase64String(base64);
    }

    private async Task CargarPacientes()
    {
        cargando = true;
        try
        {
            pacientes = await Api.Http.GetFromJsonAsync<List<PacienteParticularListItem>>("caja/pacientes-particulares") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        cargando = false;
    }

    private void TogglePassword(int id)
    {
        if (mostrarPasswords.ContainsKey(id))
            mostrarPasswords[id] = !mostrarPasswords[id];
        else
            mostrarPasswords[id] = true;
    }

    private void AbrirModalCrear()
    {
        editando = false;
        idEditando = 0;
        fechaNacimiento = null;
        
        model = new CrearPacienteParticularDto
        {
            Password = ""
        };
        mensajeModal = "";
        mostrarModal = true;
    }

    private void AbrirModalEditar(PacienteParticularListItem p)
    {
        editando = true;
        idEditando = p.IdUsuarioPaciente;
        model = new CrearPacienteParticularDto
        {
            NombreCompleto = p.NombreCompleto,
            Cedula = p.Cedula,
            Telefono = p.Telefono,
            Password = "" // blank to not change
        };
        mensajeModal = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarPaciente()
    {
        mensajeModal = "";
        if (string.IsNullOrWhiteSpace(model.NombreCompleto) || string.IsNullOrWhiteSpace(model.Cedula))
        {
            mensajeModal = "Nombre y cédula son requeridos.";
            esErrorModal = true;
            return;
        }

        HttpResponseMessage response;
        if (editando)
        {
            response = await Api.Http.PostAsJsonAsync($"caja/editar-paciente-particular/{idEditando}", model);
        }
        else
        {
            if (fechaNacimiento == null)
            {
                mensajeModal = "La fecha de nacimiento es requerida.";
                esErrorModal = true;
                return;
            }
            
            model.Password = fechaNacimiento.Value.ToString("ddMMyyyy");
            response = await Api.Http.PostAsJsonAsync("caja/crear-paciente-particular", model);
        }

        if (response.IsSuccessStatusCode)
        {
            await CargarPacientes();
            CerrarModal();
            await MostrarToast(editando ? "Paciente actualizado" : "Paciente creado", true);
        }
        else
        {
            esErrorModal = true;
            var error = await response.Content.ReadAsStringAsync();
            mensajeModal = error;
        }
    }

    private async Task EliminarPaciente(int id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { "¿Estás seguro de eliminar este paciente?" });
        if (!confirm) return;

        var response = await Api.Http.PostAsync($"caja/eliminar-paciente-particular/{id}", null);
        if (response.IsSuccessStatusCode)
        {
            await CargarPacientes();
            await MostrarToast("Paciente eliminado", true);
        }
        else
        {
            await MostrarToast("Error al eliminar", false);
        }
    }

    private async Task CompartirCredenciales(PacienteParticularListItem p)
    {
        var password = !string.IsNullOrWhiteSpace(p.PasswordPlain) ? p.PasswordPlain : "Su contraseña configurada";
        string msj = $@"Credenciales de Acceso KLINIC
Empresa: PARTICULAR
Usuario / Cédula: {p.Cedula}
Contraseña: {password}

Enlace de acceso: https://doktors.med.ec/";

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", msj);
        await MostrarToast("¡Credenciales copiadas al portapapeles!", true);
    }

    private async Task MostrarToast(string mensaje, bool exito)
    {
        var clase = exito ? "bg-green-500" : "bg-red-500";
        var icono = exito ? "fa-check-circle" : "fa-circle-xmark";
        
        var js = @"
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg text-white opacity-0 transition-opacity duration-300 ' + '" + clase + @"';
            toast.innerHTML = '<i class=""fa-solid " + icono + @"""></i><span class=""font-medium"">" + mensaje + @"</span>';
            container.appendChild(toast);
            
            // Animar entrada
            setTimeout(() => toast.classList.remove('opacity-0'), 10);
            
            // Remover después de 3s
            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        ";
        await JSRuntime.InvokeVoidAsync("eval", js);
    }

    public class PacienteParticularListItem
    {
        public int IdUsuarioPaciente { get; set; }
        public int IdPacienteMaestro { get; set; }
        public string NombreCompleto { get; set; }
        public string Cedula { get; set; }
        public string Telefono { get; set; }
        public string PasswordPlain { get; set; }
    }





    // ==== TABS ====
    private int activeTab = 1;
    private void SetTab(int t) { activeTab = t; StateHasChanged(); }

    // ==== CITAS DERIVACIONES VARIABLES ====
    private List<LaboratorioFront.Services.DerivacionesService.CitaDerivacionResponse> citasDeriv = new List<LaboratorioFront.Services.DerivacionesService.CitaDerivacionResponse>();
    private bool citasLoading = false;
    private string searchQueryCitas = string.Empty;
    private bool busquedaRealizadaCitas = false;

    private async Task BuscarEnter(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EjecutarBusqueda();
        }
    }

    private async Task EjecutarBusqueda()
    {
        if (string.IsNullOrWhiteSpace(searchQueryCitas)) return;
        
        citasLoading = true;
        busquedaRealizadaCitas = true;
        try
        {
            citasDeriv = await DerivService.BuscarCitasAsync(searchQueryCitas);
        }
        catch { }
        finally
        {
            citasLoading = false;
        }
    }
}















