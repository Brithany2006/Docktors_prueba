                                                    <button type="button" @onclick="() => itemAtenderHoy = p" class="px-4 py-2 bg-turquesa-600 hover:bg-turquesa-700 text-white text-sm font-bold rounded-lg shadow whitespace-nowrap" title="Cita manual de hoy como turno extra">
                                                        <i class="fa-solid fa-bolt mr-1"></i> Atender hoy
                                                    </button>
                                                    <button type="button" @onclick="() => Activar(p)" disabled="@(activandoId == p.IdBot)" class="px-4 py-2 bg-white hover:bg-gray-50 text-turquesa-700 border border-turquesa-300 text-sm font-bold rounded-lg shadow-sm disabled:opacity-50 whitespace-nowrap" title="Elegir otro día u horario">
                                                        <i class="fa-regular fa-calendar mr-1"></i> Otro día
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (derivacionActivar != null)
        {
            <LaboratorioFront.Pages.Componentes.AgendarCitaModal Derivacion="derivacionActivar" SucursalInicial="sucursalActivar" IdBot="idBotActivar" OnCerrar="CerrarActivar" OnAgendada="AlAgendarActivado" />
        }
        @if (itemAtenderHoy != null)
        {
            <LaboratorioFront.Pages.Componentes.AtenderHoyModal Item="itemAtenderHoy" OnCerrar="CerrarAtenderHoy" OnActivado="AlActivarHoy" />
        }
    }
</div>

@code {

    private List<PacienteParticularListItem> pacientes = new();
    private string filtroPacientes = "";
    private bool cargando = true;
    private Dictionary<int, bool> mostrarPasswords = new();
    private bool sincronizando = false;

    private async Task SincronizarOdoo()
    {
        sincronizando = true;
        StateHasChanged();
        try
        {
            var response = await Api.Http.PostAsync("caja/sync-odoo-particulares", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                var msg = result.GetProperty("message").GetString();
                await JSRuntime.InvokeVoidAsync("alert", msg);
                await CargarPacientes();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al sincronizar con Odoo.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            sincronizando = false;
            StateHasChanged();
        }
    }

    private bool mostrarModal = false;
    private bool editando = false;
    private int idEditando = 0;
    private CrearPacienteParticularDto model = new();
    private DateTime? fechaNacimiento = null;
    private string mensajeModal = "";
