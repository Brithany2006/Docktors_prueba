                            <option value="0">-- Seleccionar Doctor de turno --</option>
                            @foreach (var doc in DoctoresDeTurno)
                            {
                                <option value="@doc.Id">@Etiquetas.Doctor(doc.Nombre) (@Etiquetas.Doctor(doc.Especialidad))</option>
                            }
                        </select>
                    </div>
                    <div>
                        <button @onclick="CargarAgenda" class="px-6 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-bold transition-colors shadow-sm flex items-center gap-2">
                            <i class="fa-solid fa-search"></i> Ver Agenda
                        </button>
                    </div>
                </div>

                @if (isLoadingAgenda)
                {
                    <div class="flex justify-center items-center py-12 text-purple-600">
                        <i class="fa-solid fa-spinner fa-spin text-3xl"></i>
                    </div>
