@using Microsoft.JSInterop
@using LaboratorioFront.Services
@inject DerivacionesService Service
@inject IJSRuntime JS
@inject LaboratorioFront.Services.ApiService Api

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex justify-between items-center mb-6">
        <h4 class="text-lg font-bold text-gray-800 flex items-center"><i class="fa-solid fa-clock text-turquesa-500 mr-2"></i> Configurar Horarios Médicos (@currentSucursal)</h4><button type="button" @onclick="ExportarHorarios" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg shadow-sm transition-colors text-sm"><i class="fa-solid fa-file-excel mr-1"></i> Exportar Horarios</button>
    </div>
    
    <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">Seleccionar Doctor</label>
        <select class="w-full rounded-lg border-gray-300 border p-2 focus:ring-turquesa-500 focus:border-turquesa-500" @onchange="OnDoctorHorarioChanged">
            <option value="">Seleccione un doctor...</option>
            @if (doctores != null)
            {
                foreach (var doc in doctores)
                {
                    <option value="@doc.Id">@Etiquetas.Doctor(doc.Nombre) (@Etiquetas.Doctor(doc.Especialidad))</option>
                }
            }
        </select>
    </div>

    @if (selectedHorarioDoctorId > 0)
    {
        <div class="space-y-4">
            @foreach (var dia in Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>().Where(d => d != DayOfWeek.Sunday))
            {
                var diaInt = dia == DayOfWeek.Sunday ? 7 : (int)dia;
                var config = horariosEdit.FirstOrDefault(h => h.DiaSemana == diaInt);
                var isChecked = config != null;
                
                <div class="flex items-center gap-4 p-3 bg-gray-50 rounded-lg border border-gray-100">
                    <div class="flex-shrink-0 w-32">
                        <label class="inline-flex items-center cursor-pointer">
                            <input type="checkbox" class="rounded border-gray-300 text-turquesa-600 focus:ring-turquesa-500 w-4 h-4" 
                                   checked="@isChecked" 
                                   @onchange="@(e => ToggleDiaHorario(diaInt, (bool)(e.Value ?? false)))" />
                            <span class="ml-2 text-sm font-medium text-gray-700">@GetDiaName(diaInt)</span>
                        </label>
                    </div>
                    
                    @if (isChecked && config != null)
                    {
                        <div class="flex items-center gap-2 flex-grow">
                            <input type="time" class="rounded-md border-gray-300 border p-1 text-sm w-28" value="@(config.HoraInicio.ToString("hh\\:mm"))" @onchange="@(e => { if(TimeSpan.TryParse(e.Value?.ToString(), out var ts)) config.HoraInicio = ts; })" />
                            <span class="text-gray-400 text-sm">a</span>
                            <input type="time" class="rounded-md border-gray-300 border p-1 text-sm w-28" value="@(config.HoraFin.ToString("hh\\:mm"))" @onchange="@(e => { if(TimeSpan.TryParse(e.Value?.ToString(), out var ts)) config.HoraFin = ts; })" />
                        </div>
                    }
                    else
                    {
                        <span class="text-sm text-gray-400 italic">No laborable</span>
                    }
                </div>
            }
        </div>
        
        <div class="mt-6 flex justify-end">
            <button @onclick="GuardarHorariosDoctor" class="px-6 py-2 bg-turquesa-600 hover:bg-turquesa-700 text-white font-bold rounded-lg shadow-sm transition-colors">
                <i class="fa-solid fa-save mr-2"></i> Guardar Horarios
            </button>
        </div>
    }

    <!-- Excepciones Section -->
    @if (selectedHorarioDoctorId > 0)
    {
        <div class="mt-8 pt-6 border-t border-gray-200">
            <h4 class="text-lg font-bold text-gray-800 flex items-center mb-4"><i class="fa-solid fa-calendar-xmark text-red-500 mr-2"></i> Días Libres / Excepciones</h4>
            
            <div class="flex gap-4 items-end mb-4 bg-gray-50 p-4 rounded-lg border border-gray-200">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Fecha Libre</label>
                    <input type="date" @bind="nuevaExcepcion.FechaExcepcion" class="border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-turquesa-500" />
                </div>
                <div class="flex-grow">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Motivo (Opcional)</label>
                    <input type="text" @bind="nuevaExcepcion.Motivo" placeholder="Ej: Vacaciones, Congreso Médico..." class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-turquesa-500" />
                </div>
                <button @onclick="AgregarExcepcion" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white font-bold rounded-lg transition-colors shadow-sm">
                    <i class="fa-solid fa-plus mr-1"></i> Agregar
                </button>
            </div>

            @if (excepcionesEdit != null && excepcionesEdit.Any())
            {
                <div class="grid gap-2">
                    @foreach (var exc in excepcionesEdit.OrderBy(e => e.FechaExcepcion))
                    {
                        <div class="flex justify-between items-center bg-white p-3 border border-red-100 rounded-lg shadow-sm">
                            <div>
                                <span class="font-bold text-red-600">@exc.FechaExcepcion.ToString("dd/MM/yyyy")</span>
                                <span class="text-gray-500 text-sm ml-2">@(string.IsNullOrEmpty(exc.Motivo) ? "Sin motivo especificado" : exc.Motivo)</span>
                            </div>
                            <button @onclick="() => EliminarExcepcion(exc.Id)" class="text-gray-400 hover:text-red-500 transition-colors">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-gray-500 italic">No hay excepciones programadas para este doctor.</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string currentSucursal { get; set; } = "Centro";

    private List<LaboratorioFront.Services.Doctor> doctores = new();
    private int selectedHorarioDoctorId = 0;
    private List<LaboratorioFront.Services.HorarioDoctor> horariosEdit = new();

    protected override async Task OnParametersSetAsync()
    {
        await CargarDoctores();
    }

    // La descarga se hace con el token de sesion: un enlace directo no envia Authorization y la API responderia 401.
    private async Task ExportarHorarios()
    {
        try
        {
            var response = await Api.Http.GetAsync($"api/derivaciones/doctores/exportar-horarios?sucursal={Uri.EscapeDataString(currentSucursal)}");
            if (!response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "No se pudo exportar los horarios.");
                return;
            }
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("downloadFileFromBytes", $"Horarios_{currentSucursal}_{DateTime.Now:yyyyMMdd}.csv", "text/csv", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error al exportar: " + ex.Message);
        }
    }

    private async Task CargarDoctores()
    {
        doctores = await Service.GetDoctoresAsync(currentSucursal);
        StateHasChanged();
    }

    private void OnDoctorHorarioChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedHorarioDoctorId = id;
            var doc = doctores.FirstOrDefault(d => d.Id == id);
            if (doc != null)
            {
                horariosEdit = doc.Horarios.Select(h => new LaboratorioFront.Services.HorarioDoctor
                {
                    Id = h.Id,
                    IdDoctor = h.IdDoctor,
                    DiaSemana = h.DiaSemana,
                    HoraInicio = h.HoraInicio,
                    HoraFin = h.HoraFin
                }).ToList();
            }
        }
        else
        {
            selectedHorarioDoctorId = 0;
        }

        _ = CargarExcepciones();
    }

    private void ToggleDiaHorario(int dia, bool trabaja)
    {
        var existing = horariosEdit.FirstOrDefault(h => h.DiaSemana == dia);
        if (trabaja && existing == null)
        {
            horariosEdit.Add(new LaboratorioFront.Services.HorarioDoctor
            {
                IdDoctor = selectedHorarioDoctorId,
                DiaSemana = dia,
                HoraInicio = new TimeSpan(8, 0, 0),
                HoraFin = new TimeSpan(17, 0, 0)
            });
        }
        else if (!trabaja && existing != null)
        {
            horariosEdit.Remove(existing);
        }
    }

    private async Task GuardarHorariosDoctor()
    {
        if (selectedHorarioDoctorId <= 0) return;
        
        bool exito = await Service.UpdateHorariosDoctorAsync(selectedHorarioDoctorId, horariosEdit);
        if (exito)
        {
            await JS.InvokeVoidAsync("alert", "Horarios guardados correctamente.");
            await CargarDoctores();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Error al guardar horarios.");
        }
    }

    private string GetDiaName(int dia)
    {
        return dia switch
        {
            1 => "Lunes",
            2 => "Martes",
            3 => "Miércoles",
            4 => "Jueves",
            5 => "Viernes",
            6 => "Sábado",
            7 => "Domingo",
            _ => "Desconocido"
        };
    }

    private List<LaboratorioFront.Services.DerivacionesService.ExcepcionDoctor> excepcionesEdit = new();
    private LaboratorioFront.Services.DerivacionesService.ExcepcionDoctor nuevaExcepcion = new() { FechaExcepcion = DateTime.Today };

    private async Task CargarExcepciones()
    {
        if (selectedHorarioDoctorId > 0)
        {
            excepcionesEdit = await Service.GetExcepcionesAsync(selectedHorarioDoctorId);
            StateHasChanged();
        }
    }

    private async Task AgregarExcepcion()
    {
        if (selectedHorarioDoctorId > 0)
        {
            nuevaExcepcion.IdDoctor = selectedHorarioDoctorId;
            var ok = await Service.AddExcepcionAsync(nuevaExcepcion);
            if (ok)
            {
                nuevaExcepcion = new() { FechaExcepcion = DateTime.Today };
                await CargarExcepciones();
            }
        }
    }

    private async Task EliminarExcepcion(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "¿Eliminar este dia libre?"))
        {
            var ok = await Service.DeleteExcepcionAsync(id);
            if (ok) await CargarExcepciones();
        }
    }
}




