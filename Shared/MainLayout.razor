@implements IDisposable
@using LaboratorioFront.Shared
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LaboratorioFront.Services.ApiService Api

@if (isLoading)
{
    <div class="fixed inset-0 z-[99999] flex flex-col items-center justify-center bg-white/80 backdrop-blur-md transition-opacity duration-300">
        <div class="relative flex justify-center items-center">
            <div class="absolute animate-ping w-16 h-16 rounded-full bg-turquesa-400 opacity-60"></div>
            <div class="relative w-16 h-16 rounded-full border-4 border-turquesa-200 border-t-turquesa-700 animate-spin"></div>
        </div>
        <span class="mt-6 text-lg font-bold text-turquesa-900 animate-pulse">Cargando datos...</span>
    </div>
}

<div class="min-h-screen flex flex-col bg-gray-50 dark:bg-gray-900 font-sans transition-colors duration-300">
    <header class="bg-[#0d5c63]/90 backdrop-blur-xl border-b border-white/10 shadow-lg sticky top-0 z-50 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <div class="flex-shrink-0 cursor-pointer flex items-center bg-white px-4 py-2 rounded-xl shadow-md transition-transform hover:scale-105" @onclick="IrAlHome">
                    <img src="/images/LOGO.png" alt="Logo" class="h-12 w-auto object-contain" />
                </div>

                <!-- Desktop Menu -->
                <nav class="hidden md:flex space-x-8 items-center">
                    <NavLink href="/" class="text-turquesa-100 hover:text-white hover:bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] hover:from-white/20 hover:to-transparent px-4 py-2 rounded-xl font-semibold transition-all duration-300" Match="NavLinkMatch.All">Inicio</NavLink>
                    <NavLink href="/Nosotros" class="text-turquesa-100 hover:text-white hover:bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] hover:from-white/20 hover:to-transparent px-4 py-2 rounded-xl font-semibold transition-all duration-300">Nosotros</NavLink>
                    <NavLink href="/Contacto" class="text-turquesa-100 hover:text-white hover:bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] hover:from-white/20 hover:to-transparent px-4 py-2 rounded-xl font-semibold transition-all duration-300">Contacto</NavLink>

                    @if (isAdmin)
                    {
                        <NavLink href="/dashboard-admin" class="text-white font-bold hover:bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] hover:from-white/20 hover:to-transparent px-4 py-2 rounded-xl transition-all duration-300">Admin</NavLink>
                    }
                    @if (isCaja)
                    {
                        <NavLink href="/dashboard-caja" class="text-white font-bold hover:bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] hover:from-white/20 hover:to-transparent px-4 py-2 rounded-xl transition-all duration-300">Caja</NavLink>
                    }
                    @if (isCajaCitas)
                    {
                        <NavLink href="/dashboard-caja-citas" class="text-white font-bold hover:bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] hover:from-white/20 hover:to-transparent px-4 py-2 rounded-xl transition-all duration-300">Citas</NavLink>
                    }

                    @if (isLoggedIn)
                    {
                        <button class="bg-red-500 hover:bg-red-400 text-white px-5 py-2 rounded-full font-bold transition-all duration-300 shadow-md hover:shadow-[0_0_15px_rgba(239,68,68,0.5)]" @onclick="Logout">Salir</button>
                    }
                    else
                    {
                        <button class="bg-emerald-500 hover:bg-emerald-400 text-white px-5 py-2 rounded-full font-bold transition-all duration-300 shadow-md hover:shadow-[0_0_15px_rgba(16,185,129,0.5)]" @onclick="Login">Ingresar</button>
                    }
                </nav>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center">
                    <button @onclick="ToggleMenu" class="text-gray-600 hover:text-[#0d5c63] focus:outline-none p-2">
                        <i class="fa-solid fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Dropdown -->
        @if (isMenuOpen)
        {
            <div class="md:hidden bg-white border-t border-gray-100 px-4 pt-2 pb-4 space-y-1 shadow-lg absolute w-full left-0">
                <NavLink href="/" class="block px-3 py-3 rounded-md text-base font-semibold text-gray-700 dark:text-gray-200 hover:text-[#0d5c63] dark:hover:text-turquesa-300 hover:bg-gray-50" Match="NavLinkMatch.All" @onclick="ToggleMenu">Inicio</NavLink>
                <NavLink href="/Nosotros" class="block px-3 py-3 rounded-md text-base font-semibold text-gray-700 dark:text-gray-200 hover:text-[#0d5c63] dark:hover:text-turquesa-300 hover:bg-gray-50" @onclick="ToggleMenu">Nosotros</NavLink>
                <NavLink href="/Contacto" class="block px-3 py-3 rounded-md text-base font-semibold text-gray-700 dark:text-gray-200 hover:text-[#0d5c63] dark:hover:text-turquesa-300 hover:bg-gray-50" @onclick="ToggleMenu">Contacto</NavLink>

                @if (isAdmin)
                {
                    <NavLink href="/dashboard-admin" class="block px-3 py-3 rounded-md text-base font-bold text-[#0d5c63] bg-teal-50" @onclick="ToggleMenu">Dashboard Admin</NavLink>
                }
                @if (isCaja)
                {
                    <NavLink href="/dashboard-caja" class="block px-3 py-3 rounded-md text-base font-bold text-[#0d5c63] bg-teal-50" @onclick="ToggleMenu">Administrar Usuarios</NavLink>
                }
                @if (isCajaCitas)
                {
                    <NavLink href="/dashboard-caja-citas" class="block px-3 py-3 rounded-md text-base font-bold text-[#0d5c63] bg-teal-50" @onclick="ToggleMenu">Ver Citas</NavLink>
                }

                <div class="mt-4 px-3">
                @if (isLoggedIn)
                {
                    <button class="w-full bg-red-500 hover:bg-red-400 text-white px-5 py-3 rounded-xl font-bold transition-all duration-300 shadow-md hover:shadow-[0_0_15px_rgba(239,68,68,0.5)]" @onclick="() => { Logout(); ToggleMenu(); }">Cerrar Sesion</button>
                }
                else
                {
                    <button class="w-full bg-emerald-500 hover:bg-emerald-400 text-white px-5 py-3 rounded-xl font-bold transition-all duration-300 shadow-md hover:shadow-[0_0_15px_rgba(16,185,129,0.5)]" @onclick="() => { Login(); ToggleMenu(); }">Iniciar Sesion</button>
                }
                </div>
            </div>
        }
    </header>

    <main class="flex-grow w-full @(Navigation.ToBaseRelativePath(Navigation.Uri) == "" ? "p-0" : "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")">
        @Body
    </main>
    
    <!-- Floating Dark Mode Toggle -->
    <button @onclick="ToggleDarkMode" class="fixed bottom-6 right-6 bg-gray-800 dark:bg-yellow-400 text-white dark:text-gray-900 w-14 h-14 rounded-full shadow-lg flex items-center justify-center transition-all hover:scale-110 z-50">
        @if (isDarkMode)
        {
            <i class="fa-solid fa-sun text-2xl"></i>
        }
        else
        {
            <i class="fa-solid fa-moon text-2xl"></i>
        }
    </button>

    <footer class="bg-[#0d5c63]/90 backdrop-blur-xl border-t border-white/10 text-white py-8 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-sm text-teal-100 font-medium">© 2025 Laboratorio Doktors - Todos los derechos reservados.</p>
            <div class="flex space-x-6 text-xl">
                <a href="https://www.facebook.com/profile.php?id=100076061530792&locale=es_LA" target="_blank" rel="noopener" class="text-teal-200 hover:text-white transition-colors" aria-label="Facebook">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="https://www.instagram.com/klinic.med?igsh=bW8zMGE3eHVrYm94" target="_blank" rel="noopener" class="text-teal-200 hover:text-white transition-colors" aria-label="Instagram">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="https://ec.linkedin.com/company/centro-medico-klinic" target="_blank" rel="noopener" class="text-teal-200 hover:text-white transition-colors" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>
        </div>
    </footer>
</div>

@code {
    private bool isLoggedIn;
    private bool isAdmin;
    private bool isCaja;
    private bool isCajaCitas;
    private bool isLoading = true;
    private bool isDarkMode = false;

    private bool isMenuOpen = false;
    private bool EsPaginaLogin => Navigation.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private async Task ToggleDarkMode()
    {

        try { isDarkMode = await JS.InvokeAsync<bool>("toggleDarkMode"); } catch { isDarkMode = !isDarkMode; await JS.InvokeVoidAsync("eval", "document.documentElement.classList.toggle('dark')"); }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isDarkMode = await JS.InvokeAsync<bool>("isDarkMode");
                StateHasChanged();
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadUserStateAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        isLoading = true;
        StateHasChanged();

        await LoadUserStateAsync();

        isLoading = false;
        StateHasChanged();
    }

    private void IrAlHome()
    {
        Navigation.NavigateTo("/");
    }

    private async Task LoadUserStateAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("laboratorio.getToken");
            isLoggedIn = !string.IsNullOrEmpty(token);

            if (isLoggedIn)
            {
                Api.SetToken(token);

                var payload = token.Split('.')[1];
                var payloadStr = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(PadBase64(payload)));
                var payloadJson = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(payloadStr);

                if (payloadJson != null)
                {
                    var roleClaim = payloadJson.FirstOrDefault(x =>
                        x.Key.Equals("role", StringComparison.OrdinalIgnoreCase)).Value?.ToString();

                    isAdmin = roleClaim == "Admin";
                    isCaja = roleClaim == "Caja" || roleClaim == "UsuarioCaja";
                    isCajaCitas = roleClaim == "CajaCitas";
                }
            }
            else
            {
                isAdmin = false;
                isCaja = false;
                isCajaCitas = false;
            }
        }
        catch
        {
            isLoggedIn = false;
            isAdmin = false;
            isCaja = false;
                isCajaCitas = false;
        }
        finally
        {
            // Aseguramos que el loading termine al finalizar la carga de sesion inicial
            isLoading = false;
        }
    }

    private string PadBase64(string base64)
    {
        switch (base64.Length % 4)
        {
            case 2: base64 += "=="; break;
            case 3: base64 += "="; break;
        }
        return base64.Replace('-', '+').Replace('_', '/');
    }

    private async Task Logout()
    {
        isLoading = true;
        await JS.InvokeVoidAsync("laboratorio.setToken", (string?)null);
        Api.SetToken(null);
        isLoggedIn = false;
        isAdmin = false;
        isCaja = false;
                isCajaCitas = false;
        isLoading = false;
        Navigation.NavigateTo("/login");
    }

    private void Login()
    {
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}





