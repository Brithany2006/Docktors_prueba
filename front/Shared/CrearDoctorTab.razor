@using Microsoft.JSInterop
@using LaboratorioFront.Services
@inject ApiService Api
@inject IJSRuntime JS

<div class="p-6 bg-white rounded-2xl shadow-sm border border-gray-100 mt-6">
    <div class="flex justify-between items-center mb-6">
        <h4 class="text-lg font-bold text-gray-800 flex items-center">
            <i class="fa-solid fa-user-doctor text-turquesa-500 mr-2"></i> Crear Nuevo Doctor (@currentSucursal)
        </h4>
    </div>

    <EditForm Model="nuevoDoctor" OnValidSubmit="CrearDoctor">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="col-span-1 md:col-span-2">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Nombre Completo del Doctor</label>
                <input type="text" @bind="nuevoDoctor.Nombre" @bind:after="AutoGenerateCredentials" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" placeholder="Ej. Dr. Juan Pérez" required />
            </div>

            <div class="col-span-1">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Especialidad</label>
                <input type="text" @bind="nuevoDoctor.Especialidad" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" placeholder="Ej. Cardiología" required />
            </div>
            
            <div class="col-span-1">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Sucursal</label>
                <select @bind="nuevoDoctor.Sucursal" disabled="@(sucursalFija)" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none bg-gray-50">
                    <option value="Centro">Centro</option>
                    <option value="Milan">Milán</option>
                </select>
            </div>

            <div class="col-span-1">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Usuario (Login)</label>
                <input type="text" @bind="nuevoDoctor.Usuario" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" required />
            </div>

            <div class="col-span-1">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Contraseña</label>
                <input type="text" @bind="nuevoDoctor.Password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" required />
            </div>
        </div>

        <div class="mt-6 flex justify-end">
            <button type="submit" class="px-6 py-2 bg-turquesa-600 hover:bg-turquesa-700 text-white font-bold rounded-lg shadow-sm transition-colors" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <i class="fa-solid fa-spinner fa-spin mr-2"></i> <span>Creando...</span>
                }
                else
                {
                    <i class="fa-solid fa-plus mr-2"></i> <span>Crear Doctor</span>
                }
            </button>
        </div>
        
        @if (!string.IsNullOrEmpty(mensajeMensaje))
        {
            <div class="mt-4 p-3 rounded @(esExito ? "bg-green-50 text-green-700" : "bg-red-50 text-red-700") border @(esExito ? "border-green-200" : "border-red-200")">
                @mensajeMensaje
            </div>
        }
    </EditForm>
</div>

@code {
    [Parameter] public string currentSucursal { get; set; } = "Centro";
    [Parameter] public bool sucursalFija { get; set; } = false;

    private CrearDoctorRequest nuevoDoctor = new();
    private bool isSubmitting = false;
    private string mensajeMensaje = "";
    private bool esExito = false;

    protected override void OnParametersSet()
    {
        nuevoDoctor.Sucursal = currentSucursal;
    }

    private void AutoGenerateCredentials()
    {
        if (string.IsNullOrWhiteSpace(nuevoDoctor.Nombre) || !string.IsNullOrWhiteSpace(nuevoDoctor.Usuario)) return;

        var parts = nuevoDoctor.Nombre.Trim().ToLower().Split(new char[] { ' ', '.' }, StringSplitOptions.RemoveEmptyEntries)
                        .Where(p => p != "dr" && p != "dra" && p != "md").ToList();
        if (parts.Count >= 2)
        {
            nuevoDoctor.Usuario = parts[0].Substring(0, 1) + parts[1];
            nuevoDoctor.Password = nuevoDoctor.Usuario;
        }
        else if (parts.Count == 1)
        {
            nuevoDoctor.Usuario = parts[0];
            nuevoDoctor.Password = nuevoDoctor.Usuario;
        }
    }

    private async Task CrearDoctor()
    {
        isSubmitting = true;
        mensajeMensaje = "";
        StateHasChanged();

        try
        {
            var response = await Api.Http.PostAsJsonAsync("admin/crear-doctor", nuevoDoctor);
            if (response.IsSuccessStatusCode)
            {
                esExito = true;
                mensajeMensaje = "Doctor creado exitosamente.";
                nuevoDoctor = new CrearDoctorRequest { Sucursal = currentSucursal };
            }
            else
            {
                esExito = false;
                mensajeMensaje = "Error al crear el doctor. " + await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            esExito = false;
            mensajeMensaje = "Error: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    public class CrearDoctorRequest
    {
        public string Nombre { get; set; } = string.Empty;
        public string Especialidad { get; set; } = string.Empty;
        public string Sucursal { get; set; } = "Centro";
        public string Usuario { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
