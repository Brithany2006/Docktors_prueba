@page "/usuario-editar/{Id:int}"
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LaboratorioFront.Services.ApiService Api
<PageTitle>Editar usuario | Centro Médico Klinic</PageTitle>

<div class="admin-content">
    <button class="btn-secondary mb-3" @onclick="Volver">a† Volver a Usuarios</button>

    @if (loading)
    {
        <p>Cargando usuario...</p>
    }
    else if (!isAdmin)
    {
        <p>No tienes permisos para acceder a esta pagina.</p>
    }
    else if (usuario is null)
    {
        <p>aŒ Usuario no encontrado.</p>
    }
    else
    {
         <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 max-w-4xl mx-auto mt-6">
            <div class="flex items-center space-x-6 mb-8 border-b border-gray-100 pb-6">
                <div class="h-20 w-20 rounded-full bg-turquesa-100 flex items-center justify-center text-turquesa-700 text-3xl font-bold shadow-inner">
                    @usuario.NombreEmpresa.FirstOrDefault().ToString().ToUpper()
                </div>
                <div>
                    <h4 class="text-2xl font-bold text-gray-800">@usuario.NombreEmpresa</h4>
                    <p class="text-gray-500 text-lg">@usuario.Nombre</p>
                    <div class="flex space-x-4 mt-2 text-sm text-gray-500">
                        <span><strong>RUC:</strong> @usuario.RUC</span>
                        <span><strong>Creado:</strong> @usuario.FechaCreacion.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="col-span-1">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Nombre de Usuario</label>
                    <InputText @bind-Value="edicion.Nombre" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" />
                </div>
                <div class="col-span-1">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">RUC o Cedula</label>
                    <InputText @bind-Value="edicion.RUC" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" />
                </div>
                <div class="col-span-1">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Rol</label>
                                        <InputSelect @bind-Value="edicion.Rol" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all">
                        <option value="UsuarioEmpresa">Usuario empresa</option>
                        <option value="Admin">Administrador</option>
                        <option value="UsuarioCaja">Usuario Caja</option>
                        <option value="CajaCitas">Caja (Solo Citas)</option>
                        <option value="ECOMD">Procedimientos: Ecocardiograma (ECOMD)</option>
                        <option value="Doctor">Doctor</option>
                        <option value="AdminDerivaciones">Administrador de Derivaciones (Carla)</option>
                    </InputSelect>
                </div>
                <div class="col-span-1 md:col-span-2 flex items-center mt-2 mb-4">
                    <label class="flex items-center space-x-3 cursor-pointer">
                        <input type="checkbox" @bind="edicion.Activo" class="w-5 h-5 text-turquesa-600 border-gray-300 rounded focus:ring-turquesa-500" />
                        <span class="text-sm font-semibold text-gray-700">Usuario activo en el sistema</span>
                    </label>
                </div>

                <div class="col-span-1 md:col-span-2 mt-4 pt-4 border-t border-gray-100">
                    <h5 class="text-md font-bold text-gray-700 mb-4">Actualizar Personalizacion Visual</h5>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="col-span-1">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Cambiar logo (.png/.jpg)</label>
                            <InputFile OnChange="OnLogoChange" accept="image/png, image/jpeg" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-turquesa-50 file:text-turquesa-700 hover:file:bg-turquesa-100" />
                        </div>
                        <div class="col-span-1">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Cambiar banner (.jpg)</label>
                            <InputFile OnChange="OnBannerChange" accept="image/jpeg" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-turquesa-50 file:text-turquesa-700 hover:file:bg-turquesa-100" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(bannerPreview))
                    {
                        <div class="mt-4 bg-gray-50 p-4 rounded-xl border border-gray-200">
                            <p class="text-sm font-semibold text-gray-700 mb-2">Vista Previa del Banner:</p>
                            @if (!recorteConfirmado)
                            {
                                <div style="max-height: 400px; overflow: hidden;" class="rounded-lg border border-gray-300 mb-3">
                                    <img id="cropper-banner-edit" src="@bannerPreview" class="max-w-full block" />
                                </div>
                                <button type="button" class="px-4 py-2 bg-turquesa-600 hover:bg-turquesa-700 text-white font-bold rounded-lg transition-all" @onclick="ConfirmarRecorteBanner">Confirmar Recorte</button>
                            }
                            else
                            {
                                <img src="@bannerFinalBase64" class="w-full object-cover rounded-lg shadow-sm border border-gray-200 mb-3" />
                                <button type="button" class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-bold rounded-lg transition-all" @onclick="VolverARecortarBanner">Cambiar Recorte</button>
                            }
                        </div>
                    }
                </div>

                <div class="col-span-1 md:col-span-2 flex justify-end mt-4">
                    <button class="w-full md:w-auto px-8 py-3 bg-turquesa-600 hover:bg-turquesa-700 text-white font-bold rounded-lg shadow-md transition-all" @onclick="GuardarEdicion"><i class="fa-solid fa-floppy-disk mr-2"></i> Guardar cambios</button>
                </div>
            </div> <!-- Cierra el grid principal -->
            
            <div class="mt-8 pt-8 border-t border-gray-100">
                <h5 class="text-md font-bold text-gray-700 mb-4">Seguridad y Cuenta</h5>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-end">
                    <div class="col-span-1">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Nueva contrasena</label>
                        <input class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 focus:border-turquesa-500 outline-none transition-all" type="password" @bind="nuevaPassword" placeholder="Escribe la nueva contrasena" />
                    </div>
                    <div class="col-span-1 flex space-x-3">
                        <button class="w-full px-6 py-2 bg-yellow-500 hover:bg-yellow-600 text-white font-bold rounded-lg shadow-md transition-all flex items-center justify-center" @onclick="ResetearPassword"><i class="fa-solid fa-key mr-2"></i> Resetear</button>
                        <button class="w-full px-6 py-2 bg-red-500 hover:bg-red-600 text-white font-bold rounded-lg shadow-md transition-all flex items-center justify-center" @onclick="EliminarUsuario"><i class="fa-solid fa-trash mr-2"></i> Eliminar</button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="mt-6 @(isError ? "bg-red-50 border-red-200 text-red-800" : "bg-turquesa-50 border-turquesa-200 text-turquesa-800") border px-4 py-3 rounded-lg relative flex items-center" role="alert">
                    <i class="@(isError ? "fa-solid fa-circle-xmark" : "fa-solid fa-circle-check") mr-2"></i>
                    <span class="block sm:inline">@mensaje</span>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool loading = true;
    private bool isAdmin = false;
    private string mensaje = string.Empty;
    private bool isError = false;

    private UsuarioListItem? usuario;
    private EditarUsuarioModel edicion = new();
    private string nuevaPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("laboratorio.getToken");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        var payload = ParseJwt(token);
        var roleClaim = payload.FirstOrDefault(x => x.Key.Equals("role",
            StringComparison.OrdinalIgnoreCase)).Value?.ToString();

        isAdmin = roleClaim == "Admin";
        if (!isAdmin)
        {
            Nav.NavigateTo("/", true);
            return;
        }

        await CargarUsuario();
        loading = false;
    }

    private async Task CargarUsuario()
    {
        var res = await Api.Http.GetAsync($"admin/usuarios/{Id}");
        if (res.IsSuccessStatusCode)
        {
            var json = await res.Content.ReadAsStringAsync();
            usuario = System.Text.Json.JsonSerializer.Deserialize<UsuarioListItem>(
                json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (usuario is not null)
            {
                edicion = new EditarUsuarioModel { Nombre = usuario.Nombre, Rol = usuario.Rol, Activo = usuario.Activo, RUC = usuario.RUC };
            }
        }
    }

    private IBrowserFile? logoFile;
    private void OnLogoChange(InputFileChangeEventArgs e)
    {
        logoFile = e.File;
    }

    private IBrowserFile? bannerFile;
    private string? bannerPreview;
    private string? bannerFinalBase64;
    private bool recorteConfirmado = false;
    
    private async Task OnBannerChange(InputFileChangeEventArgs e)
    {
        bannerFile = e.File;
        recorteConfirmado = false;
        bannerFinalBase64 = null;
        if (bannerFile != null)
        {
            var format = "image/jpeg";
            var resizedImageFile = await bannerFile.RequestImageFileAsync(format, 1200, 1200);
            var buffer = new byte[resizedImageFile.Size];
            await resizedImageFile.OpenReadStream(15 * 1024 * 1024).ReadAsync(buffer);
            bannerPreview = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
            
            // Allow DOM to update then initialize cropper
            await Task.Delay(100);
            await JS.InvokeVoidAsync("initCropper", "cropper-banner-edit", 800 / 400.0);
        }
        else
        {
            bannerPreview = null;
        }
    }
    
    private async Task ConfirmarRecorteBanner()
    {
        bannerFinalBase64 = await JS.InvokeAsync<string>("getCroppedImage", "cropper-banner-edit");
        if (!string.IsNullOrEmpty(bannerFinalBase64))
        {
            recorteConfirmado = true;
            await JS.InvokeVoidAsync("destroyCropper", "cropper-banner-edit");
        }
    }
    
    private async Task VolverARecortarBanner()
    {
        recorteConfirmado = false;
        await Task.Delay(100);
        await JS.InvokeVoidAsync("initCropper", "cropper-banner-edit", 800 / 400.0);
    }

    private async Task GuardarEdicion()
    {
        var res = await Api.Http.PutAsJsonAsync($"admin/usuarios/{Id}", edicion);
        mensaje = res.IsSuccessStatusCode
            ? "✅ Usuario actualizado correctamente."
            : $"aŒ {await res.Content.ReadAsStringAsync()}";

        if (res.IsSuccessStatusCode && usuario is not null)
        {
            usuario.Nombre = edicion.Nombre;
            usuario.Rol = edicion.Rol;
            usuario.RUC = edicion.RUC;
            usuario.Activo = edicion.Activo;
            
            if (logoFile != null)
            {
                await SubirLogo(usuario.RUC, logoFile);
                logoFile = null; // reset
            }
            if (bannerFile != null && recorteConfirmado && !string.IsNullOrEmpty(bannerFinalBase64))
            {
                await SubirBanner(usuario.RUC, bannerFinalBase64);
                bannerFile = null;
                bannerPreview = null;
                bannerFinalBase64 = null;
                recorteConfirmado = false;
            }
        }
    }

    private async Task SubirLogo(string ruc, IBrowserFile file)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(ruc), "ruc");
            var streamContent = new StreamContent(file.OpenReadStream(10 * 1024 * 1024));
            content.Add(streamContent, "logoFile", file.Name);
            var res = await Api.Http.PostAsync("admin/usuarios/logo", content);
            if (res.IsSuccessStatusCode)
            {
                mensaje += " Logo actualizado.";
            }
        }
        catch { }
    }

    private async Task SubirBanner(string ruc, string base64Data)
    {
        try
        {
            var base64 = base64Data.Split(',')[1];
            var bytes = Convert.FromBase64String(base64);
            
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(ruc), "ruc");
            var streamContent = new ByteArrayContent(bytes);
            content.Add(streamContent, "bannerFile", "banner.jpg");
            var res = await Api.Http.PostAsync("admin/usuarios/banner", content);
            if (res.IsSuccessStatusCode)
            {
                mensaje += " Banner actualizado.";
            }
        }
        catch { }
    }

    private async Task ResetearPassword()
    {
        if (string.IsNullOrWhiteSpace(nuevaPassword))
        {
            mensaje = "⚠ Escribe la nueva contrasena primero.";
            return;
        }

        var res = await Api.Http.PostAsJsonAsync(
            $"admin/usuarios/{Id}/resetear-password",
            new { NuevaPassword = nuevaPassword });

        mensaje = res.IsSuccessStatusCode
            ? "✅ Contraseña actualizada correctamente."
            : $"aŒ {await res.Content.ReadAsStringAsync()}";

        nuevaPassword = string.Empty;
    }

    private async Task EliminarUsuario()
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Seguro que quieres eliminar a {usuario?.Nombre} ({usuario?.NombreEmpresa})?");
        if (!confirmado) return;

        var res = await Api.Http.PostAsync($"admin/usuarios/{Id}/eliminar", null);
        if (res.IsSuccessStatusCode)
        {
            Volver();
        }
        else
        {
            mensaje = $"aŒ {await res.Content.ReadAsStringAsync()}";
        }
    }

    private void Volver() => Nav.NavigateTo("/dashboard-admin");

    private Dictionary<string, object> ParseJwt(string token)
    {
        var parts = token.Split('.');
        if (parts.Length != 3) return new();

        var payload = parts[1];
        payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
        var jsonBytes = Convert.FromBase64String(payload.Replace('-', '+').Replace('_', '/'));
        var json = System.Text.Encoding.UTF8.GetString(jsonBytes);
        return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json) ?? new();
    }

    public class UsuarioListItem
    {
        public int IdUsuario { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string RUC { get; set; } = string.Empty;
        public string NombreEmpresa { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public bool Activo { get; set; }
        public DateTime FechaCreacion { get; set; }
    }

    public class EditarUsuarioModel
    {
        public string Nombre { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public string RUC { get; set; } = string.Empty;
        public bool Activo { get; set; } = true;
    }
}








