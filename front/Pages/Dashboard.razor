@page "/"
@implements IDisposable
@inject LaboratorioFront.Services.ApiService Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Inicio | Centro Médico Klinic</PageTitle>

<section class="kl-hero" aria-labelledby="kl-titulo">
    <div>
        <h1 id="kl-titulo" class="kl-up kl-d1">Tu salud, en <span>buenas manos</span></h1>
        <p class="kl-lead kl-up kl-d2">Consulta externa, laboratorio, ecografía y farmacia en un solo lugar. Atendemos citas del IESS, particulares y derivaciones.</p>
        <div class="kl-up kl-d3" style="display:flex;gap:.75rem;flex-wrap:wrap">
            <button type="button" class="kl-btn kl-btn-m" @onclick='() => Ir("citas")'><i class="fa-regular fa-calendar-check" aria-hidden="true"></i> Agenda tu cita</button>
        </div>
    </div>
    <div class="kl-hero-art kl-up kl-d4" aria-hidden="true">
        <div class="kl-blob kl-b1"></div><div class="kl-blob kl-b2"></div><div class="kl-blob kl-b3"></div>
        <div class="kl-photo"><img src="/images/Home.png" alt="" width="1920" height="1080" style="object-position: 88% 70%" /></div>
    </div>
    <svg class="kl-pulse" viewBox="0 0 260 40" aria-hidden="true"><path d="M0 20h70l12-16 16 32 14-24 10 8h138" /></svg>
</section>

<section id="servicios" class="kl-section" aria-labelledby="kl-servicios">
    <h2 id="kl-servicios" class="kl-reveal">Nuestros servicios</h2>
    <p class="kl-sub kl-reveal">Todo lo que necesitas, sin salir de la clínica.</p>
    <div class="kl-cards">
        <article class="kl-card kl-reveal"><div class="kl-ico" aria-hidden="true"><i class="fa-solid fa-stethoscope"></i></div><h3>Consulta externa</h3><p>Médicos por especialidad.</p></article>
        <article class="kl-card kl-reveal"><div class="kl-ico" aria-hidden="true"><i class="fa-solid fa-flask-vial"></i></div><h3>Laboratorio</h3><p>Resultados confiables y rápidos.</p></article>
        <article class="kl-card kl-reveal"><div class="kl-ico" aria-hidden="true"><i class="fa-solid fa-wave-square"></i></div><h3>Ecografía</h3><p>Con cita previa.</p></article>
        <article class="kl-card kl-reveal"><div class="kl-ico" aria-hidden="true"><i class="fa-solid fa-pills"></i></div><h3>Farmacia</h3><p>Tu receta, el mismo día.</p></article>
    </div>
</section>

<section id="citas" class="kl-cita-wrap" aria-labelledby="kl-cita-titulo">
    <div class="kl-cita-band kl-reveal">
        <div class="kl-cita-ico" aria-hidden="true"><i class="fa-regular fa-calendar-check"></i></div>
        <div class="kl-cita-text">
            <h2 id="kl-cita-titulo">¿Necesitas una cita?</h2>
            <p>Agéndala por WhatsApp con IzyBot, el asistente oficial del IESS, o llama al 140. Elige Centro Médico Klinic como establecimiento.</p>
        </div>
        <div class="kl-cita-actions">
            <a class="kl-btn kl-btn-w" href="https://wa.me/593990140140" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Agendar por WhatsApp (IESS)<span class="kl-sr"> (se abre en una pestaña nueva)</span></a>
            <button type="button" class="kl-btn kl-btn-o" @onclick="AbrirPasosIess">Cómo agendar por el IESS</button>
        </div>
    </div>
</section>

<ModalAgendarIess />

@if (!isLoading && carouselImages.Any())
{
    <section class="kl-section" aria-label="Novedades de Centro Médico Klinic">
        <h2 class="kl-reveal">Novedades</h2>
        <p class="kl-sub kl-reveal">Información y avisos de la clínica.</p>
        <div class="kl-carousel kl-reveal" role="group" aria-roledescription="carrusel" aria-label="Novedades" aria-live="@(detenido ? "polite" : "off")"
             @onmouseenter="() => pausado = true" @onmouseleave="() => pausado = false" @onfocusin="() => pausado = true" @onfocusout="() => pausado = false">
            @for (int i = 0; i < carouselImages.Count; i++)
            {
                var img = carouselImages[i];
                var activa = i == currentIndex;
                <img src="@(Api.Http.BaseAddress?.ToString().TrimEnd('/') + img)" loading="@(i == 0 ? "eager" : "lazy")"
                     class="@(activa ? "opacity-100" : "opacity-0")" aria-hidden="@(activa ? "false" : "true")"
                     alt="Novedad @(i + 1) de @carouselImages.Count de Centro Médico Klinic" onerror="this.onerror=null; this.src='/images/LOGIN.png';" />
            }

            @if (carouselImages.Count > 1)
            {
                <button type="button" @onclick="AlternarAutomatico" class="kl-carousel-btn kl-carousel-pausa" aria-label="@(detenido ? "Reanudar el cambio automático de imágenes" : "Detener el cambio automático de imágenes")"><i class="fa-solid @(detenido ? "fa-play" : "fa-pause")" aria-hidden="true"></i></button>
                <button type="button" @onclick="PrevImage" class="kl-carousel-btn" style="left:.8rem" aria-label="Imagen anterior"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                <button type="button" @onclick="NextImage" class="kl-carousel-btn" style="right:.8rem" aria-label="Imagen siguiente"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                <div class="kl-carousel-dots">
                    @for (int i = 0; i < carouselImages.Count; i++)
                    {
                        var index = i;
                        <button type="button" @onclick="() => GoToImage(index)" class="kl-dot @(currentIndex == index ? "on" : "")" aria-label="Ir a la imagen @(index + 1)" aria-current="@(currentIndex == index ? "true" : "false")"><i></i></button>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    private List<string> carouselImages = new();
    private bool isLoading = true;
    private bool pausado = false;
    // El visitante detuvo el cambio automatico con el boton (2.2.2): no avanza hasta que lo reanude
    private bool detenido = false;
    private int currentIndex = 0;
    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            carouselImages = await Api.GetCarouselImagesAsync();
            if (carouselImages.Count > 1)
            {
                // Con "reducir movimiento" activado el carrusel no avanza solo
                var sinMovimiento = false;
                try { sinMovimiento = await JS.InvokeAsync<bool>("klinic.sinMovimiento"); } catch { }
                if (!sinMovimiento)
                    timer = new System.Threading.Timer(TimerCallback, null, 5000, 5000);
            }
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("klinic.reveal"); } catch { }
    }

    private void TimerCallback(object? state)
    {
        if (pausado || detenido) return;
        InvokeAsync(() =>
        {
            NextImage();
            StateHasChanged();
        });
    }

    private async Task Ir(string id)
    {
        try { await JS.InvokeVoidAsync("klinic.irA", id); } catch { }
    }

    private async Task AbrirPasosIess()
    {
        try { await JS.InvokeVoidAsync("klinic.abrirDialogo", "kl-iess"); } catch { }
    }

    private void AlternarAutomatico() => detenido = !detenido;

    private void NextImage()
    {
        if (carouselImages.Count > 0)
        {
            currentIndex = (currentIndex + 1) % carouselImages.Count;
        }
    }

    private void PrevImage()
    {
        if (carouselImages.Count > 0)
        {
            currentIndex = (currentIndex - 1 + carouselImages.Count) % carouselImages.Count;
        }
    }

    private void GoToImage(int index)
    {
        currentIndex = index;
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
