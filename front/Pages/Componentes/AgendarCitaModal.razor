@using LaboratorioFront.Services
@inject DerivacionesService Service
@inject Microsoft.JSInterop.IJSRuntime JS

@* Agenda una cita para una derivacion que ya existe (por ejemplo un paciente que no confirmo y Caja "activa").
   Permite elegir el doctor, el dia (hoy o posterior) y un horario libre o un turno extra.
   Con CitaEditar la ventana edita esa cita: abre con su doctor, dia y hora, y guarda con "editar" en lugar de crear una nueva. *@
<div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-4xl overflow-hidden flex flex-col my-auto">
        <div class="p-6 bg-turquesa-50 border-b border-turquesa-100 flex justify-between items-center shrink-0">
            <h3 class="text-xl font-bold text-turquesa-900 m-0"><i class="fa-solid fa-calendar-check mr-2"></i> @(CitaEditar != null ? "Editar cita" : "Dar cita"): @Derivacion.Paciente?.NombreCompleto <span class="text-sm font-semibold text-gray-600">(@Derivacion.EspecialidadRequerida)</span></h3>
            <button type="button" @onclick="Cerrar" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-times text-xl"></i></button>
        </div>

        <div class="p-6 overflow-y-auto flex flex-col gap-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Sucursal</label>
                    <select @bind="sucursalseleccionada" @bind:after="() => { idDoctorSeleccionado = 0; AlCambiarDoctor(); }" class="w-full px-3 py-2 border border-gray-300 rounded-lg outline-none bg-white">
                        <option value="Centro">Centro</option>
                        <option value="Milan">Milan</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Doctor</label>
                    <select @bind="idDoctorSeleccionado" @bind:after="AlCambiarDoctor" class="w-full px-3 py-2 border border-gray-300 rounded-lg outline-none bg-white">
                        <option value="0">Seleccione un doctor...</option>
                        @foreach (var doc in doctores.Where(d => CoincideDoctor(d, Derivacion.EspecialidadRequerida) && d.Sucursal == sucursalseleccionada))
                        {
                            <option value="@doc.Id">@doc.Nombre - @doc.Consultorio (@doc.Sucursal)</option>
                        }
                    </select>
                </div>
            </div>

            @if (idDoctorSeleccionado > 0)
            {
                <div class="flex justify-between items-center bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                    <button type="button" @onclick="MesAnterior" class="p-2 rounded-lg text-turquesa-600 hover:bg-turquesa-50 font-bold transition-colors"><i class="fa-solid fa-chevron-left mr-2"></i> Anterior</button>
                    <h4 class="text-xl font-bold text-gray-800 m-0 capitalize">@mesActual.ToString("MMMM yyyy")</h4>
                    <button type="button" @onclick="MesSiguiente" class="p-2 rounded-lg text-turquesa-600 hover:bg-turquesa-50 font-bold transition-colors">Siguiente <i class="fa-solid fa-chevron-right ml-2"></i></button>
                </div>

                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
                    <div class="flex flex-wrap gap-3">
                        @foreach (var dia in calendario)
                        {
                            var dt = DateTime.Parse(dia.Fecha);
                            var isSelected = diaSeleccionado?.Fecha == dia.Fecha;
                            var isPast = dt.Date < DateTime.Today;
                            var opacity = isPast ? "opacity-50 cursor-not-allowed" : "cursor-pointer hover:shadow-md";
                            var ring = isSelected ? "ring-2 ring-turquesa-500 shadow-md" : "border border-gray-200";

                            <div @onclick="() => isPast ? null : SeleccionarDia(dia)" class="w-24 h-24 rounded-lg p-2 relative flex flex-col transition-all @opacity @ring" style="background-color: @(isSelected ? "#e6fffa" : GetColorTailwind(dia.Color));">
                                <div class="text-center">
                                    <div class="text-xs font-semibold text-gray-500 uppercase">@dt.ToString("ddd", new System.Globalization.CultureInfo("es-ES"))</div>
                                    <div class="text-xl font-bold text-gray-800">@dt.ToString("dd/MM")</div>
                                </div>
                                @if (dia.TotalSlots > 0 && !isPast)
                                {
                                    <div class="mt-auto text-[10px] font-medium text-gray-600 text-center leading-tight bg-white/80 rounded px-1">
                                        Disp: @(dia.TotalSlots - dia.Citas)
                                    </div>
                                }
                            </div>
                        }
                        @if (calendario.Count == 0)
                        {
                            <div class="w-full text-center p-8 text-gray-400 font-medium">No hay dias de atencion disponibles.</div>
                        }
                    </div>
                </div>

                @if (diaSeleccionado != null && slotsDisponibles != null)
                {
                    <div class="bg-gray-50 p-5 rounded-xl border border-gray-200">
                        <h4 class="text-lg font-bold text-gray-800 mb-4"><i class="fa-regular fa-clock text-turquesa-500"></i> Horarios para el @DateTime.Parse(diaSeleccionado.Fecha).ToString("dd/MM/yyyy")</h4>
                        <div class="flex flex-wrap gap-2">
                            @if (slotsDisponibles.Count == 0) { <div class="w-full p-3 bg-red-50 text-red-600 rounded-lg text-sm">No hay turnos disponibles. Puedes agregar un turno extra.</div> }
                            @if (!mostrarTurnoExtra)
                            {
                                <div class="w-full">
                                    <button type="button" @onclick="() => mostrarTurnoExtra = true" class="px-3 py-1 bg-turquesa-600 text-white rounded-lg font-bold text-xs shadow hover:bg-turquesa-700">+ Agregar turno extra</button>
                                </div>
                            }
                            else
                            {
                                <div class="w-full p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                                    <h5 class="font-bold text-yellow-800 mb-2">Turno Extra</h5>
                                    <div class="flex flex-wrap items-center gap-4">
                                        <label class="text-sm font-semibold text-gray-700">Hora:</label>
                                        <input type="time" @bind="horaTurnoExtra" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-turquesa-500 outline-none" />
                                        <button type="button" @onclick="ConfirmarSeleccionExtra" class="px-4 py-2 bg-yellow-500 text-white font-bold rounded-lg hover:bg-yellow-600 shadow">Seleccionar</button>
                                        <button type="button" @onclick="CancelarTurnoExtra" class="px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-200 rounded-lg">Cancelar</button>
                                    </div>
                                    @if (esTurnoExtra && !string.IsNullOrEmpty(slotSeleccionado))
                                    {
                                        <p class="mt-2 text-sm font-semibold text-yellow-800">Turno extra seleccionado: @slotSeleccionado</p>
                                    }
                                </div>
                            }
                            @foreach (var slot in slotsDisponibles)
                            {
                                <button type="button" @onclick="() => { slotSeleccionado = slot; esTurnoExtra = false; }" class="px-5 py-2.5 rounded-xl text-sm font-bold transition-all border @(slotSeleccionado == slot && !esTurnoExtra ? "bg-turquesa-500 text-white border-turquesa-600 shadow-md transform scale-105" : "bg-white text-gray-700 hover:border-turquesa-400 hover:bg-turquesa-50")">@slot</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="p-6 bg-gray-50 border-t border-gray-200 flex justify-end gap-3 shrink-0">
            <button type="button" @onclick="Cerrar" class="px-5 py-2.5 rounded-xl font-medium text-gray-600 hover:bg-gray-200">Cancelar</button>
            <button type="button" @onclick="Confirmar" disabled="@(string.IsNullOrEmpty(slotSeleccionado) || guardando)" class="px-5 py-2.5 rounded-xl font-medium text-white shadow-md @(!string.IsNullOrEmpty(slotSeleccionado) && !guardando ? "bg-turquesa-600 hover:bg-turquesa-700" : "bg-gray-400 cursor-not-allowed")">
                <i class="fa-solid fa-check mr-2"></i> @(CitaEditar != null ? "Guardar cambios" : "Confirmar Cita")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Derivacion Derivacion { get; set; } = new();
    [Parameter] public string SucursalInicial { get; set; } = "Centro";
    /// <summary>Si viene (> 0), la cita se crea con la activacion del paciente que no confirmo (cita manual, sale del bot).</summary>
    [Parameter] public int IdBot { get; set; }
    /// <summary>Si viene, se edita esa cita (doctor, dia y hora) en lugar de crear una nueva.</summary>
    [Parameter] public DerivacionesService.CitaDerivacionResponse? CitaEditar { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
    [Parameter] public EventCallback OnAgendada { get; set; }

    private List<Doctor> doctores = new();
    private string sucursalseleccionada = "Centro";
    private int idDoctorSeleccionado = 0;
    private DateTime mesActual = DateTime.Today;
    private List<DerivacionesService.CapacidadDia> calendario = new();
    private DerivacionesService.CapacidadDia? diaSeleccionado;
    private List<string>? slotsDisponibles;
    private string? slotSeleccionado;
    private bool guardando;

    // Turno extra: una hora fuera de los turnos libres (hoy o un dia posterior)
    private bool mostrarTurnoExtra = false;
    private TimeOnly horaTurnoExtra = new TimeOnly(12, 0);
    private bool esTurnoExtra = false;

    protected override async Task OnInitializedAsync()
    {
        sucursalseleccionada = string.IsNullOrWhiteSpace(SucursalInicial) ? "Centro" : SucursalInicial;
        doctores = await Service.GetDoctoresAsync("");

        if (CitaEditar != null)
        {
            await PrepararEdicion(CitaEditar);
            return;
        }

        // Si en la sede solo hay un doctor para esa especialidad, se deja elegido
        var validos = doctores.Where(d => CoincideDoctor(d, Derivacion.EspecialidadRequerida) && d.Sucursal == sucursalseleccionada).ToList();
        if (validos.Count == 1)
        {
            idDoctorSeleccionado = validos[0].Id;
            await AlCambiarDoctor();
        }
    }

    // Abre la ventana con el doctor, el dia y la hora actuales de la cita
    private async Task PrepararEdicion(DerivacionesService.CitaDerivacionResponse cita)
    {
        idDoctorSeleccionado = cita.Doctor?.Id ?? 0;
        if (!string.IsNullOrWhiteSpace(cita.Doctor?.Sucursal)) sucursalseleccionada = cita.Doctor!.Sucursal;
        mesActual = cita.FechaHora.Date;
        if (idDoctorSeleccionado <= 0) return;

        await CargarCalendario();
        diaSeleccionado = calendario.FirstOrDefault(d => d.Fecha == cita.FechaHora.ToString("yyyy-MM-dd"));
        if (diaSeleccionado != null)
        {
            await SeleccionarDia(diaSeleccionado);
            slotSeleccionado = cita.FechaHora.ToString("HH:mm");
            esTurnoExtra = cita.EsTurnoExtra;
            mostrarTurnoExtra = cita.EsTurnoExtra;
        }
    }

    private async Task Cerrar() => await OnCerrar.InvokeAsync();

    private void ConfirmarSeleccionExtra()
    {
        slotSeleccionado = horaTurnoExtra.ToString("HH:mm");
        esTurnoExtra = true;
    }

    private void CancelarTurnoExtra()
    {
        mostrarTurnoExtra = false;
        if (esTurnoExtra) { esTurnoExtra = false; slotSeleccionado = null; }
    }

    private async Task AlCambiarDoctor()
    {
        diaSeleccionado = null;
        slotsDisponibles = null;
        slotSeleccionado = null;
        mostrarTurnoExtra = false;
        esTurnoExtra = false;
        if (idDoctorSeleccionado > 0)
        {
            mesActual = DateTime.Today;
            await CargarCalendario();
            diaSeleccionado = calendario.FirstOrDefault(d => d.Fecha == DateTime.Today.ToString("yyyy-MM-dd"));
            if (diaSeleccionado != null) await SeleccionarDia(diaSeleccionado);
        }
    }

    private async Task CargarCalendario()
    {
        calendario = await Service.GetCalendarioDoctorAsync(idDoctorSeleccionado, mesActual.Year, mesActual.Month);
    }

    private async Task MesAnterior() { mesActual = mesActual.AddMonths(-1); await CargarCalendario(); }
    private async Task MesSiguiente() { if (mesActual < new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(3)) { mesActual = mesActual.AddMonths(1); await CargarCalendario(); } }

    private async Task SeleccionarDia(DerivacionesService.CapacidadDia dia)
    {
        diaSeleccionado = dia;
        slotSeleccionado = null;
        mostrarTurnoExtra = false;
        esTurnoExtra = false;
        slotsDisponibles = await Service.GetAvailableSlotsAsync(idDoctorSeleccionado, DateTime.Parse(dia.Fecha), EsEcoDerivacion(Derivacion.EspecialidadRequerida));
    }

    private async Task Confirmar()
    {
        if (diaSeleccionado == null || string.IsNullOrEmpty(slotSeleccionado) || idDoctorSeleccionado <= 0) return;
        guardando = true;
        try
        {
            var fechaHora = DateTime.Parse(diaSeleccionado.Fecha + " " + slotSeleccionado);
            var conflicto = await Service.VerificarConflictoHorarioAsync(idDoctorSeleccionado, fechaHora, CitaEditar?.Id, CitaEditar != null && CitaEditar.EsSubsecuente ? null : Derivacion.Id, Derivacion.Paciente?.Cedula);
            if (conflicto.HayConflicto)
            {
                bool continuar = await JS.InvokeAsync<bool>("confirm", conflicto.Mensaje);
                if (!continuar) return;
            }
            (bool Exito, string Mensaje) res;
            if (CitaEditar != null)
            {
                var cambios = new DerivacionesService.CitaDerivacion
                {
                    IdDerivacion = Derivacion.Id,
                    IdDoctor = idDoctorSeleccionado,
                    FechaHora = fechaHora,
                    Estado = "Pendiente",
                    EsSubsecuente = CitaEditar.EsSubsecuente,
                    EsTurnoExtra = esTurnoExtra
                };
                res = await Service.EditarCitaAsync(CitaEditar.Id, cambios);
            }
            else if (IdBot > 0)
            {
                res = await Service.ActivarNoConfirmoAsync(IdBot, idDoctorSeleccionado, fechaHora, esTurnoExtra);
            }
            else
            {
                var cita = new DerivacionesService.CitaDerivacion
                {
                    IdDerivacion = Derivacion.Id,
                    IdDoctor = idDoctorSeleccionado,
                    FechaHora = fechaHora,
                    Estado = "Pendiente",
                    EsSubsecuente = false,
                    EsTurnoExtra = esTurnoExtra
                };
                res = await Service.AgendarCitaAsync(cita);
            }
            if (res.Exito)
            {
                await JS.InvokeVoidAsync("alert", CitaEditar != null ? "Cita actualizada correctamente." : esTurnoExtra ? "Cita agendada como turno extra." : "Cita agendada.");
                await OnAgendada.InvokeAsync();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Error: " + res.Mensaje);
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private string GetColorTailwind(string color)
    {
        if (color == "red") return "#fecaca";
        if (color == "yellow") return "#fef08a";
        if (color == "green") return "#dcfce7";
        return "#ffffff";
    }

    // Ecocardiograma: solo lo atiende el doctor marcado por el API (Dr. Toro de Centro); el resto, como siempre
    private static bool EsEcoDerivacion(string? especialidad) => (especialidad ?? "").IndexOf("ECOCARDIO", StringComparison.OrdinalIgnoreCase) >= 0;
    private bool CoincideDoctor(Doctor doc, string? reqEspecialidad) =>
        EsEcoDerivacion(reqEspecialidad) ? doc.AtiendeEco : CoincideEspecialidad(doc.Especialidad, reqEspecialidad);

    private bool CoincideEspecialidad(string? docEspecialidad, string? reqEspecialidad)
    {
        if (string.IsNullOrEmpty(docEspecialidad) || string.IsNullOrEmpty(reqEspecialidad)) return false;
        var doc = docEspecialidad.ToUpper(); var req = reqEspecialidad.ToUpper();
        if (doc.Contains("CARDIO") && req.Contains("CARDIO") && !req.Contains("ELECTRO") && !doc.Contains("ELECTRO")) return true;
        if (doc.Contains("ELECTRO") && req.Contains("ELECTRO")) return true;
        if (doc.Contains("GINECO") && req.Contains("GINECO")) return true;
        if (doc.Contains("PEDIATRIA") && req.Contains("PEDIATRIA")) return true;
        if (doc.Contains("NEURO") && req.Contains("NEURO")) return true;
        if (doc.Contains("GASTRO") && req.Contains("GASTRO")) return true;
        if (doc.Contains("MEDICINA INTERNA") && req.Contains("MEDICINA INTERNA")) return true;
        if (doc.Contains("TRAUMATOLOGIA") && req.Contains("TRAUMATOLOGIA")) return true;
        if (doc.Contains("ENDOCRINO") && req.Contains("ENDOCRINO")) return true;
        if (doc.Contains("NEFRO") && req.Contains("NEFRO")) return true;
        if (doc.Contains("UROLOGIA") && req.Contains("UROLOGIA")) return true;
        if (doc.Contains("NEUMO") && req.Contains("NEUMO")) return true;
        if (doc.Contains("OTORRINO") && req.Contains("OTORRINO")) return true;
        if (doc.Contains("OFTALMO") && req.Contains("OFTALMO")) return true;
        if (doc.Contains("DERMATO") && req.Contains("DERMATO")) return true;
        if (doc.Contains("ONCO") && req.Contains("ONCO")) return true;
        return doc == req;
    }
}
