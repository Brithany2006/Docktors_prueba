@page "/caja/crear-paciente"
@attribute [Authorize(Roles = "Caja")]
@inject CajaService CajaService
@inject NavigationManager Nav
<PageTitle>Crear paciente | Centro Médico Klinic</PageTitle>

<h3>Crear Paciente Particular</h3>

<div class="admin-card">
    <EditForm Model="model" OnValidSubmit="Crear">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Nombre completo</label>
            <InputText class="input-text" @bind-Value="model.NombreCompleto" />
        </div>

        <div class="form-group">
            <label>Cedula</label>
            <InputText class="input-text" @bind-Value="model.Cedula" />
        </div>

        <button class="btn btn-primary" type="submit">
            Crear paciente
        </button>
    </EditForm>

    @if (resultado != null)
    {
        <hr />
        <h4>✅ Paciente creado</h4>
        <p><b>Usuario:</b> @resultado.Usuario</p>
        <p><b>Contrasena:</b> @resultado.Password</p>
        <p class="hint">Entregar estas credenciales al paciente</p>
    }
</div>

@code {
    private CrearPacienteRequest model = new();
    private CrearPacienteResponse? resultado;

    private async Task Crear()
    {
        resultado = await CajaService.CrearPaciente(model);
    }
}
